#!/bin/bash
# 暂存了 xedc-recovery 时刷新 VERSION。不改 git config。
set -euo pipefail
root=$(git rev-parse --show-toplevel)
if git diff --cached --name-only --diff-filter=ACMR | grep -q '^xedc-recovery/'; then
  printf 'version=%s\nbuilt=%s\n' "$(date -u +%Y%m%dT%H%M%SZ)" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$root/xedc-recovery/VERSION"
  git add -- "$root/xedc-recovery/VERSION"
fi
