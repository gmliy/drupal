#!/usr/bin/env bash
set -euo pipefail
root="/var/www/drupal"
cmd=""
maint_val="1"
args=("$@")
i=0
while [[ $i -lt ${#args[@]} ]]; do
  a=${args[$i]}
  case "$a" in
    -r|--root)
      i=$((i + 1))
      root=${args[$i]:-$root}
      ;;
    --root=*)
      root=${a#--root=}
      ;;
    status|updb|updatedb|cr|cache:rebuild|cron|queue:list|cex|config:export|cim|config:import)
      cmd=$a
      ;;
    pm:uninstall|pmu)
      cmd=pmu
      i=$((i + 1))
      pmu_mod=${args[$i]:-}
      ;;
    pm:list|pml)
      cmd=pml
      ;;
    config:delete)
      cmd=cdel
      i=$((i + 1))
      del_name=${args[$i]:-}
      ;;
    maint:set)
      cmd=maint
      i=$((i + 1))
      maint_val=${args[$i]:-1}
      ;;
    -y|--yes|--quiet|-q|-v|--uri)
      ;;
    --uri=*)
      ;;
    *)
      ;;
  esac
  i=$((i + 1))
done
mkdir -p "$root/web/sites/default" "$root/config/sync"
case "$cmd" in
  status)
    echo "Drupal version : 11-fixture"
    echo "Database : Connected"
    echo "Bootstrap : Successful"
    ;;
  cex|config:export)
    printf 'host: test1.local\n' >"$root/config/sync/fixture.site.yml"
    echo "exported"
    ;;
  maint)
    printf '%s\n' "$maint_val" >"$root/web/sites/default/maintenance.flag"
    echo "maintenance $maint_val"
    ;;
  queue:list)
    echo "xedc_video_transcode"
    ;;
  pmu)
    if [[ -d "$root/web/modules/custom" ]] && grep -Rqs --include='*.info.yml' -E "(^|[^A-Za-z0-9_])${pmu_mod:-matomo}([^A-Za-z0-9_]|$)" "$root/web/modules/custom"; then
      echo "blocked by custom module" >&2
      exit 1
    fi
    ext="$root/config/sync/core.extension.yml"
    if [[ -f "$ext" && -n "${pmu_mod:-}" ]]; then
      grep -v -E "^[[:space:]]+${pmu_mod}:" "$ext" >"${ext}.tmp" || true
      mv "${ext}.tmp" "$ext"
    fi
    echo "uninstalled ${pmu_mod:-}"
    ;;
  pml)
    ext="$root/config/sync/core.extension.yml"
    if [[ -f "$ext" ]]; then
      awk '/^module:/{m=1; next} /^[^ ]/{m=0} m && /^[[:space:]]+[A-Za-z0-9_]+:/{name=$1; gsub(/:/,"",name); printf "%s  Enabled\n", name}' "$ext"
    fi
    ;;
  cdel)
    shopt -s nullglob
    for f in "$root/config/sync/${del_name:-none}"*; do
      rm -f "$f"
    done
    shopt -u nullglob
    echo "deleted ${del_name:-}"
    ;;
  *)
    echo "ok ${cmd:-drush}"
    ;;
esac
exit 0
