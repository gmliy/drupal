{
  "backup_root": "/var/lib/xedc-recover/backups",
  "package_dir": "",
  "key_file": "/var/lib/xedc-recover/keys/primary.key",
  "source_root": "/var/www/drupal",
  "public_files": "web/sites/default/files",
  "private_files": "/var/www/drupal/private",
  "exclude": [".git", "_server", "node_modules"],
  "database": {
    "mode": "mysqldump",
    "name": "drupal",
    "host": "127.0.0.1",
    "port": 3306,
    "user": "",
    "password_env": "XEDC_DB_PASSWORD",
    "socket": "/run/mysqld/mysqld.sock",
    "fixture_sql": ""
  },
  "remote": {
    "enabled": false,
    "endpoint": "https://ACCOUNT.r2.cloudflarestorage.com",
    "bucket": "YOUR_BUCKET",
    "region": "auto",
    "prefix": "xedc-recover/",
    "access_key_env": "XEDC_S3_ACCESS_KEY",
    "secret_key_env": "XEDC_S3_SECRET_KEY",
    "path_style": true,
    "timeout": 60,
    "retries": 5
  },
  "retention": {"keep": 7, "days": 0, "daily": 7, "weekly": 4},
  "nice": 19,
  "strategy": "pinned"
}
