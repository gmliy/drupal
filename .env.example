# Copy to the server environment or a root .env file that is not committed.
# Leave XEDC_STORAGE_RUNTIME at 0 until a migration has been verified.
# Values below are placeholders. Do not put real keys in Git.
# A saved admin credential for the selected profile is used before these variables.
# Global keys are used only when that profile explicitly selects the global names.
# Bucket, region, endpoint and path style can also come from the active profile's
# private runtime.json. These variables override that file when they are set.
# Neither source turns on public or private takeover by itself.

XEDC_STORAGE_RUNTIME=0
STORAGE_PROVIDER=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_PUBLIC_BASE_URL=
STORAGE_PATH_STYLE=0
STORAGE_PUBLIC_ENABLED=0
STORAGE_PRIVATE_ENABLED=0
STORAGE_PUBLIC_TAKEOVER=0
STORAGE_PRIVATE_TAKEOVER=0
STORAGE_I_UNDERSTAND_TAKEOVER=0
STORAGE_CDN_ENABLED=0
STORAGE_CDN_BASE_URL=
STORAGE_PUBLIC_FOLDER=s3fs-public
STORAGE_PRIVATE_FOLDER=s3fs-private
STORAGE_ROOT_FOLDER=
STORAGE_CACHE_CONTROL=
STORAGE_DISABLE_VERSION_SYNC=1
STORAGE_UPLOAD_AS_PRIVATE=1
STORAGE_ALLOW_LOOPBACK=0
STORAGE_ALLOW_PRIVATE_ENDPOINT=0

# Optional per-profile names used by connection tests.
# STORAGE_PROFILE_CLOUDFLARE_R2_ACCESS_KEY=
# STORAGE_PROFILE_CLOUDFLARE_R2_SECRET_KEY=
# STORAGE_PROFILE_CLOUDFLARE_R2_BUCKET=
