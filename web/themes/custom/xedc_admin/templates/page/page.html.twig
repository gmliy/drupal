{#
/**
 * @file
 * Administration shell. Navigation is a drawer, not a permanent sidebar.
 */
#}
<div class="xedc-admin" data-xedc-admin>
  <div class="xedc-admin-overlay" data-xedc-admin-overlay hidden></div>

  <div class="xedc-admin-drawer" id="xedc-admin-sidebar" data-xedc-admin-sidebar aria-hidden="true">
    <div class="xedc-admin-drawer__track" data-xedc-nav-track>
      <section class="xedc-admin-drawer__pane" data-xedc-nav-pane="root" data-xedc-nav-scroll>
        <div class="xedc-admin-drawer__head">
          <a class="xedc-admin-brand__link" href="{{ xedc_admin_brand_url }}">
            <span class="xedc-admin-brand__text">{{ xedc_admin_site_name }}</span>
          </a>
          <button type="button" class="xedc-admin-icon-button" data-xedc-admin-close aria-label="{{ '关闭导航'|t }}">
            <svg class="xedc-admin-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18"/></svg>
          </button>
        </div>
        <nav class="xedc-admin-nav" aria-label="{{ '后台导航'|t }}">
          <ul class="xedc-admin-nav__list" data-xedc-nav-list>
            {% for item in xedc_admin_nav|default([]) %}
              <li>
                {% if item.children %}
                  <button type="button" class="xedc-admin-nav__link{{ item.active ? ' is-active' : '' }}" data-xedc-nav-parent="{{ item.id }}" aria-expanded="false" aria-controls="xedc-nav-{{ item.id }}">
                    {{ item.icon }}
                    <span class="xedc-admin-nav__label">{{ item.title }}</span>
                    <svg class="xedc-admin-nav__chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 6l6 6-6 6"/></svg>
                  </button>
                {% else %}
                  <a class="xedc-admin-nav__link{{ item.active ? ' is-active' : '' }}" href="{{ item.url }}"{% if item.active %} aria-current="page"{% endif %}>
                    {{ item.icon }}
                    <span class="xedc-admin-nav__label">{{ item.title }}</span>
                  </a>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </nav>
        {% if page.navbar_branding or page.navbar_left or page.navbar_right %}
          <div class="xedc-admin-drawer__extra">
            {{ page.navbar_branding }}
            {{ page.navbar_left }}
            {{ page.navbar_right }}
          </div>
        {% endif %}
      </section>

      {% for item in xedc_admin_nav|default([]) %}
        {% if item.children %}
          <section class="xedc-admin-drawer__pane" id="xedc-nav-{{ item.id }}" data-xedc-nav-pane="{{ item.id }}" data-xedc-nav-scroll hidden>
            <div class="xedc-admin-drawer__head">
              <button type="button" class="xedc-admin-nav__back" data-xedc-nav-back>
                <svg class="xedc-admin-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 6 9 12l6 6"/></svg>
                <span>{{ '返回'|t }}</span>
              </button>
              <button type="button" class="xedc-admin-icon-button" data-xedc-admin-close aria-label="{{ '关闭导航'|t }}">
                <svg class="xedc-admin-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18"/></svg>
              </button>
            </div>
            <div class="xedc-admin-flyout__title">{{ item.title }}</div>
            <ul class="xedc-admin-nav__list" data-xedc-nav-list>
              {% for child in item.children %}
                {% if child.children %}
                  <li class="xedc-admin-nav__acc{{ child.open ? ' is-open' : '' }}{{ child.active ? ' is-active' : '' }}">
                    <button type="button" class="xedc-admin-nav__link xedc-admin-nav__group{{ child.active ? ' is-active' : '' }}" data-xedc-nav-group aria-expanded="{{ child.open ? 'true' : 'false' }}">
                      <span class="xedc-admin-nav__label">{{ child.title }}</span>
                      <svg class="xedc-admin-nav__chevron xedc-admin-nav__chevron--down" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6"/></svg>
                    </button>
                    <div class="xedc-admin-nav__sub"{% if not child.open %} inert{% endif %}>
                      <div class="xedc-admin-nav__sub-inner">
                        <ul class="xedc-admin-nav__list">
                          {% for grand in child.children %}
                            <li>
                              <a class="xedc-admin-nav__link xedc-admin-nav__sublink{{ grand.active ? ' is-active' : '' }}" href="{{ grand.url }}"{% if grand.active %} aria-current="page"{% endif %}>
                                <span class="xedc-admin-nav__label">{{ grand.title }}</span>
                              </a>
                            </li>
                          {% endfor %}
                        </ul>
                      </div>
                    </div>
                  </li>
                {% else %}
                  <li class="{{ child.manage ? 'xedc-admin-nav__manage' : '' }}">
                    <a class="xedc-admin-nav__link{{ child.active ? ' is-active' : '' }}" href="{{ child.url }}"{% if child.active %} aria-current="page"{% endif %}>
                      <span class="xedc-admin-nav__label">{{ child.title }}</span>
                    </a>
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          </section>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <div class="xedc-admin-shell" data-xedc-admin-shell>
    <a class="xedc-admin-skip" href="#main-content">{{ '跳到主要内容'|t }}</a>
    <header class="xedc-admin-header">
      <button type="button" class="xedc-admin-icon-button xedc-admin-drawer-button" data-xedc-admin-drawer aria-expanded="false" aria-controls="xedc-admin-sidebar" aria-label="{{ '打开导航'|t }}">
        <svg class="xedc-admin-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
      <a class="xedc-admin-header__logo" href="{{ xedc_admin_brand_url }}">{{ xedc_admin_site_name }}</a>
      <div class="xedc-admin-header__crumb">
        {{ page.breadcrumb }}
      </div>
      <a class="xedc-admin-header__quiet" href="{{ xedc_admin_front_url }}">
        <svg class="xedc-admin-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 5h5v5"/><path d="M19 5 10 14"/><path d="M17 13.5V18a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1h4.5"/></svg>
        <span class="xedc-admin-header__quiet-text">{{ '查看网站'|t }}</span>
      </a>
      <button type="button" class="xedc-admin-icon-button xedc-admin-theme" data-xedc-admin-theme aria-pressed="false" aria-label="{{ '切换到深色'|t }}">
        <svg data-icon="sun" class="xedc-admin-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="3.5"/><path d="M12 3.5v1.8M12 18.7v1.8M3.5 12h1.8M18.7 12h1.8M6 6l1.3 1.3M16.7 16.7 18 18M18 6l-1.3 1.3M7.3 16.7 6 18"/></svg>
        <svg data-icon="moon" class="xedc-admin-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M16.5 14.5A6.5 6.5 0 0 1 9.5 4.2 6.5 6.5 0 1 0 16.5 14.5z"/></svg>
      </button>
      <div class="xedc-admin-dropdown" data-xedc-admin-dropdown>
        <button type="button" class="xedc-admin-user" data-xedc-admin-dropdown-button aria-expanded="false" aria-haspopup="menu" aria-label="{{ '账户菜单'|t }}">
          <span class="xedc-admin-user__avatar" aria-hidden="true">{{ xedc_admin_user_initial }}</span>
          <span class="xedc-admin-user__name">{{ xedc_admin_user_name }}</span>
        </button>
        <div class="xedc-admin-menu" data-xedc-admin-dropdown-menu role="menu" hidden>
          <div class="xedc-admin-menu__name">{{ xedc_admin_user_name }}</div>
          <a role="menuitem" href="{{ xedc_admin_user_url }}">{{ '我的账户'|t }}</a>
          <a role="menuitem" href="{{ xedc_admin_logout_url }}">{{ '退出登录'|t }}</a>
        </div>
      </div>
    </header>

    <main id="main-content" class="xedc-admin-content" tabindex="-1">
      <div class="xedc-admin-pagehead">
        {{ page.header }}
      </div>
      {{ page.content }}
      {% if page.footer %}
        <div class="xedc-admin-footer">{{ page.footer }}</div>
      {% endif %}
    </main>
  </div>
</div>
{{ page.page_bottom }}
