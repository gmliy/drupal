<?php

/**
 * @file
 * Layout and navigation for the XEDC administration theme.
 */

declare(strict_types=1);

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\Core\Render\Markup;
use Drupal\Core\Url;

$xedc_admin_includes = glob(__DIR__ . '/includes/*.theme') ?: [];
foreach ($xedc_admin_includes as $xedc_admin_include) {
  require_once $xedc_admin_include;
}

/**
 * Implements hook_library_info_alter().
 *
 * The core Navigation toolbar is not shown in this theme (layout.css hides
 * it), and the visible UI uses the system font stack. Navigation still
 * preloads Inter (~345KB) at high priority beside the render-blocking CSS.
 * Keep the font file registered so the toolbar face can load if it is ever
 * shown; only stop the preload.
 */
function xedc_admin_library_info_alter(array &$libraries, string $extension): void {
  if ($extension !== 'navigation' || !isset($libraries['internal.navigation']['fonts'])) {
    return;
  }
  foreach ($libraries['internal.navigation']['fonts'] as &$font) {
    if (is_array($font)) {
      $font['preload'] = FALSE;
    }
  }
}

/**
 * Implements hook_preprocess_html().
 */
function xedc_admin_preprocess_html(array &$variables): void {
  $variables['html_attributes']['class'][] = 'xedc-admin-active';
  $variables['attributes']['class'][] = 'xedc-admin-active';
}

/**
 * Implements hook_preprocess_page().
 */
function xedc_admin_preprocess_page(array &$variables): void {
  $variables['#cache']['contexts'][] = 'user';
  $variables['#cache']['contexts'][] = 'user.permissions';
  $variables['#cache']['contexts'][] = 'session';
  $variables['#cache']['contexts'][] = 'route';
  $variables['#cache']['contexts'][] = 'url.query_args:type';
  $variables['#cache']['contexts'][] = 'languages:language_interface';
  $variables['#cache']['tags'][] = 'config:system.site';

  $account = \Drupal::currentUser();
  $name = $account->getDisplayName() ?: 'User';
  $variables['xedc_admin_nav'] = _xedc_admin_navigation();
  $shortcut_cache = _xedc_admin_shortcut_cache();
  $nav_cache = _xedc_admin_navigation_cache();
  $variables['#cache']['tags'] = \Drupal\Core\Cache\Cache::mergeTags($variables['#cache']['tags'] ?? [], $shortcut_cache['tags'], $nav_cache['tags']);
  $variables['#cache']['contexts'] = \Drupal\Core\Cache\Cache::mergeContexts($variables['#cache']['contexts'] ?? [], $shortcut_cache['contexts'], $nav_cache['contexts']);
  $variables['xedc_admin_user_name'] = $name;
  $variables['xedc_admin_user_initial'] = mb_substr($name, 0, 1);
  $variables['xedc_admin_user_url'] = \Drupal\Core\Url::fromRoute('entity.user.canonical', ['user' => $account->id()])->toString();
  $variables['xedc_admin_logout_url'] = \Drupal\Core\Url::fromRoute('user.logout')->toString();
  $variables['xedc_admin_front_url'] = \Drupal\Core\Url::fromRoute('<front>')->toString();
  $variables['xedc_admin_brand_url'] = _xedc_admin_brand_url();
  $variables['xedc_admin_site_name'] = (string) (\Drupal::config('system.site')->get('name') ?: 'XEDC');
}

/**
 * Implements hook_page_attachments_alter().
 *
 * Themes cannot implement hook_page_attachments(). The early class has to be
 * added here, or the phone drawer CSS never turns on.
 */
function xedc_admin_page_attachments_alter(array &$attachments): void {
  $attachments['#cache']['contexts'][] = 'route';
  $attachments['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag' => 'script',
      '#value' => Markup::create("(function(){var r=document.documentElement;r.classList.add('xedc-admin-js');try{if(localStorage.getItem('xedcAdmin.theme')==='dark'){r.setAttribute('data-theme','dark');}}catch(e){}})();"),
      '#attributes' => ['id' => 'xedc-admin-sidebar-state'],
    ],
    'xedc_admin_sidebar_state',
  ];
  if (\Drupal::routeMatch()->getRouteName() === 'xedc_admin_ui.dashboard') {
    $attachments['#attached']['library'][] = 'xedc_admin/dashboard';
  }
}

/**
 * Implements hook_preprocess_breadcrumb().
 */
function xedc_admin_preprocess_breadcrumb(array &$variables): void {
  $variables['#cache']['contexts'][] = 'route';
}

/**
 * Implements hook_preprocess_HOOK() for admin_block_content.
 */
function xedc_admin_preprocess_admin_block_content(array &$variables): void {
  if (empty($variables['content']) || !is_array($variables['content'])) {
    return;
  }
  foreach ($variables['content'] as $key => $item) {
    if (!is_array($item) || !isset($item['url']) || !is_object($item['url']) || !method_exists($item['url'], 'toString')) {
      continue;
    }
    $href = $item['url']->toString();
    $variables['content'][$key]['href'] = $href;
    // The Site Audit Report Entity "Example" settings form is a scaffold page.
    // Nothing reads site_audit_report_entity.settings:example. Hide that one
    // link from the config index. The route, the form, and saved audit
    // reports stay in place and the URL still opens if typed in.
    $route_name = method_exists($item['url'], 'getRouteName') ? (string) $item['url']->getRouteName() : '';
    if ($route_name === 'site_audit_report_entity.settings_form' || str_contains($href, '/admin/config/system/site-audit-report-entity')) {
      unset($variables['content'][$key]);
    }
  }
}

/**
 * Implements hook_theme().
 *
 * Node forms already ask for the node_form theme hook. Register it so the
 * template can place each child once. #parents and #group stay untouched.
 */
function xedc_admin_theme($existing, $type, $theme, $path): array {
  return [
    'node_form' => [
      'render element' => 'form',
      'path' => $path . '/templates/form',
      'template' => 'node-form',
    ],
  ];
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node forms.
 *
 * Presentation only: turn the vertical-tabs shell into a container so each
 * details can collapse on its own, and mark the panels that start closed.
 */
function xedc_admin_form_node_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $form['#attributes']['class'][] = 'xedc-node-form';

  if (($form['advanced']['#type'] ?? '') === 'vertical_tabs') {
    $form['advanced']['#type'] = 'container';
    $form['advanced']['#attributes']['class'][] = 'xedc-node-settings';
  }

  foreach (['meta', 'menu', 'author', 'options', 'revision_information', 'simple_sitemap'] as $key) {
    if (($form[$key]['#type'] ?? '') === 'details') {
      $form[$key]['#open'] = FALSE;
      $form[$key]['#attributes']['class'][] = 'xedc-fold';
    }
  }

  if (($form['path']['widget'][0]['#type'] ?? '') === 'details') {
    $form['path']['widget'][0]['#attributes']['class'][] = 'xedc-fold';
    $alias = $form['path']['widget'][0]['alias']['#default_value'] ?? '';
    if ($alias === '' || $alias === NULL) {
      $form['path']['widget'][0]['#open'] = FALSE;
    }
  }

  if (($form['field_comment']['widget'][0]['#type'] ?? '') === 'details') {
    $form['field_comment']['widget'][0]['#attributes']['class'][] = 'xedc-fold';
  }

  foreach (Element::children($form) as $key) {
    if (!is_string($key) || !str_starts_with($key, 'scheduler_settings') || ($form[$key]['#type'] ?? '') !== 'details') {
      continue;
    }
    $form[$key]['#attributes']['class'][] = 'xedc-fold';
    $form[$key]['#attributes']['class'][] = 'xedc-scheduler';
    $scheduled = $form['publish_on']['widget'][0]['value']['#default_value'] ?? NULL;
    $form[$key]['#open'] = !empty($scheduled);
  }

  if (isset($form['xedc_import']) && is_array($form['xedc_import'])) {
    $form['xedc_import']['#attributes']['class'][] = 'xedc-fold';
    if (empty($form['xedc_import']['tasks']) && empty($form['xedc_import']['live'])) {
      $form['xedc_import']['#open'] = FALSE;
    }
  }

  foreach (['status', 'field_show_cover', 'field_featured', 'field_slideshow'] as $key) {
    if (isset($form[$key]) && is_array($form[$key])) {
      $form[$key]['#attributes']['class'][] = 'xedc-switch';
    }
  }
  foreach (['promote', 'sticky'] as $key) {
    if (isset($form['options'][$key]) && is_array($form['options'][$key])) {
      $form['options'][$key]['#wrapper_attributes']['class'][] = 'xedc-switch';
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for node_form.
 */
function xedc_admin_preprocess_node_form(array &$variables): void {
  $form = $variables['form'];
  $form_id = (string) ($form['#form_id'] ?? '');
  $bundle = 'default';
  if (preg_match('/^node_(.+)_form$/', $form_id, $matches)) {
    $bundle = $matches[1];
    // Edit forms are node_{bundle}_edit_form. Add forms stay node_{bundle}_form.
    if (str_ends_with($bundle, '_edit')) {
      $bundle = substr($bundle, 0, -strlen('_edit'));
    }
  }
  $variables['xedc_bundle'] = $bundle;

  $scheduler = '';
  foreach (Element::children($form) as $key) {
    if (is_string($key) && str_starts_with($key, 'scheduler_settings')) {
      $scheduler = $key;
      break;
    }
  }
  $variables['xedc_scheduler_key'] = $scheduler;

  $main = match ($bundle) {
    'article' => ['title', 'field_cover', 'field_summary', 'field_body', 'field_categories', 'field_tags', 'field_source', 'field_source_url'],
    'video' => ['title', 'field_video_cover', 'field_video_file', 'field_video_url', 'field_duration', 'field_body', 'field_categories', 'field_tags', 'xedc_video_recommend', 'field_featured', 'field_slideshow'],
    'photo' => ['title', 'field_cover_image', 'field_images', 'xedc_import', 'field_summary', 'field_categories', 'field_model', 'field_tags', 'field_featured', 'field_slideshow'],
    default => ['title', 'field_body'],
  };
  $structural = [
    'advanced', 'footer', 'actions', 'langcode', 'path', 'field_comment',
    'meta', 'menu', 'author', 'options', 'revision_information', 'revision', 'revision_log',
    'created', 'uid', 'moderation_state', 'status', 'simple_sitemap', 'simple_sitemap_index_now',
    'publish_on', 'unpublish_on', 'changed', 'form_build_id', 'form_token', 'form_id',
  ];
  if ($scheduler !== '') {
    $structural[] = $scheduler;
  }
  $skip = array_flip(array_merge($main, $structural));
  $leftover = [];
  foreach (Element::children($form) as $key) {
    if (!isset($skip[$key])) {
      $leftover[] = $key;
    }
  }
  $variables['xedc_leftover'] = $leftover;
}

/**
 * Implements hook_preprocess_HOOK() for node_add_list.
 *
 * The core list is a dl of links. Expose the URL and label so the template
 * can render one clickable row per content type.
 */
function xedc_admin_preprocess_node_add_list(array &$variables): void {
  if (empty($variables['content']) || !is_array($variables['content'])) {
    return;
  }
  foreach ($variables['content'] as $type) {
    if (!is_object($type) || !method_exists($type, 'id')) {
      continue;
    }
    $id = $type->id();
    if (!isset($variables['types'][$id]) || !is_array($variables['types'][$id])) {
      continue;
    }
    $variables['types'][$id]['url'] = Url::fromRoute('entity.node.add_form', ['node_type' => $id])->toString();
    $variables['types'][$id]['label'] = $type->label();
    $variables['types'][$id]['summary'] = (string) $type->getDescription();
  }
}
