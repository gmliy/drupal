<?php

/**
 * @file
 * Permission-aware administration navigation.
 */

declare(strict_types=1);

use Drupal\Component\Render\MarkupInterface;
use Drupal\Core\Render\Markup;
use Drupal\Core\Url;

/**
 * Brand link: the dashboard when allowed, otherwise the Drupal admin index.
 */
function _xedc_admin_brand_url(): string {
  foreach (['xedc_admin_ui.dashboard', 'system.admin'] as $route) {
    try {
      $url = Url::fromRoute($route);
      if ($url->access(\Drupal::currentUser())) {
        return $url->toString();
      }
    }
    catch (\Throwable) {
      continue;
    }
  }
  return Url::fromRoute('<front>')->toString();
}

/**
 * Navigation groups. Missing routes and forbidden links are omitted.
 *
 * @return list<array{label: string, items: list<array{title: string, url: string, icon: \Drupal\Component\Render\MarkupInterface, active: bool}>}>
 *   Groups that contain at least one link.
 */
function _xedc_admin_navigation(): array {
  return _xedc_admin_build_groups(_xedc_admin_navigation_definitions());
}

/**
 * Bottom system links. Missing routes and forbidden links are omitted.
 *
 * @return list<array{title: string, url: string, icon: \Drupal\Component\Render\MarkupInterface, active: bool}>
 *   Visible system links.
 */
function _xedc_admin_system_navigation(): array {
  $items = [];
  foreach (_xedc_admin_system_definitions() as $item) {
    $link = _xedc_admin_link($item);
    if ($link !== NULL) {
      $items[] = $link;
    }
  }
  return $items;
}

/**
 * @param list<array<string, mixed>> $definitions
 *   Group definitions.
 *
 * @return list<array{id: string, label: string, collapsible: bool, open: bool, items: list<array{title: string, url: string, icon: \Drupal\Component\Render\MarkupInterface, active: bool}>}>
 *   Groups that contain at least one link.
 */
function _xedc_admin_build_groups(array $definitions): array {
  $groups = [];
  foreach ($definitions as $group) {
    $items = [];
    $open = empty($group['collapsible']);
    foreach ($group['items'] as $item) {
      $link = _xedc_admin_link($item);
      if ($link === NULL) {
        continue;
      }
      if ($link['active']) {
        $open = TRUE;
      }
      $items[] = $link;
    }
    if ($items === []) {
      continue;
    }
    $groups[] = [
      'id' => (string) $group['id'],
      'label' => (string) $group['label'],
      'collapsible' => !empty($group['collapsible']),
      'open' => $open,
      'items' => $items,
    ];
  }
  return $groups;
}

