<?php

/**
 * @file
 * Permission-aware administration navigation.
 *
 * One flat level. Parents open a flyout on desktop and a drill-down on phones.
 * Routes that do not exist, and links the current user cannot access, are left out.
 */

declare(strict_types=1);

use Drupal\Component\Render\MarkupInterface;
use Drupal\Core\Cache\Cache;
use Drupal\Core\Cache\CacheableDependencyInterface;
use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Menu\MenuLinkTreeElement;
use Drupal\Core\Menu\MenuTreeParameters;
use Drupal\Core\Render\Markup;
use Drupal\Core\Url;
use Drupal\shortcut\ShortcutSetInterface;

/**
 * Brand link: the dashboard when allowed, otherwise the Drupal admin index.
 */
function _xedc_admin_brand_url(): string {
  foreach (['xedc_admin_ui.dashboard', 'system.admin'] as $route) {
    try {
      $url = Url::fromRoute($route);
      if ($url->access(\Drupal::currentUser())) {
        return $url->toString();
      }
    }
    catch (\Throwable) {
      continue;
    }
  }
  return Url::fromRoute('<front>')->toString();
}

/**
 * Flat primary navigation, in display order.
 *
 * @return list<array<string, mixed>>
 *   Items. A parent has children. A leaf has a url and no children.
 */
function _xedc_admin_navigation(): array {
  $items = [];
  foreach (_xedc_admin_navigation_definitions() as $definition) {
    $item = _xedc_admin_navigation_item($definition);
    if ($item !== NULL) {
      $items[] = $item;
    }
  }
  return $items;
}

/**
 * Adds the current user's shortcut-set cache tags to the page.
 *
 * Shortcut links are per user. Saving or reassigning a set invalidates that
 * set's cache tags (see Shortcut::getCacheTagsToInvalidate()).
 */
function _xedc_admin_add_shortcut_cache(ShortcutSetInterface $set): void {
  $page = &drupal_static(__FUNCTION__ . '_page');
  if (!is_array($page)) {
    $page = [];
  }
  $page['tags'] = Cache::mergeTags($page['tags'] ?? [], $set->getCacheTags());
  $page['contexts'] = Cache::mergeContexts($page['contexts'] ?? [], ['user', 'user.permissions']);
}

/**
 * Cache metadata collected while reading shortcuts. Merged in preprocess.
 *
 * @return array{tags: list<string>, contexts: list<string>}
 *   Tags and contexts. Empty when shortcuts were not read.
 */
function _xedc_admin_shortcut_cache(): array {
  $page = &drupal_static('_xedc_admin_add_shortcut_cache_page');
  if (!is_array($page)) {
    return ['tags' => [], 'contexts' => []];
  }
  return [
    'tags' => $page['tags'] ?? [],
    'contexts' => $page['contexts'] ?? [],
  ];
}

