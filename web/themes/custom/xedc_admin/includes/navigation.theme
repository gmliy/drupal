/**
 * @param array<string, mixed> $definition
 *   One primary item.
 *
 * @return array<string, mixed>|null
 *   A visible item, or NULL when nothing in it can be shown.
 */
function _xedc_admin_navigation_item(array $definition): ?array {
  if (!empty($definition['shortcuts'])) {
    return _xedc_admin_shortcut_item($definition);
  }
  if (!empty($definition['config_tree'])) {
    return _xedc_admin_config_item($definition);
  }
  if (!empty($definition['structure_tree'])) {
    return _xedc_admin_structure_item($definition);
  }
  if (!empty($definition['children'])) {
    $children = [];
    $active = FALSE;
    foreach ($definition['children'] as $child) {
      $link = _xedc_admin_link($child);
      if ($link === NULL) {
        continue;
      }
      $active = $active || $link['active'];
      $children[] = $link;
    }
    if ($children === []) {
      return NULL;
    }
    return [
      'id' => (string) $definition['id'],
      'title' => (string) $definition['title'],
      'icon' => _xedc_admin_icon((string) $definition['icon']),
      'url' => '',
      'active' => $active,
      'children' => $children,
    ];
  }
  $link = _xedc_admin_link($definition);
  if ($link === NULL) {
    return NULL;
  }
  return [
    'id' => (string) $definition['id'],
    'title' => $link['title'],
    'icon' => $link['icon'],
    'url' => $link['url'],
    'active' => $link['active'],
    'children' => [],
  ];
}

/**
 * Shortcut primary item.
 *
 * With shortcuts, it opens a submenu and appends "管理快捷方式" when allowed.
 * With none, the item itself goes to the set's customize page. No customize
 * access and no visible shortcuts hides the item. Nothing is written.
 *
 * @param array<string, mixed> $definition
 *   The shortcut definition.
 *
 * @return array<string, mixed>|null
 *   A visible item, or NULL.
 */
function _xedc_admin_shortcut_item(array $definition): ?array {
  if (!\Drupal::moduleHandler()->moduleExists('shortcut') || !function_exists('shortcut_set_edit_access')) {
    return NULL;
  }
  try {
    $set = \Drupal::entityTypeManager()->getStorage('shortcut_set')->getDisplayedToUser(\Drupal::currentUser());
  }
  catch (\Throwable) {
    return NULL;
  }
  if (!$set instanceof ShortcutSetInterface) {
    return NULL;
  }
  _xedc_admin_add_shortcut_cache($set);

  $children = [];
  foreach ($set->getShortcuts() as $shortcut) {
    try {
      $shortcut = \Drupal::service('entity.repository')->getTranslationFromContext($shortcut);
      $url = $shortcut->getUrl();
      if (!$url->access(\Drupal::currentUser())) {
        continue;
      }
      $children[] = [
        'title' => (string) $shortcut->label(),
        'url' => $url->toString(),
        'active' => _xedc_admin_url_active($url),
      ];
    }
    catch (\Throwable) {
      continue;
    }
  }

  $manage = NULL;
  if (shortcut_set_edit_access($set)->isAllowed()) {
    try {
      $manage_url = Url::fromRoute('entity.shortcut_set.customize_form', ['shortcut_set' => $set->id()]);
      if ($manage_url->access(\Drupal::currentUser())) {
        $manage = [
          'title' => (string) t('管理快捷方式'),
          'url' => $manage_url->toString(),
          'active' => _xedc_admin_url_active($manage_url),
          'manage' => TRUE,
        ];
      }
    }
    catch (\Throwable) {
      $manage = NULL;
    }
  }

  if ($children === []) {
    if ($manage === NULL) {
      return NULL;
    }
    return [
      'id' => (string) $definition['id'],
      'title' => (string) $definition['title'],
      'icon' => _xedc_admin_icon((string) $definition['icon']),
      'url' => $manage['url'],
      'active' => $manage['active'],
      'children' => [],
    ];
  }

  if ($manage !== NULL) {
    $children[] = $manage;
  }
  $active = FALSE;
  foreach ($children as $child) {
    $active = $active || !empty($child['active']);
  }
  return [
    'id' => (string) $definition['id'],
    'title' => (string) $definition['title'],
    'icon' => _xedc_admin_icon((string) $definition['icon']),
    'url' => '',
    'active' => $active,
    'children' => $children,
  ];
}

/**
 * Remembers cache metadata from the config menu tree.
 */
function _xedc_admin_remember_cache(CacheableDependencyInterface $dependency): void {
  $meta = &drupal_static(__FUNCTION__);
  if (!$meta instanceof CacheableMetadata) {
    $meta = new CacheableMetadata();
  }
  $meta->addCacheableDependency($dependency);
}

/**
 * Cache metadata collected while reading the config menu.
 *
 * @return array{tags: list<string>, contexts: list<string>}
 *   Tags and contexts. Empty when the config tree was not read.
 */
function _xedc_admin_navigation_cache(): array {
  $meta = drupal_static('_xedc_admin_remember_cache');
  if (!$meta instanceof CacheableMetadata) {
    return ['tags' => [], 'contexts' => []];
  }
  return [
    'tags' => $meta->getCacheTags(),
    'contexts' => $meta->getCacheContexts(),
  ];
}

/**
 * Website configuration from the admin menu, not a hardcoded list.
 *
 * Groups are the children of system.admin_config. Their children are the
 * config pages. Anything deeper is left out. Access comes from the menu
 * tree's checkAccess manipulator. The scaffold settings route
 * site_audit_report_entity.settings_form stays hidden, same as the config index.
 *
 * @param array<string, mixed> $definition
 *   The primary item definition.
 *
 * @return array<string, mixed>|null
 *   A visible item, or NULL when the overview itself is forbidden.
 */
function _xedc_admin_config_item(array $definition): ?array {
  try {
    $overview = Url::fromRoute('system.admin_config');
  }
  catch (\Throwable) {
    return NULL;
  }
  if (!$overview->access(\Drupal::currentUser())) {
    return NULL;
  }

  $meta = new CacheableMetadata();
  $meta->addCacheTags(['config:system.menu.admin']);
  $meta->addCacheContexts(['user.permissions', 'route', 'languages:language_interface']);
  _xedc_admin_remember_cache($meta);

  $parameters = (new MenuTreeParameters())
    ->setRoot('system.admin_config')
    ->excludeRoot()
    ->setMaxDepth(2)
    ->onlyEnabledLinks();
  $tree = \Drupal::menuTree()->load('admin', $parameters);
  $tree = \Drupal::menuTree()->transform($tree, [
    ['callable' => 'menu.default_tree_manipulators:checkAccess'],
    ['callable' => 'menu.default_tree_manipulators:generateIndexAndSort'],
  ]);

  $current = \Drupal::service('path.current')->getPath();
  $groups = [];
  foreach ($tree as $element) {
    if (!$element instanceof MenuLinkTreeElement) {
      continue;
    }
    $children = _xedc_admin_config_pages($element);
    if ($children === []) {
      continue;
    }
    $groups[] = [
      'title' => (string) $element->link->getTitle(),
      'open' => FALSE,
      'active' => FALSE,
      'children' => $children,
    ];
  }

  $best_length = -1;
  $best_group = NULL;
  $best_child = NULL;
  foreach ($groups as $group_index => $group) {
    foreach ($group['children'] as $child_index => $child) {
      $path = (string) ($child['path'] ?? '');
      $matches = $path !== '' && ($current === $path || str_starts_with($current, $path . '/'));
      if ($matches && strlen($path) > $best_length) {
        $best_length = strlen($path);
        $best_group = $group_index;
        $best_child = $child_index;
      }
    }
  }
  if ($best_group !== NULL && $best_child !== NULL) {
    $groups[$best_group]['open'] = TRUE;
    $groups[$best_group]['active'] = TRUE;
    $groups[$best_group]['children'][$best_child]['active'] = TRUE;
  }
  foreach ($groups as &$group) {
    foreach ($group['children'] as &$child) {
      unset($child['path']);
    }
  }
  unset($group, $child);

  $children = [
    [
      'title' => (string) t('全部配置'),
      'url' => $overview->toString(),
      'active' => $current === '/admin/config',
      'all' => TRUE,
    ],
  ];
  foreach ($groups as $group) {
    $children[] = $group;
  }

  return [
    'id' => (string) $definition['id'],
    'title' => (string) $definition['title'],
    'icon' => _xedc_admin_icon((string) ($definition['icon'] ?? 'settings')),
    'url' => '',
    'active' => str_starts_with($current, '/admin/config'),
    'children' => $children,
  ];
}

/**
 * Structure menu from the admin menu, same flyout as the other parents.
 *
 * Direct children are the second level. Their children are the third level.
 * A second-level page that also has children keeps its own URL as the first
 * third-level link, because the expander itself is a button. Nothing past
 * that level is added. Routes and menu order are the menu tree's.
 *
 * @param array<string, mixed> $definition
 *   The primary item definition.
 *
 * @return array<string, mixed>|null
 *   A visible item, or NULL when the overview itself is forbidden.
 */
function _xedc_admin_structure_item(array $definition): ?array {
  try {
    $overview = Url::fromRoute('system.admin_structure');
  }
  catch (\Throwable) {
    return NULL;
  }
  if (!$overview->access(\Drupal::currentUser())) {
    return NULL;
  }

  $meta = new CacheableMetadata();
  $meta->addCacheTags(['config:system.menu.admin']);
  $meta->addCacheContexts(['user.permissions', 'route', 'languages:language_interface']);
  _xedc_admin_remember_cache($meta);

  $parameters = (new MenuTreeParameters())
    ->setRoot('system.admin_structure')
    ->excludeRoot()
    ->setMaxDepth(3)
    ->onlyEnabledLinks();
  $tree = \Drupal::menuTree()->load('admin', $parameters);
  $tree = \Drupal::menuTree()->transform($tree, [
    ['callable' => 'menu.default_tree_manipulators:checkAccess'],
    ['callable' => 'menu.default_tree_manipulators:generateIndexAndSort'],
  ]);

  $current = \Drupal::service('path.current')->getPath();
  $children = [
    [
      'title' => (string) t('概览'),
      'url' => $overview->toString(),
      'path' => '/admin/structure',
      'active' => FALSE,
    ],
  ];
  foreach ($tree as $element) {
    if (!$element instanceof MenuLinkTreeElement) {
      continue;
    }
    $link = _xedc_admin_menu_page($element);
    if ($link === NULL) {
      continue;
    }
    $grand = [];
    foreach ($element->subtree as $child) {
      if (!$child instanceof MenuLinkTreeElement) {
        continue;
      }
      $page = _xedc_admin_menu_page($child);
      if ($page !== NULL) {
        $grand[] = $page;
      }
    }
    if ($grand === []) {
      $children[] = $link;
      continue;
    }
    array_unshift($grand, $link);
    $children[] = [
      'title' => $link['title'],
      'open' => FALSE,
      'active' => FALSE,
      'children' => $grand,
    ];
  }

  $best_length = -1;
  $best_index = NULL;
  $best_child = NULL;
  foreach ($children as $index => $child) {
    if (!empty($child['children'])) {
      foreach ($child['children'] as $grand_index => $grand) {
        $path = (string) ($grand['path'] ?? '');
        $exact = $path === '/admin/structure';
        $matches = $path !== '' && ($current === $path || (!$exact && str_starts_with($current, $path . '/')));
        if ($matches && strlen($path) > $best_length) {
          $best_length = strlen($path);
          $best_index = $index;
          $best_child = $grand_index;
        }
      }
      continue;
    }
    $path = (string) ($child['path'] ?? '');
    $exact = $path === '/admin/structure';
    $matches = $path !== '' && ($current === $path || (!$exact && str_starts_with($current, $path . '/')));
    if ($matches && strlen($path) > $best_length) {
      $best_length = strlen($path);
      $best_index = $index;
      $best_child = NULL;
    }
  }
  if ($best_index !== NULL) {
    if ($best_child !== NULL) {
      $children[$best_index]['open'] = TRUE;
      $children[$best_index]['active'] = TRUE;
      $children[$best_index]['children'][$best_child]['active'] = TRUE;
    }
    else {
      $children[$best_index]['active'] = TRUE;
    }
  }
  foreach ($children as $index => $child) {
    unset($children[$index]['path']);
    if (!empty($child['children']) && is_array($child['children'])) {
      foreach ($child['children'] as $grand_index => $grand) {
        unset($children[$index]['children'][$grand_index]['path']);
      }
    }
  }

  return [
    'id' => (string) $definition['id'],
    'title' => (string) $definition['title'],
    'icon' => _xedc_admin_icon((string) ($definition['icon'] ?? 'layout')),
    'url' => '',
    'active' => str_starts_with($current, '/admin/structure'),
    'children' => $children,
  ];
}

/**
 * One visible admin-menu link for the structure flyout.
 *
 * @return array{title: string, url: string, path: string, active: bool}|null
 *   The link, or NULL when this user cannot open it.
 */
function _xedc_admin_menu_page(MenuLinkTreeElement $element): ?array {
  _xedc_admin_remember_menu_element($element);
  if (!$element->access || !$element->access->isAllowed()) {
    return NULL;
  }
  try {
    $url = $element->link->getUrlObject();
  }
  catch (\Throwable) {
    return NULL;
  }
  return [
    'title' => (string) $element->link->getTitle(),
    'url' => $url->toString(),
    'path' => _xedc_admin_link_path($url),
    'active' => FALSE,
  ];
}

/**
 * Visible config pages directly under one group. Deeper links are ignored.
 *
 * @return list<array{title: string, url: string, path: string, active: bool}>
 *   Pages the current user may open.
 */
function _xedc_admin_config_pages(MenuLinkTreeElement $element): array {
  _xedc_admin_remember_menu_element($element);
  if (!$element->access || !$element->access->isAllowed()) {
    return [];
  }
  $pages = [];
  foreach ($element->subtree as $child) {
    if (!$child instanceof MenuLinkTreeElement) {
      continue;
    }
    _xedc_admin_remember_menu_element($child);
    if (!$child->access || !$child->access->isAllowed()) {
      continue;
    }
    try {
      $url = $child->link->getUrlObject();
    }
    catch (\Throwable) {
      continue;
    }
    if (_xedc_admin_config_hidden($url)) {
      continue;
    }
    $pages[] = [
      'title' => (string) $child->link->getTitle(),
      'url' => $url->toString(),
      'path' => _xedc_admin_link_path($url),
      'active' => FALSE,
    ];
  }
  return $pages;
}

/**
 * Keeps the link and its access result on the page cache.
 */
function _xedc_admin_remember_menu_element(MenuLinkTreeElement $element): void {
  if ($element->link instanceof CacheableDependencyInterface) {
    _xedc_admin_remember_cache($element->link);
  }
  if ($element->access instanceof CacheableDependencyInterface) {
    _xedc_admin_remember_cache($element->access);
  }
}

/**
 * The scaffold "Example" settings form is not a real configuration page.
 */
function _xedc_admin_config_hidden(Url $url): bool {
  if ($url->isRouted() && $url->getRouteName() === 'site_audit_report_entity.settings_form') {
    return TRUE;
  }
  return str_contains(_xedc_admin_link_path($url), '/admin/config/system/site-audit-report-entity');
}

/**
 * Internal path for a menu URL, with a leading slash.
 */
function _xedc_admin_link_path(Url $url): string {
  if (!$url->isRouted()) {
    $path = parse_url($url->toString(), PHP_URL_PATH);
    return is_string($path) ? $path : '';
  }
  return '/' . ltrim($url->getInternalPath(), '/');
}

/**
 * @param array<string, mixed> $item
 *   Link definition.
 *
 * @return array{title: string, url: string, icon: \Drupal\Component\Render\MarkupInterface, active: bool}|null
 *   A visible link, or NULL when the route or permission is missing.
 */
function _xedc_admin_link(array $item): ?array {
  try {
    $url = Url::fromRoute(
      (string) $item['route'],
      $item['params'] ?? [],
      empty($item['query']) ? [] : ['query' => $item['query']],
    );
  }
  catch (\Throwable) {
    return NULL;
  }
  if (!$url->access(\Drupal::currentUser())) {
    return NULL;
  }
  return [
    'title' => (string) $item['title'],
    'url' => $url->toString(),
    'icon' => _xedc_admin_icon((string) ($item['icon'] ?? 'grid')),
    'active' => _xedc_admin_link_active($item),
  ];
}

/**
 * Whether a shortcut or manage URL is the page now on screen.
 */
function _xedc_admin_url_active(Url $url): bool {
  if (!$url->isRouted()) {
    return FALSE;
  }
  if (\Drupal::routeMatch()->getRouteName() !== $url->getRouteName()) {
    return FALSE;
  }
  $current = \Drupal::routeMatch()->getRawParameters()->all();
  foreach ($url->getRouteParameters() as $key => $value) {
    if (!isset($current[$key]) || (string) $current[$key] !== (string) $value) {
      return FALSE;
    }
  }
  return TRUE;
}

/**
 * @param array<string, mixed> $item
 *   Link definition.
 */
function _xedc_admin_link_active(array $item): bool {
  $path = \Drupal::service('path.current')->getPath();
  $route = (string) \Drupal::routeMatch()->getRouteName();
  $vocab = _xedc_admin_current_vocab();
  $match = (string) ($item['match'] ?? '');

  if ($match === 'prefixes') {
    $prefixes = $item['prefixes'] ?? [];
    if (!is_array($prefixes)) {
      return FALSE;
    }
    foreach ($prefixes as $prefix) {
      if (is_string($prefix) && $prefix !== '' && str_starts_with($path, $prefix)) {
        return TRUE;
      }
    }
    return FALSE;
  }

  return match ($match) {
    'route' => $route === (string) ($item['route_name'] ?? ''),
    'content-list' => $route === 'system.admin_content'
      || $route === 'view.content.page_1'
      || str_starts_with($path, '/admin/content/node'),
    'prefix' => isset($item['prefix']) && str_starts_with($path, (string) $item['prefix']),
    'exact' => $path === ($item['path'] ?? ''),
    'vocab' => $vocab === ($item['vocab'] ?? ''),
    'taxonomy-index' => $path === '/admin/structure/taxonomy',
    'structure' => str_starts_with($path, '/admin/structure') && !str_starts_with($path, '/admin/structure/taxonomy'),
    default => FALSE,
  };
}

/**
 * Vocabulary id on taxonomy administration routes.
 */
function _xedc_admin_current_vocab(): string {
  $param = \Drupal::routeMatch()->getParameter('taxonomy_vocabulary');
  if (is_object($param) && method_exists($param, 'id')) {
    return (string) $param->id();
  }
  if (is_string($param)) {
    return $param;
  }
  $path = \Drupal::service('path.current')->getPath();
  if (preg_match('#/taxonomy/manage/([a-z0-9_]+)#', $path, $matches)) {
    return $matches[1];
  }
  return '';
}

/**
 * Original stroke icon. Paths are simple shapes, not a third-party icon set.
 */
function _xedc_admin_icon(string $name): MarkupInterface {
  $shapes = [
    'grid' => '<rect x="4" y="4" width="6.5" height="6.5" rx="1.2"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.2"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.2"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.2"/>',
    'files' => '<path d="M8 4.5h6.2L19 9.2V19a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 7 19V6A1.5 1.5 0 0 1 8.5 4.5H8z"/><path d="M14 4.8V9h4.2"/><path d="M5 8.5v10A1.5 1.5 0 0 0 6.5 20"/>',
    'folder' => '<path d="M3.5 8.2V18a1.5 1.5 0 0 0 1.5 1.5h14A1.5 1.5 0 0 0 20.5 18V9.2A1.5 1.5 0 0 0 19 7.7h-6.2L10.6 5.2H5A1.5 1.5 0 0 0 3.5 6.7v1.5z"/>',
    'users' => '<circle cx="9" cy="9" r="2.4"/><circle cx="16" cy="9.5" r="2"/><path d="M4.8 18.2c.6-2.3 2.4-3.5 4.2-3.5s3.6 1.2 4.2 3.5"/><path d="M13.2 14.8c1.3-.5 2.6-.4 3.6.4 1 .8 1.6 1.8 1.9 3"/>',
    'pulse' => '<path d="M3 12h4l2-5 3 10 2-5h7"/>',
    'settings' => '<path d="M4 8h16M4 16h16"/><circle cx="9" cy="8" r="2.1"/><circle cx="15" cy="16" r="2.1"/>',
    'blocks' => '<rect x="4" y="4" width="7" height="7" rx="1.4"/><rect x="13" y="4" width="7" height="7" rx="1.4"/><rect x="4" y="13" width="7" height="7" rx="1.4"/><path d="M14.2 16.5h4.6M16.5 14.2v4.6"/>',
    'swatch' => '<circle cx="8" cy="8.5" r="2.3"/><circle cx="16" cy="8.5" r="2.3"/><circle cx="8" cy="16" r="2.3"/><circle cx="16" cy="16" r="2.3"/>',
    'star' => '<path d="M12 4.2 13.8 9h5l-4 3.1 1.5 4.9L12 14.2 7.7 17l1.5-4.9-4-3.1h5z"/>',
    'spark' => '<path d="M12 3.5 13.4 8.6 18.5 10 13.4 11.4 12 16.5 10.6 11.4 5.5 10 10.6 8.6z"/><path d="M18 14.5 18.6 16.4 20.5 17 18.6 17.6 18 19.5 17.4 17.6 15.5 17 17.4 16.4z"/>',
    'layout' => '<rect x="4" y="4" width="7" height="16" rx="1.4"/><rect x="13" y="4" width="7" height="7" rx="1.4"/><rect x="13" y="13" width="7" height="7" rx="1.4"/>',
    'home' => '<path d="M4.5 11.2 12 5l7.5 6.2"/><path d="M7 10.2V19h10v-8.8"/>',
  ];
  $shape = $shapes[$name] ?? $shapes['grid'];
  return Markup::create('<svg class="xedc-admin-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">' . $shape . '</svg>');
}
