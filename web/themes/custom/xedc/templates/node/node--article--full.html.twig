{{ attach_library('xedc/article-detail') }}
<article{{ attributes.addClass('xa', 'xa-article').setAttribute('data-xa-nid', node.id) }}>
  <nav class="xa-crumb" aria-label="{{ '面包屑'|t }}">
    <a href="{{ path('<front>') }}">{{ '首页'|t }}</a><span>/</span><a href="{{ path('view.article_list.page_1') }}">{{ '文章'|t }}</a>
    {% if xa_cat %}<span>/</span><a href="{{ xa_cat.url }}">{{ xa_cat.name }}</a>{% endif %}
  </nav>

  <div class="xa-art__grid">
    <div class="xa-art__main">
      <header class="xa-art__head">
        <h1 class="xa-art__title">{{ node.label }}</h1>
        <div class="xa-art__meta">
          {% if xa_author and xa_author != xa_source %}<span>{{ xa_author }}</span>{% endif %}
          {% if xa_source %}<span>{{ '来源：@source'|t({'@source': xa_source}) }}</span>{% endif %}
          <span>{{ xa_date }}</span>
          <span><b data-xa-views>{{ xa_views }}</b> {{ '阅读'|t }}</span>
          <span>{{ '@count 分钟读完'|t({'@count': xa_read}) }}</span>
        </div>
      </header>

      {% if xa_cover %}
        <figure class="xa-cover xa-cover--main{% if xa_cover_portrait %} is-portrait{% else %} is-landscape{% endif %}">
          <img src="{{ xa_cover }}" alt="{{ node.label }}"{% if xa_cover_width %} width="{{ xa_cover_width }}" height="{{ xa_cover_height }}"{% endif %} loading="eager" fetchpriority="high" decoding="async">
        </figure>
      {% endif %}

      {% if xa_summary %}
        <aside class="xa-art__summary"><b>{{ '摘要'|t }}</b>{{ xa_summary }}</aside>
      {% endif %}

      <div class="xa-prose" id="xa-prose">{{ xa_body }}</div>

      <footer class="xa-art__foot">
        {% if xa_cat %}
          <div class="xa-art__tags"><span>{{ '分类：'|t }}</span> <a href="{{ xa_cat.url }}">{{ xa_cat.name }}</a></div>
        {% endif %}
        {% if xa_tags %}
          <div class="xa-art__tags">
            <span>{{ '标签：'|t }}</span>
            {% for t in xa_tags %}<a class="xa-badge xa-badge--outline" href="{{ t.url }}">{{ t.name }}</a>{% endfor %}
          </div>
        {% endif %}
        <div class="xa-art__actions">
          {{ xedc_engagement|default('') }}
          {% if xa_source_url %}
            <a class="xa-btn xa-btn--primary" href="{{ xa_source_url }}" target="_blank" rel="nofollow noopener noreferrer" title="{{ xa_source_host }}">{{ '查看原文'|t }} ↗</a>
          {% endif %}
        </div>
      </footer>

      {% if xa_prev or xa_next %}
        <nav class="xa-pn" aria-label="{{ '上一篇下一篇'|t }}">
          {% if xa_prev %}<a class="xa-pn__item" href="{{ xa_prev.url }}" rel="prev"><small>← {{ '上一篇'|t }}</small><span>{{ xa_prev.title }}</span></a>{% endif %}
          {% if xa_next %}<a class="xa-pn__item is-next" href="{{ xa_next.url }}" rel="next"><small>{{ '下一篇'|t }} →</small><span>{{ xa_next.title }}</span></a>{% endif %}
        </nav>
      {% endif %}
    </div>

    <aside class="xa-art__side">
      <div class="xa-side__sticky">
        <section class="xa-toc" data-xa-toc hidden>
          <h3>{{ '目录'|t }}</h3>
          <nav></nav>
        </section>
        {% if xa_related %}
          <section class="xa-sec-rel">
            <h3>{{ '相关阅读'|t }}</h3>
            <div class="xa-sl">
              {% for a in xa_related %}<a href="{{ a.url }}"><span>{{ a.title }}</span><small>{{ a.meta }}</small></a>{% endfor %}
            </div>
          </section>
        {% endif %}
        {% if xa_hot %}
          <section class="xa-sec-hot">
            <h3>{{ '热门文章'|t }}</h3>
            <div class="xa-sl">
              {% for a in xa_hot %}<a href="{{ a.url }}"><span>{{ a.title }}</span><small>{{ a.meta }}</small></a>{% endfor %}
            </div>
          </section>
        {% endif %}
      </div>
    </aside>
  </div>
</article>
