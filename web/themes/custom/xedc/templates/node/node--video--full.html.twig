{{ content|cache_metadata }}
{{ attach_library('xedc/video-detail') }}
{{ attach_library('xedc/video-player') }}
{{ vd_cache }}
{% set cover = vd.cover %}
{% set dur = node.field_duration.value %}
{% set author = node.owner.entity.displayname.value %}
<div class="vd-wrap">
  <nav class="vd-crumb">
    <a href="{{ path('<front>') }}">{{ '首页'|t }}</a><span class="sp">/</span>
    {% if node.field_categories.0.entity %}<a href="{{ path('entity.taxonomy_term.canonical', {'taxonomy_term': node.field_categories.0.target_id}) }}">{{ node.field_categories.0.entity.label }}</a><span class="sp">/</span>{% endif %}
    <span class="cur">{{ label }}</span>
  </nav>
  <div class="vd-layout">
    <article{{ attributes.addClass('vd') }}>
      <div class="vd-player">
        {% if vd.type == 'video' or vd.type == 'hls' %}
          {% if cover %}<img class="vd-poster" src="{{ cover }}" alt="{{ node.label }}"{% if vd.cover_width %} width="{{ vd.cover_width }}" height="{{ vd.cover_height }}"{% endif %} loading="eager" fetchpriority="high" decoding="async">{% endif %}
          <video class="vd-video" playsinline preload="metadata"{% if cover %} poster="{{ cover }}" data-poster="{{ cover }}"{% endif %}{% if vd.type == 'hls' %} data-hls="{{ vd.src }}"{% endif %}>
            {% if vd.type == 'video' %}<source src="{{ vd.src }}"{% if vd.mime %} type="{{ vd.mime }}"{% endif %}>{% endif %}
          </video>
        {% elseif vd.type == 'iframe' %}
          <div class="vd-click" data-embed="{{ vd.src }}">
            {% if cover %}<img src="{{ cover }}" alt="{{ node.label }}"{% if vd.cover_width %} width="{{ vd.cover_width }}" height="{{ vd.cover_height }}"{% endif %} loading="eager" fetchpriority="high">{% endif %}
            <button type="button" class="vd-play" aria-label="{{ '播放'|t }}">▶</button>
          </div>
          <script>document.querySelector('.vd-click').addEventListener('click',function(){var i=document.createElement('iframe');i.src=this.dataset.embed;i.allow='autoplay; fullscreen';i.allowFullscreen=true;i.referrerPolicy='strict-origin-when-cross-origin';this.replaceWith(i)});</script>
        {% elseif cover %}
          <img src="{{ cover }}" alt="{{ node.label }}"{% if vd.cover_width %} width="{{ vd.cover_width }}" height="{{ vd.cover_height }}"{% endif %} loading="eager" fetchpriority="high">
        {% endif %}
      </div>

      <div class="vd-card">
        <h1 class="vd-title">{{ label }}</h1>
        <div class="vd-meta">
          <span>{{ node.createdtime|date('Y-m-d') }}</span>
          {% if dur %}<span>·</span><span>{{ '%d:%02d'|format(dur // 60, dur % 60) }}</span>{% endif %}
          {% if node.field_views.value is not empty %}<span>·</span><span>{{ '@count 次播放'|t({'@count': node.field_views.value}) }}</span>{% endif %}
          {% if author %}<span>·</span><span>{{ author }}</span>{% endif %}
        </div>
        {% if node.field_categories|length %}
          <div class="vd-classify">
            <span>{{ '分类：'|t }}</span>
            {% for item in node.field_categories %}
              <a href="{{ path('entity.taxonomy_term.canonical', {'taxonomy_term': item.target_id}) }}">{{ item.entity.label }}</a>
            {% endfor %}
          </div>
        {% endif %}
        {% if node.field_tags|length %}
          <div class="vd-tags">
            <span>{{ '标签：'|t }}</span>
            {% for item in node.field_tags %}
              <a href="{{ path('entity.taxonomy_term.canonical', {'taxonomy_term': item.target_id}) }}">#{{ item.entity.label }}</a>
            {% endfor %}
          </div>
        {% endif %}
        <div class="vd-actions">{{ xedc_engagement|default('') }}</div>
        {% if node.field_body.value %}
        <div class="vd-sep"></div>
        <div class="vd-body">{{ content.field_body }}</div>
        {% endif %}
      </div>
    </article>

    <aside class="vd-side">
      {% if vd_latest %}
      <div class="vd-panel">
        <h3>{{ '最新视频'|t }}</h3>
        {% for v in vd_latest %}
        <a class="vd-mini" href="{{ v.url }}">
          <span class="th">{% if v.cover %}<img src="{{ v.cover }}" alt="{{ v.title }}" width="640" height="360" loading="lazy" decoding="async">{% endif %}</span>
          <span class="tt">{{ v.title }}</span>
        </a>
        {% endfor %}
      </div>
      {% endif %}
      {% if vd_cats %}
      <div class="vd-panel">
        <h3>{{ '分类栏目'|t }}</h3>
        <div class="vd-badges" style="margin:0">
          {% for c in vd_cats %}
            <a class="vd-badge" href="{{ path('entity.taxonomy_term.canonical', {'taxonomy_term': c.tid}) }}">{{ c.name }}</a>
          {% endfor %}
        </div>
      </div>
      {% endif %}
    </aside>
  </div>

  {% if vd_related %}
  <section class="vd-related">
    <h2>{{ '相关推荐'|t }}</h2>
    <div class="vd-grid">
      {% for v in vd_related %}
      <a class="vd-item" href="{{ v.url }}">
        <span class="th">
          {% if v.cover %}<img src="{{ v.cover }}" alt="{{ v.title }}" width="640" height="360" loading="lazy" decoding="async">{% endif %}
          <i class="pi"></i>{% if v.dur %}<em>{{ v.dur }}</em>{% endif %}
        </span>
        <span class="tt">{{ v.title }}</span>
      </a>
      {% endfor %}
    </div>
  </section>
  {% endif %}
</div>
