{{ content|cache_metadata }}
{{ attach_library('xedc/video-detail') }}
{{ attach_library('xedc/video-player') }}
{{ vd_cache }}
<div class="vd-wrap">
  <nav class="vd-crumb" aria-label="{{ '面包屑'|t }}">
    <a href="{{ path('<front>') }}">{{ '首页'|t }}</a>
    <span aria-hidden="true">/</span>
    <a href="{{ path('view.video_list.page_1') }}">{{ '视频'|t }}</a>
    {% if vd_categories %}
      <span aria-hidden="true">/</span>
      <a href="{{ vd_categories.0.url }}">{{ vd_categories.0.name }}</a>
    {% endif %}
    <span aria-hidden="true">/</span>
    <span class="cur" aria-current="page">{{ label }}</span>
  </nav>
  <div class="vd-layout">
    <article{{ attributes.addClass('vd') }}>
      <div class="vd-player" data-xedc-player data-nid="{{ node.id }}" data-duration="{{ vd_seconds|default(0) }}" data-playback-state="{{ vd.playback_state|default('original') }}">
        {% if vd.type == 'video' or vd.type == 'hls' %}
          <video class="vd-video" playsinline preload="metadata"{% if vd.cover %} poster="{{ vd.cover }}"{% endif %}{% if vd.type == 'hls' %} data-hls="{{ vd.src }}"{% endif %}>
            {% if vd.type == 'video' %}<source src="{{ vd.src }}"{% if vd.mime %} type="{{ vd.mime }}"{% endif %}>{% endif %}
          </video>
        {% elseif vd.type == 'iframe' %}
          <div class="vd-click" data-embed="{{ vd.src }}">
            {% if vd.cover %}<img src="{{ vd.cover }}" alt="{{ node.label }}" width="{{ vd.cover_width|default(640) }}" height="{{ vd.cover_height|default(360) }}" loading="eager" fetchpriority="high">{% endif %}
            <button type="button" class="vd-play" aria-label="{{ '播放'|t }}">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>
            </button>
          </div>
        {% elseif vd.cover %}
          <img src="{{ vd.cover }}" alt="{{ node.label }}" width="{{ vd.cover_width|default(640) }}" height="{{ vd.cover_height|default(360) }}" loading="eager">
          <div class="vd-state">
            <p class="vd-state__text">{{ '视频文件不存在'|t }}</p>
          </div>
        {% else %}
          <div class="vd-state">
            <p class="vd-state__text">{{ '视频文件不存在'|t }}</p>
          </div>
        {% endif %}
      </div>
      {% if vd.type == 'video' or vd.type == 'hls' %}
        <div class="vd-state" hidden>
          <p class="vd-state__text"></p>
          <button type="button" class="vd-state__retry">{{ '重试'|t }}</button>
        </div>
        <div class="vd-resume" hidden>
          <p></p>
          <button type="button" class="vd-resume__go">{{ '继续播放'|t }}</button>
          <button type="button" class="vd-resume__start">{{ '从头播放'|t }}</button>
        </div>
      {% endif %}

      <div class="vd-card">
        <h1 class="vd-title">{{ label }}</h1>
        <div class="vd-meta">
          {% if vd_duration %}<span>{{ vd_duration }}</span>{% endif %}
          <span>{{ '@count 次播放'|t({'@count': vd_views|default(0)}) }}</span>
          {% if vd_date %}<span>{{ vd_date }}</span>{% endif %}
        </div>
        {% if vd_author.name %}
          <p class="vd-author"><a href="{{ vd_author.url }}">{{ vd_author.name }}</a></p>
        {% endif %}
        <div class="vd-actions">{{ xedc_engagement }}</div>
        {% if vd_categories %}
          <div class="vd-classify">
            <span>{{ '分类'|t }}</span>
            {% for item in vd_categories %}
              <a href="{{ item.url }}">{{ item.name }}</a>
            {% endfor %}
          </div>
        {% endif %}
        {% if vd_tags %}
          <div class="vd-tags">
            <span>{{ '标签'|t }}</span>
            {% for item in vd_tags %}
              <a href="{{ item.url }}">{{ item.name }}</a>
            {% endfor %}
          </div>
        {% endif %}
        {% if node.field_body.value %}
          <div class="vd-body" data-vd-body>
            <div class="vd-body__content">{{ content.field_body }}</div>
            <button type="button" class="vd-body__toggle" hidden>{{ '展开'|t }}</button>
          </div>
        {% endif %}
      </div>
    </article>

    {% if vd_related %}
      <aside class="vd-side">
        <h2>{{ '相关推荐'|t }}</h2>
        <div class="vd-related">
          {% for card in vd_related %}
            <article class="vcard">
              {% include directory ~ '/templates/video/video-card.html.twig' with { card: card } only %}
            </article>
          {% endfor %}
        </div>
      </aside>
    {% endif %}
  </div>
</div>
