{#
/**
 * @file
 * Shared layout for the six XEDC HTTP status pages.
 */
#}
{% set code = code|default(0) %}
<main id="main-content" class="xs{{ code == 429 ? ' xs-429' : '' }}" data-xs-code="{{ code }}">
  <div class="xs-group">
    <div class="xs-stage">
      <div class="xs-icon-box" data-xs-icon="{{ code }}" role="img" aria-label="{{ title }}">
        {% if code == 404 %}
          <svg class="xs-icon xs-icon-svg" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
            <polyline points="14 2 14 8 20 8"/>
            <path d="M9 13a2.5 2.5 0 0 1 4.2-1.8"/>
            <circle cx="12" cy="17" r=".5" fill="currentColor" stroke="none"/>
          </svg>
        {% elseif code == 403 %}
          <svg class="xs-icon xs-icon-svg" viewBox="0 0 24 24" aria-hidden="true">
            <circle class="xs-lock-ring" cx="12" cy="16" r="4"/>
            <path class="xs-lock-shackle" d="M8 11V8a4 4 0 0 1 8 0v3"/>
          </svg>
        {% elseif code == 500 %}
          <svg class="xs-icon xs-icon-svg" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" x2="12" y1="8" y2="12"/>
            <line x1="12" x2="12.01" y1="16" y2="16"/>
          </svg>
        {% elseif code == 502 %}
          <svg class="xs-icon xs-icon-svg xs-net" viewBox="0 0 24 24" aria-hidden="true">
            <circle class="xs-node xs-node-l" cx="7" cy="12" r="2.5"/>
            <circle class="xs-node xs-node-r" cx="17" cy="12" r="2.5"/>
            <line class="xs-link" x1="9.5" y1="12" x2="14.5" y2="12"/>
          </svg>
        {% elseif code == 503 %}
          <svg class="xs-icon xs-icon-svg" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
          </svg>
        {% elseif code == 429 %}
          <svg class="xs-icon xs-icon-svg xs-gauge" viewBox="0 0 24 24" aria-hidden="true">
            <circle class="xs-gauge-ring" cx="12" cy="14" r="7"/>
            <path d="M12 14V8"/>
            <circle cx="12" cy="14" r="1" fill="currentColor" stroke="none"/>
          </svg>
        {% endif %}
      </div>
    </div>

    <p class="xs-code">{{ code }}</p>
    <h1 class="xs-title">{{ title }}</h1>
    <p class="xs-lead">{{ message }}</p>
    {% if eta %}
      <p class="xs-eta">{{ eta }}</p>
    {% endif %}
    {% if code == 429 and retry_after|default(0) > 0 %}
      <p class="xs-wait" data-xs-wait="{{ retry_after }}" data-xs-wait-tpl="{{ '请等待 @count'|t }}" data-xs-wait-done="{{ '可以重新尝试了'|t }}" aria-live="polite">{{ '请等待 @count'|t({'@count': retry_after ~ ' 秒'}) }}</p>
    {% endif %}

    {% if show_home or show_login or show_back or show_retry %}
      <div class="xs-actions">
        {% if show_retry %}
          <a class="xs-btn xs-btn-primary" href="{{ retry_url|default(front|default('/')) }}"{% if code == 429 and retry_after|default(0) > 0 %} data-xs-retry{% endif %}{% if code in [500, 502, 503] %} data-xs-reload{% endif %}>{{ retry_label|default('重新尝试'|t) }}</a>
        {% endif %}
        {% if show_home %}
          <a class="xs-btn {{ show_retry ? 'xs-btn-secondary' : 'xs-btn-primary' }}" href="{{ front|default('/') }}">{{ '返回首页'|t }}</a>
        {% endif %}
        {% if show_login %}
          <a class="xs-btn xs-btn-secondary" href="{{ login }}">{{ '登录账号'|t }}</a>
        {% endif %}
        {% if show_back %}
          <button type="button" class="xs-btn xs-btn-secondary" data-xs-back data-xs-home="{{ front|default('/') }}">{{ '返回上一页'|t }}</button>
        {% endif %}
      </div>
    {% endif %}
  </div>
</main>
