{#
/**
 * @file
 * Shared layout for XEDC status pages. One pixel traveler, six scenes.
 */
#}
{% set code = code|default(0) %}
<main id="main-content" class="xs{{ code == 429 ? ' xs-429' : '' }}" data-xs-code="{{ code }}">
  <div class="xs-group">
    <p class="xs-kicker">SYSTEM / {{ code }}</p>
    <p class="xp-code">{{ code }}</p>
    <div class="xs-stage" data-xi="{{ code }}">
      <div class="xp" data-xp="{{ code }}">
        <div class="xp-viewport">
          <div class="xp-scale">
            <div class="xp-world">
              <i class="xp-ground"></i>
              {% if code == 404 %}
                <i class="xp-curb"></i>
                <b class="xp-icon xp-ask"></b>
              {% elseif code == 403 %}
                <span class="xp-wall" data-xp-wall><i class="xp-post"></i><i class="xp-post"></i><i class="xp-post"></i></span>
                <b class="xp-icon xp-stop"></b>
              {% elseif code == 500 %}
                <i class="xp-bit"></i><i class="xp-bit"></i><i class="xp-bit"></i><i class="xp-bit"></i>
                <button type="button" class="xp-replay" data-xp-replay aria-label="{{ '再看一次故障'|t }}"></button>
              {% elseif code == 502 %}
                <span class="xp-line"><i class="xp-sig"></i><i class="xp-sig"></i><i class="xp-sig"></i><i class="xp-gap"></i><i class="xp-sig"></i><i class="xp-sig"></i></span>
              {% elseif code == 503 %}
                <span class="xp-device"><i class="xp-screen"></i><i class="xp-screen"></i><i class="xp-screen"></i></span>
                <b class="xp-icon xp-spark"></b>
              {% elseif code == 429 %}
                <span class="xp-bag"><i class="xp-crate"></i><i class="xp-crate"></i><i class="xp-crate"></i><i class="xp-crate"></i></span>
              {% endif %}
              <i class="xp-actor" data-xp-actor><i></i></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <h1 class="xs-title">{{ title }}</h1>
    <p class="xs-lead">{{ message }}</p>
    {% if eta %}
      <p class="xs-eta">{{ eta }}</p>
    {% endif %}
    {% if code == 429 and retry_after|default(0) > 0 %}
      <p class="xs-wait" data-xs-wait="{{ retry_after }}" data-xs-wait-tpl="{{ '请等待 @count'|t }}" data-xs-wait-done="{{ '可以重新尝试了'|t }}" aria-live="polite">{{ '请等待 @count'|t({'@count': retry_after ~ ' 秒'}) }}</p>
    {% endif %}

    {% if show_home or show_login or show_back or show_retry %}
      <div class="xs-actions">
        {% if show_retry %}
          <a class="xs-btn xs-btn-primary" href="{{ retry_url|default(front|default('/')) }}" {% if code == 429 and retry_after|default(0) > 0 %}data-xs-retry{% endif %}{% if code == 502 %}data-xp-retry{% endif %}>{{ retry_label|default('重新尝试'|t) }}</a>
        {% endif %}
        {% if show_home %}
          <a class="xs-btn {{ show_retry ? 'xs-btn-secondary' : 'xs-btn-primary' }}" href="{{ front|default('/') }}" {% if code == 404 %}data-xp-leave{% endif %}>{{ '返回首页'|t }}</a>
        {% endif %}
        {% if show_login %}
          <a class="xs-btn xs-btn-secondary" href="{{ login }}">{{ '登录'|t }}</a>
        {% endif %}
        {% if show_back %}
          <button type="button" class="xs-btn xs-btn-secondary" data-xs-back data-xs-home="{{ front|default('/') }}">{{ '返回上一页'|t }}</button>
        {% endif %}
      </div>
    {% endif %}
  </div>
</main>
