{{ attach_library('xedc/video_list') }}
<div class="xv-page">
  <header class="xv-head">
    <div class="xv-head__main">
      <h1>{{ '视频'|t }}</h1>
      <p>{{ '浏览已发布的视频。'|t }}</p>
    </div>
    {% if video_total %}
      <p class="xv-count">{{ '@count 个视频'|t({'@count': video_total}) }}</p>
    {% endif %}
  </header>

  {% include directory ~ '/templates/video/video-toolbar.html.twig' with {
    categories: video_categories,
    sort_urls: video_sort_urls,
    sort: video_sort,
    keys: video_keys,
    action: video_action
  } only %}

  {% if video_recommended %}
    <section class="xv-block" aria-label="{{ '推荐视频'|t }}">
      <h2 class="xv-section">{{ '推荐视频'|t }}</h2>
      <div class="xv-grid xv-grid--cards">
        {% for card in video_recommended %}
          <article class="vcard">
            {% include '@xedc/templates/video/video-card.html.twig' with { card: card } only %}
          </article>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {% if video_hot %}
    <section class="xv-block" aria-label="{{ '热门视频'|t }}">
      <h2 class="xv-section">{{ '热门视频'|t }}</h2>
      <div class="xv-grid xv-grid--cards">
        {% for card in video_hot %}
          <article class="vcard">
            {% include '@xedc/templates/video/video-card.html.twig' with { card: card } only %}
          </article>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {% if rows or empty or pager %}
    <section class="xv-block" aria-label="{{ '最新视频'|t }}">
      {% if video_recommended or video_hot %}
        <h2 class="xv-section">{{ video_sort == 'hot' ? '热门排序'|t : '最新视频'|t }}</h2>
      {% endif %}
      {% if rows %}
        <div class="xv-grid">{{ rows }}</div>
      {% elseif empty %}
        {{ empty }}
      {% endif %}
      {% if pager %}
        <div class="xv-pager">{{ pager }}</div>
      {% endif %}
    </section>
  {% endif %}
</div>
