{{ attach_library('xedc/video_list') }}
<div class="xv-page">
  {{ header }}
  {% include directory ~ '/templates/video/video-toolbar.html.twig' with {
    categories: video_categories,
    sort_urls: video_sort_urls,
    sort: video_sort,
    keys: video_keys,
    action: video_action
  } only %}

  {% if video_category_hot %}
    <section class="xv-block" aria-label="{{ '热门视频'|t }}">
      <h2 class="xv-section">{{ '热门视频'|t }}</h2>
      <div class="xv-grid xv-grid--cards">
        {% for card in video_category_hot %}
          <article class="vcard">
            {% include '@xedc/templates/video/video-card.html.twig' with { card: card } only %}
          </article>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {% if rows or empty or pager %}
    <section class="xv-block" aria-label="{{ '全部视频'|t }}">
      {% if video_category_hot %}
        <h2 class="xv-section">{{ '全部视频'|t }}</h2>
      {% endif %}
      {% if rows %}
        <div class="xv-grid">{{ rows }}</div>
      {% elseif empty %}
        {{ empty }}
      {% endif %}
      {% if pager %}
        <div class="xv-pager">{{ pager }}</div>
      {% endif %}
    </section>
  {% endif %}
</div>
