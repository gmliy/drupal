{{ attach_library('xedc/search-page') }}
{% set i_search %}<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>{% endset %}
{% set i_close %}<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>{% endset %}
{% set i_arrow %}<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>{% endset %}

<div class="sr-page{{ type == 'video' ? ' sr-page--video' }}">
  <form class="sr-form" action="{{ form_action }}" method="get" role="search">
    <div class="sr-field">
      <span class="sr-field-icon">{{ i_search }}</span>
      <input class="sr-input" type="search" name="q" value="{{ q }}" placeholder="{{ '搜索美图、视频、文章、模特…'|t }}" autocomplete="off" aria-label="{{ '搜索关键词'|t }}">
      <button class="sr-clear" type="button" data-sr-clear aria-label="{{ '清除关键词'|t }}"{% if not q %} hidden{% endif %}>{{ i_close }}</button>
      <button class="sr-submit" type="submit">{{ '搜索'|t }}</button>
    </div>
    <div class="xs-adv">
      <label>{{ '从'|t }} <input type="date" name="from" value="{{ from }}"></label>
      <label>{{ '至'|t }} <input type="date" name="to" value="{{ to }}"></label>
    </div>
    {% if type != 'all' %}<input type="hidden" name="type" value="{{ type }}">{% endif %}
    {% if sort != 'relevance' %}<input type="hidden" name="sort" value="{{ sort }}">{% endif %}
    {% if category %}<input type="hidden" name="category" value="{{ category }}">{% endif %}
    {% if tag %}<input type="hidden" name="tag" value="{{ tag }}">{% endif %}
    {% if model %}<input type="hidden" name="model" value="{{ model }}">{% endif %}
  </form>
  {% if chips %}
    <div class="xs-chips">
      {% for chip in chips %}
        <a class="sr-sort xedc-pill" href="{{ chip.url }}">{{ chip.label }} ×</a>
      {% endfor %}
    </div>
  {% endif %}

  <div class="sr-tabs-wrap">
    <nav class="sr-tabs" aria-label="{{ '搜索类型'|t }}">
      {% for tab in tabs %}
        <a class="sr-tab xedc-pill{{ tab.active ? ' is-active' }}" href="{{ tab.url }}">{{ tab.label }}{% if q %}<span class="sr-tab-count">{{ tab.count }}</span>{% endif %}</a>
      {% endfor %}
    </nav>
  </div>

  {% if models %}
    <section class="sr-models" aria-label="{{ '匹配的模特'|t }}">
      {% for model in models %}
        <a class="sr-model-card" href="{{ model.url }}">
          <span class="sr-model-avatar">
            {% if model.cover %}<img src="{{ model.cover }}" alt="{{ model.name }}" loading="lazy">{% else %}<span>{{ model.initial }}</span>{% endif %}
          </span>
          <span class="sr-model-info">
            <span class="sr-model-label">{{ '模特'|t }}</span>
            <strong class="sr-model-name">{{ model.name_html }}</strong>
            <span class="sr-model-count">{{ '@count 个作品'|t({'@count': model.count}) }}</span>
          </span>
          <span class="sr-model-arrow">{{ i_arrow }}</span>
        </a>
      {% endfor %}
    </section>
  {% endif %}

  {% if q %}
    <div class="sr-info">
      <p class="sr-info-text">{{ '找到 @count 条与「@query」相关的结果'|t({'@count': info_count, '@query': q}) }}</p>
      {% if type != 'model' %}
        <div class="sr-sorts" aria-label="{{ '排序'|t }}">
          {% for item in sorts %}
            <a class="sr-sort xedc-pill{{ item.active ? ' is-active' }}" href="{{ item.url }}">{{ item.label }}</a>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  {% endif %}

  {% if cards %}
    <ul class="sr-grid">
      {% for card in cards %}
        {% include "@xedc/templates/includes/search-card.html.twig" %}
      {% endfor %}
    </ul>
    <div class="sr-pager">
      {% include "@xedc/templates/views/xa-pager.html.twig" %}
    </div>
  {% elseif q %}
    <div class="sr-empty">
      <span class="sr-empty-icon">{{ i_search }}</span>
      <h2>{{ '没有找到「@query」相关内容'|t({'@query': q}) }}</h2>
      <p>{{ '搜索建议：检查是否有错别字，或换一个更短、更常见的关键词试试。'|t }}</p>
      <div class="sr-empty-actions">
        {% for item in explore %}
          <a class="sr-empty-link" href="{{ item.url }}">{{ item.label }}</a>
        {% endfor %}
      </div>
    </div>
  {% else %}
    <div class="sr-empty">
      <span class="sr-empty-icon">{{ i_search }}</span>
      <h2>{{ '搜索美图、视频、文章和模特'|t }}</h2>
      <p>{{ '输入模特名、作品标题或关键词，开始发现内容。'|t }}</p>
      <div class="sr-empty-actions">
        {% for item in explore %}
          <a class="sr-empty-link" href="{{ item.url }}">{{ item.label }}</a>
        {% endfor %}
      </div>
      {% if hot_models %}
        <div class="sr-hot">
          <span class="sr-hot-title">{{ '热门模特'|t }}</span>
          {% for model in hot_models %}
            <a class="sr-hot-link" href="{{ model.url }}">{{ model.name }}<span>{{ model.count }}</span></a>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  {% endif %}
</div>
