/**
 * Creates the AI operations tables when they are missing.
 */
function xedc_ai_update_10001(): string {
  $schema = xedc_ai_schema();
  $database = \Drupal::database();
  foreach ($schema as $name => $table) {
    if (!$database->schema()->tableExists($name)) {
      $database->schema()->createTable($name, $table);
    }
  }
  return 'AI 运营中心数据表已就绪。';
}

/**
 * Adds model capabilities, review notes and operation-log details.
 */
function xedc_ai_update_10002(): string {
  $database = \Drupal::database();
  $schema = $database->schema();
  $spec = xedc_ai_schema();
  $fields = [
    'xedc_ai_model' => ['capabilities'],
    'xedc_ai_review' => ['task_note'],
    'xedc_ai_audit' => ['target_type', 'target_id', 'before_text', 'after_text', 'suggestion', 'confirmed', 'outcome'],
  ];
  foreach ($fields as $table => $names) {
    foreach ($names as $name) {
      if ($schema->tableExists($table) && !$schema->fieldExists($table, $name)) {
        $schema->addField($table, $name, $spec[$table]['fields'][$name]);
      }
    }
  }
  $rules = \Drupal::configFactory()->getEditable('xedc_ai.rules');
  if ($rules->get('min_title') === NULL) {
    $rules->setData(\Drupal\xedc_ai\Review\RuleLimits::defaults())->save(TRUE);
  }
  return 'AI 运营中心已补充模型能力、审核备注和操作日志字段。';
}

/**
 * Stores real token usage, cache reads and the cache-token price.
 */
function xedc_ai_update_10003(): string {
  $database = \Drupal::database();
  $schema = $database->schema();
  $spec = xedc_ai_schema();
  $fields = [
    'xedc_ai_model' => ['cache_price'],
    'xedc_ai_usage' => ['entity_id', 'revision_id', 'usage_reported', 'cache_read_tokens', 'http_status', 'finish_reason', 'retry_index', 'cost_status'],
  ];
  foreach ($fields as $table => $names) {
    foreach ($names as $name) {
      if ($schema->tableExists($table) && !$schema->fieldExists($table, $name)) {
        $schema->addField($table, $name, $spec[$table]['fields'][$name]);
      }
    }
  }
  if ($schema->fieldExists('xedc_ai_usage', 'usage_reported') && $schema->fieldExists('xedc_ai_usage', 'cost_status')) {
    $database->query("UPDATE {xedc_ai_usage} SET usage_reported = 1 WHERE usage_reported = 0 AND (prompt_tokens + completion_tokens) > 0 AND cost_status = ''");
  }
  return 'AI 用量已可以区分 Token 未返回、单价未配置和已核算费用。';
}

/**
 * Adds the archived → published transition on the editorial workflow.
 *
 * Active configuration only. config/sync is left unchanged, so a later
 * config import from config/sync will drop this transition until it is exported.
 */
function xedc_ai_update_10004(): string {
  $storage = \Drupal::entityTypeManager()->getStorage('workflow');
  $workflow = $storage->load('xedc_editorial');
  if ($workflow === NULL) {
    return '没有找到 xedc_editorial，未添加重新发布转换。';
  }
  $plugin = $workflow->getTypePlugin();
  if (!$plugin->hasState('archived') || !$plugin->hasState('published')) {
    return 'xedc_editorial 缺少已撤下或已发布状态，未添加转换。';
  }
  $exists = FALSE;
  foreach ($plugin->getTransitions() as $transition) {
    $from = array_map(static fn ($state): string => $state->id(), $transition->from());
    if (in_array('archived', $from, TRUE) && $transition->to()->id() === 'published') {
      $exists = TRUE;
      break;
    }
  }
  if (!$exists) {
    $plugin->addTransition('republish', '重新发布', ['archived'], 'published');
    $workflow->save();
  }
  $permission = 'use xedc_editorial transition republish';
  foreach (\Drupal::entityTypeManager()->getStorage('user_role')->loadMultiple() as $role) {
    if ($role->isAdmin() || in_array($role->id(), ['anonymous', 'authenticated'], TRUE)) {
      continue;
    }
    if ($role->hasPermission('use xedc_editorial transition publish') && !$role->hasPermission($permission)) {
      $role->grantPermission($permission);
      $role->save();
    }
  }
  return 'xedc_editorial 已增加「已撤下 → 已发布」转换「重新发布」。拥有直接发布权限的角色可以使用它，普通会员不可以。';
}

/**
 * Implements hook_uninstall().
 */
function xedc_ai_uninstall(): void {
  if (\Drupal::hasService('xedc_ai.secrets')) {
    \Drupal::service('xedc_ai.secrets')->deleteAll();
  }
}
