{% if items %}
  <div class="xedc-ai-bars">
    {% for item in items %}
      <div class="xedc-ai-bar"><span>{{ item.label }}</span><i><b style="width: {{ item.percent }}%"></b></i><em>{{ item.value }}</em></div>
    {% endfor %}
  </div>
{% else %}
  <p class="xedc-ai-empty">还没有审核记录。</p>
{% endif %}
