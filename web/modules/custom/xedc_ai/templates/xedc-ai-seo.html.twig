<div class="xedc-seo-dashboard" data-xedc-seo-dashboard>
  <div class="xedc-seo-intro">
    <p>查看内容 SEO 表现、分析问题和优化建议。</p>
    {% if suggest %}
      <div class="xedc-seo-create">{{ suggest }}</div>
    {% endif %}
  </div>
  <section class="xedc-seo-sheet">
    <form class="xedc-seo-filters" method="get" action="{{ path('xedc_ai.seo') }}">
      <label>搜索
        <input type="search" name="q" value="{{ filters.q }}" placeholder="标题或内容 ID">
      </label>
      <label>内容类型
        <select name="bundle">
          <option value="">全部</option>
          <option value="photo" {% if filters.bundle == 'photo' %}selected{% endif %}>美图</option>
          <option value="video" {% if filters.bundle == 'video' %}selected{% endif %}>视频</option>
          <option value="article" {% if filters.bundle == 'article' %}selected{% endif %}>文章</option>
          <option value="page" {% if filters.bundle == 'page' %}selected{% endif %}>页面</option>
        </select>
      </label>
      <label>状态
        <select name="ops">
          <option value="">全部</option>
          <option value="queued" {% if filters.ops == 'queued' %}selected{% endif %}>等待分析</option>
          <option value="running" {% if filters.ops == 'running' %}selected{% endif %}>分析中</option>
          <option value="failed" {% if filters.ops == 'failed' %}selected{% endif %}>分析失败</option>
          <option value="awaiting" {% if filters.ops == 'awaiting' %}selected{% endif %}>待人工确认</option>
          <option value="partial" {% if filters.ops == 'partial' %}selected{% endif %}>部分采纳</option>
          <option value="applied" {% if filters.ops == 'applied' %}selected{% endif %}>已采纳</option>
          <option value="rejected" {% if filters.ops == 'rejected' %}selected{% endif %}>已忽略</option>
        </select>
      </label>
      <label>评分
        <select name="score">
          <option value="">全部</option>
          <option value="low" {% if filters.score == 'low' %}selected{% endif %}>0–59</option>
          <option value="mid" {% if filters.score == 'mid' %}selected{% endif %}>60–79</option>
          <option value="high" {% if filters.score == 'high' %}selected{% endif %}>80–100</option>
        </select>
      </label>
      <label>问题
        <select name="issues">
          <option value="">全部</option>
          <option value="yes" {% if filters.issues == 'yes' %}selected{% endif %}>有问题</option>
          <option value="no" {% if filters.issues == 'no' %}selected{% endif %}>无问题</option>
        </select>
      </label>
      <label>模型
        <input type="search" name="model" value="{{ filters.model }}" placeholder="模型">
      </label>
      <label>开始
        <input type="date" name="from" value="{{ filters.from }}">
      </label>
      <label>结束
        <input type="date" name="to" value="{{ filters.to }}">
      </label>
      <button class="button" type="submit">筛选</button>
    </form>
    {% if rows %}
      <table class="xedc-seo-grid">
        <thead>
          <tr>
            <th>内容</th>
            <th>SEO 评分</th>
            <th>问题</th>
            <th>建议</th>
            <th>AI 用量</th>
            <th>状态</th>
            <th>分析时间</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
        {% for row in rows %}
          {% set score_num = row.score matches '/^\\d+$/' ? row.score + 0 : -1 %}
          {% if score_num >= 80 %}
            {% set tone = 'good' %}
          {% elseif score_num >= 60 %}
            {% set tone = 'mid' %}
          {% elseif score_num >= 0 %}
            {% set tone = 'low' %}
          {% else %}
            {% set tone = 'none' %}
          {% endif %}
          <tr>
            <td data-label="内容">
              <a class="xedc-seo-name" href="{{ row.url }}">{{ row.title }}</a>
              <p class="xedc-seo-muted">{{ row.bundle }} · 内容 ID {{ row.entity_id }}</p>
            </td>
            <td data-label="SEO 评分"><span class="xedc-seo-score is-{{ tone }}">{{ row.score }}</span></td>
            <td data-label="问题"><span class="xedc-seo-num">{{ row.issues }}</span></td>
            <td data-label="建议"><span class="xedc-seo-num">{{ row.suggestions }}</span></td>
            <td data-label="AI 用量" class="xedc-seo-usage">
              <strong>{{ row.model }}</strong>
              Token {{ row.tokens }} · {{ row.cost }}
            </td>
            <td data-label="状态"><span class="xedc-ai-status is-{{ row.ops_key }}">{{ row.ops }}</span></td>
            <td data-label="分析时间">{{ row.time }}</td>
            <td data-label="操作"><a class="xedc-seo-action" href="{{ row.url }}">查看详情</a></td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
      {{ pager }}
    {% else %}
      <p class="xedc-seo-empty">这个筛选条件下没有 SEO 分析。</p>
    {% endif %}
  </section>
  <details class="xedc-seo-fold">
    <summary>已保存的站点检查</summary>
    <p class="xedc-seo-muted">{{ audit.message }}</p>
    {% if audit.items %}
      <table class="xedc-seo-grid">
        <thead><tr><th>项目</th><th>结果</th><th>说明</th></tr></thead>
        <tbody>
        {% for item in audit.items %}
          <tr><td>{{ item.label }}</td><td>{{ item.value }}</td><td>{{ item.meaning }}{% if item.detail %}<br>{{ item.detail }}{% endif %}</td></tr>
        {% endfor %}
        </tbody>
      </table>
    {% endif %}
  </details>
</div>
