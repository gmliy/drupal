{% set score_text = review.score|default('—') %}
{% set score_num = score_text matches '/^\\d+$/' ? score_text + 0 : -1 %}
{% if score_num < 0 %}
  {% set score_grade = '未评分' %}
{% elseif score_num >= 80 %}
  {% set score_grade = '良好' %}
{% elseif score_num >= 60 %}
  {% set score_grade = '一般' %}
{% else %}
  {% set score_grade = '需改进' %}
{% endif %}
<div class="xedc-seo-detail" data-xedc-seo-detail>
  <header class="xedc-seo-top">
    <div>
      <p class="xedc-seo-kicker">{{ review.bundle }} · 内容 ID {{ review.entity_id }}</p>
      <h2 class="xedc-seo-title">{{ review.title }}</h2>
      <p class="xedc-seo-states">
        <span class="xedc-ai-status is-{{ review.publish_key }}">{{ review.publish_label ?: '未能读取' }}</span>
        <span class="xedc-ai-status is-{{ review.moderation_key }}">{{ review.moderation_label ?: '未能读取' }}</span>
      </p>
    </div>
    <a class="xedc-seo-back" href="{{ path('xedc_ai.seo') }}">返回列表</a>
  </header>
  {% if review.version_message %}<p class="xedc-seo-note">{{ review.version_message }}</p>{% endif %}
  {% if review.node_url %}<p class="xedc-ai-links"><a href="{{ review.node_url }}">查看内容</a></p>{% endif %}

  <section class="xedc-seo-metrics" aria-label="SEO 综合评分">
    <div>
      <b>{{ score_text }}</b>
      <span>综合评分 · {{ score_grade }}</span>
    </div>
    <div>
      <b>{{ review.issues|length }}</b>
      <span>问题</span>
    </div>
    <div>
      <b>{{ review.counts.pending + review.counts.adopted + review.counts.rejected + review.counts.failed + review.counts.conflict }}</b>
      <span>建议</span>
    </div>
    <div>
      <b>{{ review.counts.pending }}</b>
      <span>待确认</span>
    </div>
  </section>

  <div class="xedc-seo-layout">
    <div class="xedc-seo-main">
      <h2>SEO 问题</h2>
      {% if review.issues %}
        <ul class="xedc-seo-issues">
          {% for item in review.issues %}
            <li>
              <span class="xedc-ai-status is-{{ item.severity }}">{{ item.severity_label }}</span>
              {% if item.field_label %}<strong>{{ item.field_label }}</strong>{% endif %}
              <p>{{ item.message }}</p>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="xedc-seo-empty">没有列出问题。</p>
      {% endif %}

      <h2>优化建议</h2>
      <p class="xedc-seo-muted">待确认 {{ review.counts.pending }} · 已采纳 {{ review.counts.adopted }} · 已忽略 {{ review.counts.rejected }} · 采纳失败 {{ review.counts.failed }} · 版本冲突 {{ review.counts.conflict }}</p>
      {% for item in review.items %}
        {% if not (item.applicable and item.state|default('pending') in ['pending', 'adopted', 'failed']) %}
          <article class="xedc-seo-item">
            <span class="xedc-ai-status is-{{ item.state ?: 'pending' }}">{{ item.state_label ?: '待确认' }}</span>
            <strong>{{ item.label }}</strong>
            <div class="xedc-seo-pair">
              <div><span>当前值</span><p>{{ item.current }}</p></div>
              <div><span>建议值</span><p>{% if item.tag_names %}{{ item.tag_names|join('、') }}{% else %}{{ item.suggested }}{% endif %}</p></div>
            </div>
            {% if item.reason %}<p class="xedc-seo-reason">{{ item.reason }}</p>{% endif %}
          </article>
        {% endif %}
      {% endfor %}
      {% if review.items is empty %}
        <p class="xedc-seo-empty">没有结构化建议。</p>
      {% endif %}
      {% if apply %}{{ apply }}{% endif %}
      {% if review.phase == 'pending' %}<p class="xedc-seo-muted">等待分析，模型尚未调用。</p>{% endif %}
      {% if review.phase == 'failed' %}<p class="xedc-seo-muted">{{ review.summary ?: '分析失败。' }}</p>{% endif %}
      {% if review.phase == 'ready' and review.summary %}<p class="xedc-seo-muted">{{ review.summary }}</p>{% endif %}
    </div>
    <aside class="xedc-seo-side">
      <h2>AI 用量</h2>
      <p><span class="xedc-seo-muted">模型</span><br>{{ review.model ?: '未记录' }}</p>
      <p><span class="xedc-seo-muted">Token</span><br>{{ review.token_label }}</p>
      <p><span class="xedc-seo-muted">费用</span><br>{{ review.cost_label }}</p>
      <p><span class="xedc-seo-muted">分析时间</span><br>{{ review.time }}</p>
    </aside>
  </div>

  <section class="xedc-seo-extra" data-xedc-alt>
    <h2>图片 ALT</h2>
    <p class="xedc-seo-muted">本地检查 · 0 Token。图片 {{ review.alt.total|default(0) }} · 缺失 {{ review.alt.missing|default(0) }} · 异常 {{ review.alt.abnormal|default(0) }}</p>
    <div class="xedc-ai-filters">
      <button type="button" data-xedc-alt-filter="all">全部</button>
      <button type="button" data-xedc-alt-filter="missing">只看缺失</button>
      <button type="button" data-xedc-alt-filter="placeholder">只看异常</button>
    </div>
    {% if review.alt.rows %}
      <table class="xedc-seo-grid">
        <thead><tr><th>图片</th><th>当前 ALT</th><th>结果</th><th>建议 ALT</th></tr></thead>
        <tbody>
        {% for image in review.alt.rows %}
          <tr data-xedc-alt-row data-xedc-alt-status="{{ image.status }}">
            <td data-label="图片">{{ image.label }}</td>
            <td data-label="当前 ALT">{{ image.alt }}</td>
            <td data-label="结果"><span class="xedc-ai-status is-{{ image.status }}">{{ image.status_label }}</span></td>
            <td data-label="建议 ALT">{{ image.candidate }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    {% else %}
      <p class="xedc-seo-empty">这个内容没有读到图片。</p>
    {% endif %}
  </section>

  <details class="xedc-seo-fold">
    <summary>分析依据与记录</summary>
    <p class="xedc-seo-muted">发布时间 {{ review.publish_time ?: '暂无' }} · 分析修订 {{ review.revision_id }} · 当前修订 {{ review.current_revision }}</p>
    {% if review.history %}
      <ul class="xedc-ai-list">
        {% for item in review.history %}
          <li><a href="{{ item.url }}">查看这次分析</a><span>评分 {{ item.score }} · {{ item.time }}</span></li>
        {% endfor %}
      </ul>
    {% endif %}
    {% if review.logs %}
      <ul class="xedc-ai-list">
        {% for log in review.logs %}
          <li><span>{{ log.time }} · {{ log.action }}</span><p>{{ log.message }}</p></li>
        {% endfor %}
      </ul>
    {% endif %}
  </details>
</div>
