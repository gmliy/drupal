{#
/**
 * @file
 * Public creator profile at /r/{slug}.
 *
 * Modern Creator Profile layout — identity first, works as the visual focus.
 * Only public fields from PublicProfileBuilder are rendered here.
 */
#}
<article class="xp">
  <header class="xp-profile">
    <div class="xp-profile__row">
      <div class="xp-avatar" aria-hidden="{{ avatar ? 'false' : 'true' }}">
        {% if avatar %}
          <img src="{{ avatar }}" alt="" width="96" height="96" loading="eager" decoding="async" data-xp-avatar>
        {% else %}
          <svg class="xp-avatar__fallback" viewBox="0 0 96 96" aria-hidden="true" focusable="false">
            <circle cx="48" cy="48" r="48"></circle>
            <circle cx="48" cy="38" r="16"></circle>
            <path d="M18 82c5-16 17-24 30-24s25 8 30 24"></path>
          </svg>
        {% endif %}
      </div>

      <div class="xp-profile__body">
        <div class="xp-profile__headline">
          <div class="xp-id">
            <h1 class="xp-name">{{ name }}</h1>
            {% if slug or username %}
              <p class="xp-handle">
                {% if slug %}<span class="xp-handle__slug">@{{ slug }}</span>{% endif %}
                {% if slug and username and username != name and username != slug %}
                  <span class="xp-handle__sep" aria-hidden="true">·</span>
                {% endif %}
                {% if username and username != name and username != slug %}
                  <span class="xp-handle__user">{{ username }}</span>
                {% endif %}
              </p>
            {% endif %}
          </div>
          <button type="button" class="xp-share" data-xp-share="{{ share_url }}" data-xp-title="{{ name }}" aria-label="{{ '分享主页'|t }}">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M14 5.5a3.5 3.5 0 1 1 .9 2.3L9.7 11a3.5 3.5 0 0 1 0 2l5.2 3.2a3.5 3.5 0 1 1-.8 1.6L8.7 14.4a3.5 3.5 0 0 1 0-4.8l5.4-3.4A3.5 3.5 0 0 1 14 5.5Z"></path>
            </svg>
            <span>{{ '分享'|t }}</span>
          </button>
        </div>

        {% if bio %}
          <p class="xp-bio">{{ bio|nl2br }}</p>
        {% endif %}

        <p class="xp-joined">{{ '加入于 @date'|t({'@date': joined}) }}</p>

        {% if stats %}
          <div class="xp-stats" role="list">
            {% for stat in stats %}
              <a class="xp-stat" href="{{ stat.url }}" role="listitem">
                <strong>{{ stat.count }}</strong>
                <span>{{ stat.label }}</span>
              </a>
            {% endfor %}
          </div>
        {% endif %}

        {% if profile_actions %}
          <div class="xp-actions-wrap">{{ profile_actions }}</div>
        {% endif %}
      </div>
    </div>
  </header>

  <div class="xp-works">
    <div class="xp-toolbar">
      <nav class="xp-filters" aria-label="{{ '作品分类'|t }}">
        {% for filter in filters %}
          <a class="xp-filter{{ filter.active ? ' is-active' }}" href="{{ filter.url }}"{% if filter.active %} aria-current="page"{% endif %}>
            <span class="xp-filter__label">{{ filter.label }}</span>
            <span class="xp-filter__count">{{ filter.count }}</span>
          </a>
        {% endfor %}
      </nav>
      <div class="xp-sorts" role="group" aria-label="{{ '排序'|t }}">
        {% for sort in sorts %}
          <a class="xp-sort{{ sort.active ? ' is-active' }}" href="{{ sort.url }}"{% if sort.active %} aria-current="true"{% endif %}>{{ sort.label }}</a>
        {% endfor %}
      </div>
    </div>

    {% if cards %}
      <div class="xp-grid">
        {% for card in cards %}
          <article class="xp-card xp-card--{{ card.type }}">
            {% if card.type == 'article' %}
              <div class="xp-card__article">
                {% if card.cover %}
                  <a class="xp-card__thumb" href="{{ card.url }}" tabindex="-1" aria-hidden="true">
                    <img src="{{ card.cover }}" alt=""{% if card.width %} width="{{ card.width }}"{% endif %}{% if card.height %} height="{{ card.height }}"{% endif %}{% if card.srcset %} srcset="{{ card.srcset }}" sizes="(max-width: 767px) 40vw, 180px"{% endif %} loading="lazy" decoding="async" data-xp-cover>
                  </a>
                {% endif %}
                <div class="xp-card__copy">
                  <h2 class="xp-card__title"><a href="{{ card.url }}">{{ card.title }}</a></h2>
                  {% if card.summary %}
                    <p class="xp-card__summary">{{ card.summary }}</p>
                  {% endif %}
                  {% if card.date %}
                    <p class="xp-card__date">{{ card.date }}</p>
                  {% endif %}
                </div>
              </div>
            {% else %}
              <a class="xp-card__media" href="{{ card.url }}">
                {% if card.cover %}
                  <img src="{{ card.cover }}" alt="{{ card.title }}"{% if card.width %} width="{{ card.width }}"{% endif %}{% if card.height %} height="{{ card.height }}"{% endif %}{% if card.srcset %} srcset="{{ card.srcset }}" sizes="(max-width: 767px) 50vw, (max-width: 1023px) 33vw, 25vw"{% endif %} loading="lazy" decoding="async" data-xp-cover>
                {% else %}
                  <span class="xp-card__placeholder" aria-hidden="true"></span>
                {% endif %}
                {% if card.type == 'video' %}
                  <span class="xp-play" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false"><path d="M8 5.5v13l11-6.5-11-6.5Z"></path></svg>
                  </span>
                {% endif %}
                {% if card.duration %}
                  <span class="xp-badge">{{ card.duration }}</span>
                {% elseif card.image_count > 1 %}
                  <span class="xp-badge">{{ '@count 张'|t({'@count': card.image_count}) }}</span>
                {% endif %}
              </a>
              <h2 class="xp-card__title"><a href="{{ card.url }}">{{ card.title }}</a></h2>
              {% if card.date and card.type != 'video' %}
                <p class="xp-card__date">{{ card.date }}</p>
              {% endif %}
            {% endif %}
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="xp-empty">
        <p>{{ empty }}</p>
        {% if offer_submission %}
          {{ owner_link }}
        {% endif %}
      </div>
    {% endif %}

    {% if pager %}
      <nav class="xp-pager" aria-label="{{ '分页'|t }}">
        {% if pager.prev %}
          <a class="xp-pager__btn" href="{{ pager.prev }}" rel="prev">{{ '上一页'|t }}</a>
        {% else %}
          <span class="xp-pager__btn is-disabled">{{ '上一页'|t }}</span>
        {% endif %}
        <span class="xp-pager__nums">
          {% for item in pager.items %}
            {% if item.gap %}
              <span class="xp-pager__gap">…</span>
            {% else %}
              <a class="xp-pager__num{{ item.active ? ' is-active' }}" href="{{ item.url }}"{% if item.active %} aria-current="page"{% endif %}>{{ item.n }}</a>
            {% endif %}
          {% endfor %}
        </span>
        <span class="xp-pager__info">{{ pager.current }} / {{ pager.last }}</span>
        {% if pager.next %}
          <a class="xp-pager__btn" href="{{ pager.next }}" rel="next">{{ '下一页'|t }}</a>
        {% else %}
          <span class="xp-pager__btn is-disabled">{{ '下一页'|t }}</span>
        {% endif %}
      </nav>
    {% endif %}
  </div>

  <div class="xp-toast" data-xp-toast hidden></div>
</article>
