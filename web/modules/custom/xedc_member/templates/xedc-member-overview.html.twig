<header class="xm-head">
  <div>
    <h1 class="xm-title">{{ '会员中心'|t }}</h1>
    <p class="xm-sub">{{ '欢迎回来，@name'|t({'@name': account.name}) }}</p>
  </div>
  <a class="xm-btn xm-btn--primary" href="{{ urls.profile }}">{{ '编辑资料'|t }}</a>
</header>

<div class="xm-stats">
  <a class="xm-stat" href="{{ urls.favorites }}">
    <span class="xm-stat__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 4.5h10a1 1 0 0 1 1 1V20l-6-3.2L6 20V5.5a1 1 0 0 1 1-1z"></path></svg></span>
    <b>{{ stats.favorites }}</b>
    <span>{{ '我的收藏'|t }}</span>
  </a>
  <a class="xm-stat" href="{{ urls.likes }}">
    <span class="xm-stat__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 19.2s-6.2-3.7-6.2-8.1A3.4 3.4 0 0 1 12 8.6a3.4 3.4 0 0 1 6.2 2.5c0 4.4-6.2 8.1-6.2 8.1z"></path></svg></span>
    <b>{{ stats.likes }}</b>
    <span>{{ '我的点赞'|t }}</span>
  </a>
  <a class="xm-stat" href="{{ urls.downloads }}">
    <span class="xm-stat__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 4.5v10"></path><path d="m8 11 4 4 4-4"></path><path d="M5 19.5h14"></path></svg></span>
    <b>{{ stats.downloads }}</b>
    <span>{{ '我的下载'|t }}</span>
  </a>
  <a class="xm-stat" href="{{ urls.membership }}">
    <span class="xm-stat__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3.8 14.4 9l5.6.5-4.3 3.6 1.3 5.4L12 15.8 6.9 18.5 8.2 13 4 9.5 9.6 9z"></path></svg></span>
    <b>{{ account.tier == 'vip' ? 'VIP' : '普通' }}</b>
    <span>{{ '会员等级'|t }}</span>
  </a>
  <a class="xm-stat" href="{{ urls.comments }}">
    <span class="xm-stat__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 6.5h12a1.5 1.5 0 0 1 1.5 1.5v7A1.5 1.5 0 0 1 18 16.5H10l-4 3v-3H6A1.5 1.5 0 0 1 4.5 15V8A1.5 1.5 0 0 1 6 6.5z"></path></svg></span>
    <b>{{ stats.comments }}</b>
    <span>{{ '我的评论'|t }}</span>
  </a>
  <a class="xm-stat" href="{{ urls.submissions }}">
    <span class="xm-stat__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 4.5h8l4 4V19a1.5 1.5 0 0 1-1.5 1.5h-10.5A1.5 1.5 0 0 1 4.5 19V6A1.5 1.5 0 0 1 6 4.5z"></path><path d="M14 4.5V9h4.5"></path></svg></span>
    <b>{{ stats.submissions }}</b>
    <span>{{ '我的投稿'|t }}</span>
  </a>
  <a class="xm-stat" href="{{ urls.history }}">
    <span class="xm-stat__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"></circle><path d="M12 8v4.2l2.8 1.8"></path></svg></span>
    <b>{{ stats.history }}</b>
    <span>{{ '浏览历史'|t }}</span>
  </a>
</div>

<section class="xm-panel">
  <div class="xm-panel__head">
    <h2>{{ '最近收藏'|t }}</h2>
    <a href="{{ urls.favorites }}">{{ '查看全部'|t }}</a>
  </div>

  {% if recent_favorites %}
    <div class="xm-grid">
      {% for card in recent_favorites %}
        {% include '@xedc_member/templates/xedc-member-card.html.twig' with {card: card} %}
      {% endfor %}
    </div>
  {% else %}
    <div class="xm-empty">
      <strong>{{ '还没有收藏'|t }}</strong>
      <p>{{ '打开美图、视频或文章，点一下收藏就会出现在这里。'|t }}</p>
      <div class="xm-empty__links">
        <a href="{{ path('view.image_gallery.page_1') }}">{{ '看看美图'|t }}</a>
        <a href="{{ path('view.video_list.page_1') }}">{{ '看看视频'|t }}</a>
        <a href="{{ path('view.article_list.page_1') }}">{{ '看看文章'|t }}</a>
      </div>
    </div>
  {% endif %}
</section>
