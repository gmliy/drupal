<section class="xm-welcome">
  <div class="xm-welcome__identity">
    <span class="xm-welcome__avatar" aria-hidden="true">
      {% if avatar %}{{ avatar }}{% else %}{{ account.initial }}{% endif %}
    </span>
    <div class="xm-welcome__text">
      <p class="xm-welcome__eyebrow">{{ '会员中心'|t }}</p>
      <h1 class="xm-title xm-welcome__title">{{ '你好，@name'|t({'@name': account.name}) }}</h1>
      <p class="xm-sub xm-welcome__meta">
        <span>{{ '加入于 @date'|t({'@date': account.member_since}) }}</span>
        <span aria-hidden="true">·</span>
        <span>{{ '最近登录 @date'|t({'@date': account.last_login}) }}</span>
      </p>
    </div>
  </div>
  <div class="xm-welcome__actions">
    <a class="xm-btn xm-btn--primary" href="{{ urls.profile }}">{{ '编辑资料'|t }}</a>
    <a class="xm-btn" href="{{ urls.submissions }}">{{ '我的投稿'|t }}</a>
  </div>
</section>

<section class="xm-vip-strip{% if membership.active %} is-active{% endif %}{% if membership.expiring_soon %} is-warn{% endif %}" aria-label="{{ '会员状态'|t }}">
  <div class="xm-vip-strip__main">
    {% if membership.active %}
      <em class="xm-tier xm-tier--vip">VIP</em>
      <div>
        <strong>{{ membership.label }}</strong>
        <p>{{ '有效期至 @date · 剩余 @count 天'|t({'@date': membership.expires, '@count': membership.remaining}) }}</p>
      </div>
    {% elseif membership.expired %}
      <em class="xm-tier">{{ '普通会员'|t }}</em>
      <div>
        <strong>{{ 'VIP 已到期'|t }}</strong>
        <p>{{ '已于 @date 到期，当前按普通会员权限使用。'|t({'@date': membership.expires}) }}</p>
      </div>
    {% else %}
      <em class="xm-tier">{{ '普通会员'|t }}</em>
      <div>
        <strong>{{ membership.label }}</strong>
        <p>{{ 'VIP 由管理员开通或卡密兑换，这里不能在线支付。'|t }}</p>
      </div>
    {% endif %}
  </div>
  <div class="xm-vip-strip__actions">
    <a class="xm-btn" href="{{ urls.membership }}">{{ '查看权益'|t }}</a>
    {% if urls.redeem %}
      <a class="xm-btn xm-btn--primary" href="{{ urls.redeem }}">{{ '卡密兑换'|t }}</a>
    {% endif %}
  </div>
</section>

<div class="xm-stats xm-stats--compact" aria-label="{{ '数据概览'|t }}">
  <a class="xm-stat" href="{{ urls.favorites }}">
    <b>{{ stats.favorites }}</b>
    <span>{{ '收藏'|t }}</span>
  </a>
  <a class="xm-stat" href="{{ urls.likes }}">
    <b>{{ stats.likes }}</b>
    <span>{{ '点赞'|t }}</span>
  </a>
  <a class="xm-stat" href="{{ urls.downloads }}">
    <b>{{ stats.downloads }}</b>
    <span>{{ '下载'|t }}</span>
  </a>
  <a class="xm-stat" href="{{ urls.submissions }}">
    <b>{{ stats.submissions }}</b>
    <span>{{ '投稿'|t }}</span>
  </a>
</div>

<section class="xm-section xm-shortcuts">
  <div class="xm-section__head">
    <h2>{{ '常用入口'|t }}</h2>
  </div>
  <div class="xm-shortcut-grid">
    <a class="xm-shortcut" href="{{ urls.history }}">
      <span class="xm-shortcut__label">{{ '浏览历史'|t }}</span>
      <span class="xm-shortcut__meta">{{ '@count 条'|t({'@count': stats.history}) }}</span>
    </a>
    <a class="xm-shortcut" href="{{ urls.comments }}">
      <span class="xm-shortcut__label">{{ '我的评论'|t }}</span>
      <span class="xm-shortcut__meta">{{ '@count 条'|t({'@count': stats.comments}) }}</span>
    </a>
    <a class="xm-shortcut" href="{{ urls.messages }}">
      <span class="xm-shortcut__label">{{ '私信'|t }}</span>
      <span class="xm-shortcut__meta">{{ '会话列表'|t }}</span>
    </a>
    <a class="xm-shortcut" href="{{ urls.notifications }}">
      <span class="xm-shortcut__label">{{ '通知'|t }}</span>
      <span class="xm-shortcut__meta">{{ '站内提醒'|t }}</span>
    </a>
    <a class="xm-shortcut" href="{{ urls.security }}">
      <span class="xm-shortcut__label">{{ '账号安全'|t }}</span>
      <span class="xm-shortcut__meta">{{ '邮箱与密码'|t }}</span>
    </a>
    <a class="xm-shortcut" href="{{ urls.profile }}">
      <span class="xm-shortcut__label">{{ '个人资料'|t }}</span>
      <span class="xm-shortcut__meta">{{ '头像与主页'|t }}</span>
    </a>
  </div>
</section>

<section class="xm-section">
  <div class="xm-section__head">
    <h2>{{ '最近收藏'|t }}</h2>
    <a href="{{ urls.favorites }}">{{ '查看全部'|t }}</a>
  </div>

  {% if recent_favorites %}
    <div class="xm-grid">
      {% for card in recent_favorites %}
        {% include '@xedc_member/templates/xedc-member-card.html.twig' with {card: card} %}
      {% endfor %}
    </div>
  {% else %}
    <div class="xm-empty xm-empty--inset">
      <strong>{{ '还没有收藏'|t }}</strong>
      <p>{{ '打开美图、视频或文章，点一下收藏就会出现在这里。'|t }}</p>
      <div class="xm-empty__links">
        <a href="{{ path('view.image_gallery.page_1') }}">{{ '看看美图'|t }}</a>
        <a href="{{ path('view.video_list.page_1') }}">{{ '看看视频'|t }}</a>
        <a href="{{ path('view.article_list.page_1') }}">{{ '看看文章'|t }}</a>
      </div>
    </div>
  {% endif %}
</section>
