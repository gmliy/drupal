      'task_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'op' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
      'success' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'error' => ['type' => 'text', 'not null' => FALSE],
      'detail' => ['type' => 'text', 'size' => 'big', 'not null' => FALSE],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'task_id' => ['task_id'],
      'created' => ['created'],
      'op' => ['op'],
    ],
  ];

  $variant = [
    'description' => 'WebP and AVIF copies recorded for a managed file. The original file is not replaced.',
    'fields' => [
      'fid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'variant' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => ''],
      'uri' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE, 'default' => ''],
      'sha256' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
      'bytes' => ['type' => 'int', 'size' => 'big', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'mime' => ['type' => 'varchar', 'length' => 128, 'not null' => TRUE, 'default' => ''],
      'status' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => ''],
      'message' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE, 'default' => ''],
    ],
    'primary key' => ['fid', 'variant'],
  ];
  $downloadLog = [
    'description' => 'Member download decisions. A row does not grant access by itself.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'fid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'tier' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => ''],
      'result' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => ''],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'uid_created' => ['uid', 'created'],
      'fid' => ['fid'],
    ],
  ];
  $migrationItem = [
    'description' => 'Inventory and copy status for one storage migration task. File URIs are not rewritten here.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'task_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
      'fid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'source_uri' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE, 'default' => ''],
      'scheme' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => ''],
      'kind' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => ''],
      'bytes' => ['type' => 'int', 'size' => 'big', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'object_key' => ['type' => 'varchar', 'length' => 512, 'not null' => TRUE, 'default' => ''],
      'sha256' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
      'remote_sha256' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
      'status' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => 'pending'],
      'message' => ['type' => 'text', 'not null' => FALSE],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'changed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'task_status' => ['task_id', 'status'],
      'fid' => ['fid'],
    ],
  ];

  $optimize = [
    'description' => 'Audit rows for newly optimized public images.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'fid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'filename' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE, 'default' => ''],
      'source_mime' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
      'stored_mime' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
      'source_bytes' => ['type' => 'int', 'size' => 'big', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'stored_bytes' => ['type' => 'int', 'size' => 'big', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'source_sha256' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
      'stored_sha256' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
      'width' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'height' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'elapsed_ms' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'memory_bytes' => ['type' => 'int', 'size' => 'big', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'status' => ['type' => 'varchar', 'length' => 16, 'not null' => TRUE, 'default' => 'queued'],
      'r2_status' => ['type' => 'varchar', 'length' => 16, 'not null' => TRUE, 'default' => ''],
      'error' => ['type' => 'text', 'not null' => FALSE],
      'attempts' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'changed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'fid' => ['fid'],
      'status' => ['status'],
    ],
  ];

  return [
    'xedc_import_task' => $task,
    'xedc_import_item' => $item,
    'xedc_import_log' => $log,
    'xedc_image_alt' => $alt,
    'xedc_image_file' => $file,
    'xedc_image_optimize' => $optimize,
    'xedc_file_batch' => $batch,
    'xedc_file_hash_work' => $work,
    'xedc_file_dup_group' => $group,
    'xedc_file_dup_member' => $member,
    'xedc_file_ref' => $ref,
    'xedc_file_finding' => $finding,
    'xedc_file_cleanup_task' => $cleanupTask,
    'xedc_file_cleanup_item' => $cleanupItem,
    'xedc_file_cleanup_log' => $cleanupLog,
    'xedc_storage_variant' => $variant,
    'xedc_storage_download_log' => $downloadLog,
    'xedc_storage_migration_item' => $migrationItem,
  ] + \Drupal\xedc_core\Engagement\EngagementSchema::tables()
    + \Drupal\xedc_core\Ops\Traffic\TrafficSchema::tables()
    + ['xedc_video_transcode' => \Drupal\xedc_core\Video\TranscodeSchema::table()]
    + \Drupal\xedc_core\Upload\UploadSchema::tables();
}

/**
 * Implements hook_install().
 */
function xedc_core_install(): void {
  $filesystem = \Drupal::service('file_system');
  foreach (['private://xedc-import/inbox', 'private://xedc-import/tasks', 'private://xedc-upload', 'private://xedc-downloads', 'private://xedc-zips', 'private://xedc-download-tmp'] as $directory) {
    try {
      $filesystem->prepareDirectory($directory, FileSystemInterface::CREATE_DIRECTORY | FileSystemInterface::MODIFY_PERMISSIONS);
    }
    catch (\Throwable $e) {
      \Drupal::logger('xedc_core')->error('无法创建私有导入目录 @dir：@message', [
        '@dir' => $directory,
        '@message' => $e->getMessage(),
      ]);
    }
  }

  $grants = [
    'content_editor' => [
      'administer xedc image imports',
      'import photo archives',
      'publish xedc image imports',
    ],
    'authenticated' => [
      'import photo archives',
    ],
  ];
  foreach ($grants as $rid => $permissions) {
    $role = Role::load($rid);
    if (!$role) {
      continue;
    }
    foreach ($permissions as $permission) {
      $role->grantPermission($permission);
    }
    $role->save();
  }
}

/**
 * Allows nested and non-ASCII archive paths to be stored.
 */
function xedc_core_update_10001(): void {
  $field = [
    'type' => 'varchar',
    'length' => 2048,
    'not null' => TRUE,
    'default' => '',
  ];
  \Drupal::database()->schema()->changeField('xedc_import_item', 'temp_uri', 'temp_uri', $field);
}

/**
 * Stores source and official SHA-256 fingerprints on files and import items.
 */
function xedc_core_update_10002(): void {
  $schema = \Drupal::database()->schema();
  $hash = [
    'type' => 'varchar',
    'length' => 64,
    'not null' => TRUE,
    'default' => '',
  ];
  $flag = [
    'type' => 'int',
    'unsigned' => TRUE,
    'not null' => TRUE,
    'default' => 0,
  ];
  $add = static function (string $table, string $field, array $spec) use ($schema): void {
    if (!$schema->fieldExists($table, $field)) {
      $schema->addField($table, $field, $spec);
    }
  };
  $add('xedc_image_file', 'source_sha256', $hash);
  $add('xedc_image_file', 'stored_sha256', $hash);
  $add('xedc_import_item', 'source_sha256', $hash);
  $add('xedc_import_item', 'stored_sha256', $hash);
  $add('xedc_import_item', 'reused', $flag);
  $add('xedc_import_item', 'attempts', $flag);
  foreach (['source_sha256', 'stored_sha256'] as $name) {
    if (!$schema->indexExists('xedc_image_file', $name)) {
      $schema->addIndex('xedc_image_file', $name, [$name], [
        'fields' => [$name => $hash],
      ]);
    }
  }
}

/**
 * Stores local monitor and file-scan defaults.
 */
function xedc_core_update_10003(): void {
  $config = \Drupal::configFactory()->getEditable('xedc_core.settings');
  $defaults = [
    'netdata_base_url' => 'http://127.0.0.1:19999',
    'file_scan_batch' => 250,
    'file_scan_seconds' => 6,
    'file_large_bytes' => 104857600,
    'file_huge_bytes' => 524288000,
    'file_stale_days' => 180,
    'file_top_files' => 100,
    'file_top_dirs' => 50,
  ];
  foreach ($defaults as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
    }
  }
  $config->save();
}

/**
 * Adds file analysis tables and cleanup defaults. Does not scan or delete.
 */
function xedc_core_update_10004(): void {
  $schema = \Drupal::database()->schema();
  $spec = xedc_core_schema();
  foreach ([
    'xedc_file_batch',
    'xedc_file_hash_work',
    'xedc_file_dup_group',
    'xedc_file_dup_member',
    'xedc_file_ref',
    'xedc_file_finding',
    'xedc_file_cleanup_task',
    'xedc_file_cleanup_item',
    'xedc_file_cleanup_log',
  ] as $table) {
    if (!$schema->tableExists($table)) {
      $schema->createTable($table, $spec[$table]);
    }
  }
  $config = \Drupal::configFactory()->getEditable('xedc_core.settings');
  $defaults = [
    'file_analysis_auto' => 1,
    'file_analysis_interval' => 86400,
    'file_analysis_batch' => 40,
    'file_analysis_seconds' => 4,
    'file_analysis_suggest' => 1,
    'file_hash_max_bytes' => 67108864,
    'file_quarantine_days' => 14,
  ];
  foreach ($defaults as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
    }
  }
  $config->save();
  try {
    $directory = 'private://xedc-quarantine';
    \Drupal::service('file_system')->prepareDirectory($directory, FileSystemInterface::CREATE_DIRECTORY | FileSystemInterface::MODIFY_PERMISSIONS);
  }
  catch (\Throwable $e) {
    \Drupal::logger('xedc_core')->error('无法创建隔离目录：@message', ['@message' => $e->getMessage()]);
  }
}

/**
 * Installs non-secret object storage defaults. Does not enable remote storage.
 */
function xedc_core_update_10005(): string {
  $config = \Drupal::configFactory()->getEditable('xedc_core.storage');
  if (!$config->isNew() && is_array($config->get('policy'))) {
    return '对象存储配置已存在，未覆盖。';
  }
  $config->setData(\Drupal\xedc_core\Ops\Storage\StorageConfig::defaults());
  $config->save();
  return '已写入对象存储默认配置。远程存储保持关闭。';
}

/**
 * Adds VIP, likes, shares, download history and the download resource entity.
 */
function xedc_core_update_10006(): string {
  $schema = \Drupal::database()->schema();
  foreach (\Drupal\xedc_core\Engagement\EngagementSchema::tables() as $name => $table) {
    if (!$schema->tableExists($name)) {
      $schema->createTable($name, $table);
    }
  }
  if (!Role::load('vip')) {
    Role::create([
      'id' => 'vip',
      'label' => 'VIP 会员',
      'is_admin' => FALSE,
      'permissions' => [],
    ])->save();
  }
  \Drupal::entityTypeManager()->clearCachedDefinitions();
  if (!$schema->tableExists('xedc_download')) {
    $definition = \Drupal::entityTypeManager()->getDefinition('xedc_download');
    \Drupal::entityDefinitionUpdateManager()->installEntityType($definition);
  }
  $filesystem = \Drupal::service('file_system');
  foreach (['private://xedc-downloads', 'private://xedc-zips', 'private://xedc-download-tmp'] as $directory) {
    $filesystem->prepareDirectory($directory, FileSystemInterface::CREATE_DIRECTORY | FileSystemInterface::MODIFY_PERMISSIONS);
  }
  return '已安装会员互动、VIP 和下载资源数据结构。';
}

/**
 * Adds object-storage bookkeeping tables. Does not copy or delete files.
 */
function xedc_core_update_10007(): string {
  $schema = \Drupal::database()->schema();
  $spec = xedc_core_schema();
  $created = [];
  foreach (['xedc_storage_variant', 'xedc_storage_download_log', 'xedc_storage_migration_item'] as $table) {
    if (!$schema->tableExists($table)) {
      $schema->createTable($table, $spec[$table]);
      $created[] = $table;
    }
  }
  return $created === [] ? '对象存储记录表已存在，未改动。' : '已创建：' . implode('、', $created) . '。没有复制或删除文件。';
}

/**
 * Adds like status, download detail and ZIP job state. Does not delete rows.
 */
function xedc_core_update_10008(): string {
  $schema = \Drupal::database()->schema();
  $database = \Drupal::database();
  if ($schema->tableExists('xedc_like') && !$schema->fieldExists('xedc_like', 'status')) {
    $schema->addField('xedc_like', 'status', [
      'type' => 'int',
      'size' => 'tiny',
      'unsigned' => TRUE,
      'not null' => TRUE,
      'default' => 1,
    ]);
  }
  if ($schema->tableExists('xedc_like') && !$schema->fieldExists('xedc_like', 'changed')) {
    $schema->addField('xedc_like', 'changed', [
      'type' => 'int',
      'unsigned' => TRUE,
      'not null' => TRUE,
      'default' => 0,
    ]);
    $database->update('xedc_like')->expression('changed', 'created')->execute();
  }
  foreach ([
    'source' => 16,
    'tier' => 16,
    'delivery' => 16,
    'detail' => 255,
  ] as $field => $length) {
    if ($schema->tableExists('xedc_download_log') && !$schema->fieldExists('xedc_download_log', $field)) {
      $schema->addField('xedc_download_log', $field, [
        'type' => 'varchar',
        'length' => $length,
        'not null' => TRUE,
        'default' => '',
      ]);
    }
  }
  $tables = \Drupal\xedc_core\Engagement\EngagementSchema::tables();
  if (!$schema->tableExists('xedc_zip_job')) {
    $schema->createTable('xedc_zip_job', $tables['xedc_zip_job']);
  }
  $filesystem = \Drupal::service('file_system');
  foreach (['private://xedc-downloads', 'private://xedc-zips', 'private://xedc-download-tmp'] as $directory) {
    $filesystem->prepareDirectory($directory, \Drupal\Core\File\FileSystemInterface::CREATE_DIRECTORY | \Drupal\Core\File\FileSystemInterface::MODIFY_PERMISSIONS);
    $real = $filesystem->realpath($directory);
    if (is_string($real)) {
      @chmod($real, 0775);
      if (function_exists('posix_getpwnam')) {
        $user = posix_getpwnam('www-data');
        if (is_array($user) && function_exists('posix_geteuid') && posix_geteuid() === 0) {
          @chown($real, (string) $user['name']);
          @chgrp($real, (string) $user['name']);
        }
      }
    }
  }
  return '已补充点赞状态、下载明细和 ZIP 任务记录。原有记录已保留。';
}

/**
 * Adds physical NIC traffic snapshots and daily totals.
 */
function xedc_core_update_10009(): string {
  $schema = \Drupal::database()->schema();
  $created = [];
  foreach (\Drupal\xedc_core\Ops\Traffic\TrafficSchema::tables() as $name => $table) {
    if (!$schema->tableExists($name)) {
      $schema->createTable($name, $table);
      $created[] = $name;
    }
  }
  return $created === [] ? '网络流量统计表已存在，未改动。' : '已创建：' . implode('、', $created) . '。';
}

/**
 * Lets guests like without sharing one uid 0 row. Existing member rows stay.
 */
function xedc_core_update_10010(): string {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('xedc_like')) {
    return '点赞表不存在，未改动。';
  }
  if (!$schema->fieldExists('xedc_like', 'actor_hash')) {
    $schema->addField('xedc_like', 'actor_hash', [
      'type' => 'varchar',
      'length' => 64,
      'not null' => TRUE,
      'default' => '',
    ]);
  }
  if ($schema->indexExists('xedc_like', 'user_entity')) {
    $schema->dropUniqueKey('xedc_like', 'user_entity');
  }
  if (!$schema->indexExists('xedc_like', 'user_actor')) {
    $schema->addUniqueKey('xedc_like', 'user_actor', ['uid', 'actor_hash', 'entity_type', 'entity_id']);
  }
  return '已为点赞表增加游客身份哈希。原有会员点赞记录已保留。';
}

/**
 * Stores one playback-copy job per source file.
 */
function xedc_core_update_10011(): string {
  $schema = \Drupal::database()->schema();
  if ($schema->tableExists('xedc_video_transcode')) {
    return '播放副本任务表已存在，未改动。';
  }
  $schema->createTable('xedc_video_transcode', \Drupal\xedc_core\Video\TranscodeSchema::table());
  return '已创建播放副本任务表。原视频和已有播放副本均未改动。';
}

/**
 * Adds the image optimization audit table. Existing files are not scanned.
 */
function xedc_core_update_10012(): string {
  $schema = \Drupal::database()->schema();
  if ($schema->tableExists('xedc_image_optimize')) {
    return '图片优化记录表已存在，未改动历史文件。';
  }
  $schema->createTable('xedc_image_optimize', xedc_core_schema()['xedc_image_optimize']);
  return '已创建图片优化记录表。历史图片没有批量处理。';
}

/**
 * Adds original-size columns. Existing rows stay at 0, which means unknown.
 */
function xedc_core_update_10013(): string {
  $schema = \Drupal::database()->schema();
  $spec = xedc_core_schema();
  $added = [];
  $map = [
    'xedc_import_task' => ['archive_bytes', 'archive_sha256', 'upload_token'],
    'xedc_import_item' => ['original_bytes'],
    'xedc_image_file' => [
      'original_bytes',
      'original_mime',
      'original_extension',
      'optimized_bytes',
      'optimized_mime',
      'optimized_extension',
      'optimization_status',
      'processed',
    ],
  ];
  foreach ($map as $table => $fields) {
    if (!$schema->tableExists($table) || !isset($spec[$table]['fields'])) {
      continue;
    }
    foreach ($fields as $field) {
      if ($schema->fieldExists($table, $field) || !isset($spec[$table]['fields'][$field])) {
        continue;
      }
      $schema->addField($table, $field, $spec[$table]['fields'][$field]);
      $added[] = $table . '.' . $field;
    }
  }
  if (!$schema->indexExists('xedc_import_task', 'upload_token') && $schema->fieldExists('xedc_import_task', 'upload_token')) {
    $schema->addIndex('xedc_import_task', 'upload_token', ['upload_token'], $spec['xedc_import_task']);
  }
  return $added ? '已增加原图大小字段：' . implode(', ', $added) . '。历史记录保持未知，没有回填。' : '原图大小字段已存在，未改动历史记录。';
}

/**
 * Adds import phase and per-image timings. Existing rows stay at the default.
 */
function xedc_core_update_10014(): string {
  $schema = \Drupal::database()->schema();
  $spec = xedc_core_schema();
  $added = [];
  $map = [
    'xedc_import_task' => ['phase'],
    'xedc_import_item' => ['elapsed_ms', 'optimize_ms', 'store_ms', 'finished'],
  ];
  foreach ($map as $table => $fields) {
    if (!$schema->tableExists($table) || !isset($spec[$table]['fields'])) {
      continue;
    }
    foreach ($fields as $field) {
      if ($schema->fieldExists($table, $field) || !isset($spec[$table]['fields'][$field])) {
        continue;
      }
      $schema->addField($table, $field, $spec[$table]['fields'][$field]);
      $added[] = $table . '.' . $field;
    }
  }
  return $added ? '已增加导入进度字段：' . implode(', ', $added) . '。历史任务没有回填耗时。' : '导入进度字段已存在，未改动历史记录。';
}

/**
 * Adds resumable upload session tables. Existing imports are not changed.
 */
function xedc_core_update_10015(): string {
  $schema = \Drupal::database()->schema();
  $created = [];
  foreach (\Drupal\xedc_core\Upload\UploadSchema::tables() as $name => $table) {
    if ($schema->tableExists($name)) {
      continue;
    }
    $schema->createTable($name, $table);
    $created[] = $name;
  }
  try {
    $directory = 'private://xedc-upload';
    \Drupal::service('file_system')->prepareDirectory($directory, \Drupal\Core\File\FileSystemInterface::CREATE_DIRECTORY | \Drupal\Core\File\FileSystemInterface::MODIFY_PERMISSIONS);
  }
  catch (\Throwable $e) {
    \Drupal::logger('xedc_core')->error('无法创建私有上传目录：@message', ['@message' => $e->getMessage()]);
  }
  return $created ? '已创建断点续传表：' . implode(', ', $created) . '。' : '断点续传表已存在，未改动。';
}

/**
 * Adds the client upload identity and the physical-object claim.
 *
 * Existing files, media and import rows are not rewritten.
 */
function xedc_core_update_10016(): string {
  $schema = \Drupal::database()->schema();
  $tables = \Drupal\xedc_core\Upload\UploadSchema::tables();
  $added = [];
  if ($schema->tableExists('xedc_upload_session')) {
    foreach (['client_upload_id', 'reimport'] as $field) {
      if ($schema->fieldExists('xedc_upload_session', $field) || !isset($tables['xedc_upload_session']['fields'][$field])) {
        continue;
      }
      $schema->addField('xedc_upload_session', $field, $tables['xedc_upload_session']['fields'][$field]);
      $added[] = 'xedc_upload_session.' . $field;
    }
    if (!$schema->indexExists('xedc_upload_session', 'uid_client')) {
      $schema->addIndex('xedc_upload_session', 'uid_client', ['uid', 'client_upload_id'], $tables['xedc_upload_session']);
      $added[] = 'xedc_upload_session.uid_client';
    }
  }
  if (!$schema->tableExists('xedc_blob_claim') && isset($tables['xedc_blob_claim'])) {
    $schema->createTable('xedc_blob_claim', $tables['xedc_blob_claim']);
    $added[] = 'xedc_blob_claim';
  }
  return $added ? '已增加上传去重结构：' . implode(', ', $added) . '。没有改动已有文件。' : '上传去重结构已存在，未改动已有文件。';
}

/**
 * Backfills original_bytes only from verified sources. Never invents sizes.
 *
 * Sources, in order: existing image_file value (skip), optimize.source_bytes,
 * import_item.original_bytes, quick_orig.bytes, identical source/stored hash.
 */
function xedc_core_update_10017(): string {
  $database = \Drupal::database();
  $schema = $database->schema();
  if (!$schema->tableExists('xedc_image_file') || !$schema->fieldExists('xedc_image_file', 'original_bytes')) {
    return '没有原图大小字段，跳过回填。';
  }
  $missing = (int) $database->query('SELECT COUNT(*) FROM {xedc_image_file} WHERE original_bytes = 0')->fetchField();
  $fixed = 0;

  if ($schema->tableExists('xedc_image_optimize')) {
    $rows = $database->query("SELECT f.fid, o.source_bytes
      FROM {xedc_image_file} f
      INNER JOIN {xedc_image_optimize} o ON o.fid = f.fid
      INNER JOIN (
        SELECT fid, MAX(id) AS id FROM {xedc_image_optimize}
        WHERE status = 'success' AND source_bytes > 0 GROUP BY fid
      ) latest ON latest.id = o.id
      WHERE f.original_bytes = 0 AND o.source_bytes > 0")->fetchAll();
    foreach ($rows as $row) {
      $fixed += (int) $database->update('xedc_image_file')
        ->fields(['original_bytes' => (int) $row->source_bytes])
        ->condition('fid', (int) $row->fid)
        ->condition('original_bytes', 0)
        ->execute();
    }
  }

  if ($schema->tableExists('xedc_import_item') && $schema->fieldExists('xedc_import_item', 'original_bytes') && $schema->tableExists('media__field_media_image')) {
    $rows = $database->query("SELECT f.fid, MAX(i.original_bytes) AS original_bytes
      FROM {xedc_image_file} f
      INNER JOIN {media__field_media_image} m ON m.field_media_image_target_id = f.fid
      INNER JOIN {xedc_import_item} i ON i.mid = m.entity_id AND i.original_bytes > 0 AND i.mid > 0
      WHERE f.original_bytes = 0
      GROUP BY f.fid")->fetchAll();
    foreach ($rows as $row) {
      $fixed += (int) $database->update('xedc_image_file')
        ->fields(['original_bytes' => (int) $row->original_bytes])
        ->condition('fid', (int) $row->fid)
        ->condition('original_bytes', 0)
        ->execute();
    }
  }

  if ($schema->tableExists('xedc_quick_orig') && $schema->tableExists('media__field_media_image')) {
    $rows = $database->query("SELECT f.fid, MAX(q.bytes) AS bytes
      FROM {xedc_image_file} f
      INNER JOIN {media__field_media_image} m ON m.field_media_image_target_id = f.fid
      INNER JOIN {xedc_quick_orig} q ON q.mid = m.entity_id AND q.bytes > 0
      WHERE f.original_bytes = 0
      GROUP BY f.fid")->fetchAll();
    foreach ($rows as $row) {
      $fixed += (int) $database->update('xedc_image_file')
        ->fields(['original_bytes' => (int) $row->bytes])
        ->condition('fid', (int) $row->fid)
        ->condition('original_bytes', 0)
        ->execute();
    }
  }

  $rows = $database->query("SELECT fid, bytes FROM {xedc_image_file}
    WHERE original_bytes = 0
      AND bytes > 0
      AND source_sha256 <> ''
      AND stored_sha256 <> ''
      AND source_sha256 = stored_sha256")->fetchAll();
  foreach ($rows as $row) {
    $fields = ['original_bytes' => (int) $row->bytes];
    $current = $database->select('xedc_image_file', 'f')
      ->fields('f', ['optimized_bytes', 'optimization_status'])
      ->condition('fid', (int) $row->fid)
      ->execute()
      ->fetchAssoc();
    if (is_array($current) && (int) ($current['optimized_bytes'] ?? 0) < 1) {
      $fields['optimized_bytes'] = (int) $row->bytes;
    }
    if (is_array($current) && ($current['optimization_status'] ?? '') === '') {
      $fields['optimization_status'] = 'success';
    }
    $fixed += (int) $database->update('xedc_image_file')
      ->fields($fields)
      ->condition('fid', (int) $row->fid)
      ->condition('original_bytes', 0)
      ->execute();
  }

  $still = (int) $database->query('SELECT COUNT(*) FROM {xedc_image_file} WHERE original_bytes = 0')->fetchField();
  return '原图大小回填：开始缺失 ' . $missing . '，本次可靠恢复 ' . $fixed . '，仍缺失 ' . $still . '。没有伪造大小。';
}

/**
 * Adds upload-session cleanup status for cancelled temp files.
 *
 * Existing sessions keep cleanup_status=none. No historical files are deleted.
 */
function xedc_core_update_10018(): string {
  $schema = \Drupal::database()->schema();
  $tables = \Drupal\xedc_core\Upload\UploadSchema::tables();
  if (!$schema->tableExists('xedc_upload_session') || !isset($tables['xedc_upload_session'])) {
    return '没有上传会话表，跳过清理状态字段。';
  }
  $added = [];
  foreach (['cleanup_status', 'cleanup_error'] as $field) {
    if ($schema->fieldExists('xedc_upload_session', $field) || !isset($tables['xedc_upload_session']['fields'][$field])) {
      continue;
    }
    $schema->addField('xedc_upload_session', $field, $tables['xedc_upload_session']['fields'][$field]);
    $added[] = 'xedc_upload_session.' . $field;
  }
  if (!$schema->indexExists('xedc_upload_session', 'cleanup') && isset($tables['xedc_upload_session']['indexes']['cleanup'])) {
    $schema->addIndex('xedc_upload_session', 'cleanup', ['status', 'cleanup_status'], $tables['xedc_upload_session']);
    $added[] = 'xedc_upload_session.cleanup';
  }
  return $added ? '已增加上传清理状态：' . implode(', ', $added) . '。历史会话未改写。' : '上传清理状态字段已存在，未改动。';
}

/**
 * Creates VIP redeem code tables and grants redeem permission.
 */
function xedc_core_update_10019(): string {
  $schema = \Drupal::database()->schema();
  $tables = \Drupal\xedc_core\Engagement\EngagementSchema::tables();
  $created = [];
  foreach (['xedc_vip_code_batch', 'xedc_vip_code'] as $name) {
    if (!$schema->tableExists($name) && isset($tables[$name])) {
      $schema->createTable($name, $tables[$name]);
      $created[] = $name;
    }
  }
  $role = \Drupal\user\Entity\Role::load('authenticated');
  if ($role && !$role->hasPermission('redeem xedc vip codes')) {
    $role->grantPermission('redeem xedc vip codes');
    $role->save();
    $created[] = 'permission:redeem xedc vip codes';
  }
  $admin = \Drupal\user\Entity\Role::load('administrator');
  if ($admin && !$admin->hasPermission('administer xedc vip codes')) {
    $admin->grantPermission('administer xedc vip codes');
    $admin->save();
    $created[] = 'permission:administer xedc vip codes';
  }
  return $created
    ? 'VIP 卡密：' . implode(', ', $created)
    : 'VIP 卡密表与权限已存在，未改动。';
}
