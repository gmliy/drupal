    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'fid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'tier' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => ''],
      'result' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => ''],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'uid_created' => ['uid', 'created'],
      'fid' => ['fid'],
    ],
  ];
  $migrationItem = [
    'description' => 'Inventory and copy status for one storage migration task. File URIs are not rewritten here.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'task_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
      'fid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'source_uri' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE, 'default' => ''],
      'scheme' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => ''],
      'kind' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => ''],
      'bytes' => ['type' => 'int', 'size' => 'big', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'object_key' => ['type' => 'varchar', 'length' => 512, 'not null' => TRUE, 'default' => ''],
      'sha256' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
      'remote_sha256' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
      'status' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => 'pending'],
      'message' => ['type' => 'text', 'not null' => FALSE],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'changed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'task_status' => ['task_id', 'status'],
      'fid' => ['fid'],
    ],
  ];

  $optimize = [
    'description' => 'Audit rows for newly optimized public images.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'fid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'filename' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE, 'default' => ''],
      'source_mime' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
      'stored_mime' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
      'source_bytes' => ['type' => 'int', 'size' => 'big', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'stored_bytes' => ['type' => 'int', 'size' => 'big', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'source_sha256' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
      'stored_sha256' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
      'width' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'height' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'elapsed_ms' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'memory_bytes' => ['type' => 'int', 'size' => 'big', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'status' => ['type' => 'varchar', 'length' => 16, 'not null' => TRUE, 'default' => 'queued'],
      'r2_status' => ['type' => 'varchar', 'length' => 16, 'not null' => TRUE, 'default' => ''],
      'error' => ['type' => 'text', 'not null' => FALSE],
      'attempts' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'changed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'fid' => ['fid'],
      'status' => ['status'],
    ],
  ];

  return [
    'xedc_import_task' => $task,
    'xedc_import_item' => $item,
    'xedc_import_log' => $log,
    'xedc_image_alt' => $alt,
    'xedc_image_file' => $file,
    'xedc_image_optimize' => $optimize,
    'xedc_file_batch' => $batch,
    'xedc_file_hash_work' => $work,
    'xedc_file_dup_group' => $group,
    'xedc_file_dup_member' => $member,
    'xedc_file_ref' => $ref,
    'xedc_file_finding' => $finding,
    'xedc_file_cleanup_task' => $cleanupTask,
    'xedc_file_cleanup_item' => $cleanupItem,
    'xedc_file_cleanup_log' => $cleanupLog,
    'xedc_storage_variant' => $variant,
    'xedc_storage_download_log' => $downloadLog,
    'xedc_storage_migration_item' => $migrationItem,
  ] + \Drupal\xedc_core\Engagement\EngagementSchema::tables()
    + \Drupal\xedc_core\Ops\Traffic\TrafficSchema::tables()
    + ['xedc_video_transcode' => \Drupal\xedc_core\Video\TranscodeSchema::table()];
}

/**
 * Implements hook_install().
 */
function xedc_core_install(): void {
  $filesystem = \Drupal::service('file_system');
  foreach (['private://xedc-import/inbox', 'private://xedc-import/tasks', 'private://xedc-downloads', 'private://xedc-zips', 'private://xedc-download-tmp'] as $directory) {
    try {
      $filesystem->prepareDirectory($directory, FileSystemInterface::CREATE_DIRECTORY | FileSystemInterface::MODIFY_PERMISSIONS);
    }
    catch (\Throwable $e) {
      \Drupal::logger('xedc_core')->error('无法创建私有导入目录 @dir：@message', [
        '@dir' => $directory,
        '@message' => $e->getMessage(),
      ]);
    }
  }

  $grants = [
    'content_editor' => [
      'administer xedc image imports',
      'import photo archives',
      'publish xedc image imports',
    ],
    'authenticated' => [
      'import photo archives',
    ],
  ];
  foreach ($grants as $rid => $permissions) {
    $role = Role::load($rid);
    if (!$role) {
      continue;
    }
    foreach ($permissions as $permission) {
      $role->grantPermission($permission);
    }
    $role->save();
  }
}

/**
 * Allows nested and non-ASCII archive paths to be stored.
 */
function xedc_core_update_10001(): void {
  $field = [
    'type' => 'varchar',
    'length' => 2048,
    'not null' => TRUE,
    'default' => '',
  ];
  \Drupal::database()->schema()->changeField('xedc_import_item', 'temp_uri', 'temp_uri', $field);
}

/**
 * Stores source and official SHA-256 fingerprints on files and import items.
 */
function xedc_core_update_10002(): void {
  $schema = \Drupal::database()->schema();
  $hash = [
    'type' => 'varchar',
    'length' => 64,
    'not null' => TRUE,
    'default' => '',
  ];
  $flag = [
    'type' => 'int',
    'unsigned' => TRUE,
    'not null' => TRUE,
    'default' => 0,
  ];
  $add = static function (string $table, string $field, array $spec) use ($schema): void {
    if (!$schema->fieldExists($table, $field)) {
      $schema->addField($table, $field, $spec);
    }
  };
  $add('xedc_image_file', 'source_sha256', $hash);
  $add('xedc_image_file', 'stored_sha256', $hash);
  $add('xedc_import_item', 'source_sha256', $hash);
  $add('xedc_import_item', 'stored_sha256', $hash);
  $add('xedc_import_item', 'reused', $flag);
  $add('xedc_import_item', 'attempts', $flag);
  foreach (['source_sha256', 'stored_sha256'] as $name) {
    if (!$schema->indexExists('xedc_image_file', $name)) {
      $schema->addIndex('xedc_image_file', $name, [$name], [
        'fields' => [$name => $hash],
      ]);
    }
  }
}

/**
 * Stores local monitor and file-scan defaults.
 */
function xedc_core_update_10003(): void {
  $config = \Drupal::configFactory()->getEditable('xedc_core.settings');
  $defaults = [
    'netdata_base_url' => 'http://127.0.0.1:19999',
    'file_scan_batch' => 250,
    'file_scan_seconds' => 6,
    'file_large_bytes' => 104857600,
    'file_huge_bytes' => 524288000,
    'file_stale_days' => 180,
    'file_top_files' => 100,
    'file_top_dirs' => 50,
  ];
  foreach ($defaults as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
    }
  }
  $config->save();
}

/**
 * Adds file analysis tables and cleanup defaults. Does not scan or delete.
 */
function xedc_core_update_10004(): void {
  $schema = \Drupal::database()->schema();
  $spec = xedc_core_schema();
  foreach ([
    'xedc_file_batch',
    'xedc_file_hash_work',
    'xedc_file_dup_group',
    'xedc_file_dup_member',
    'xedc_file_ref',
    'xedc_file_finding',
    'xedc_file_cleanup_task',
    'xedc_file_cleanup_item',
    'xedc_file_cleanup_log',
  ] as $table) {
    if (!$schema->tableExists($table)) {
      $schema->createTable($table, $spec[$table]);
    }
  }
  $config = \Drupal::configFactory()->getEditable('xedc_core.settings');
  $defaults = [
    'file_analysis_auto' => 1,
    'file_analysis_interval' => 86400,
    'file_analysis_batch' => 40,
    'file_analysis_seconds' => 4,
    'file_analysis_suggest' => 1,
    'file_hash_max_bytes' => 67108864,
    'file_quarantine_days' => 14,
  ];
  foreach ($defaults as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
    }
  }
  $config->save();
  try {
    $directory = 'private://xedc-quarantine';
    \Drupal::service('file_system')->prepareDirectory($directory, FileSystemInterface::CREATE_DIRECTORY | FileSystemInterface::MODIFY_PERMISSIONS);
  }
  catch (\Throwable $e) {
    \Drupal::logger('xedc_core')->error('无法创建隔离目录：@message', ['@message' => $e->getMessage()]);
  }
}

/**
 * Installs non-secret object storage defaults. Does not enable remote storage.
 */
function xedc_core_update_10005(): string {
  $config = \Drupal::configFactory()->getEditable('xedc_core.storage');
  if (!$config->isNew() && is_array($config->get('policy'))) {
    return '对象存储配置已存在，未覆盖。';
  }
  $config->setData(\Drupal\xedc_core\Ops\Storage\StorageConfig::defaults());
  $config->save();
  return '已写入对象存储默认配置。远程存储保持关闭。';
}

/**
 * Adds VIP, likes, shares, download history and the download resource entity.
 */
function xedc_core_update_10006(): string {
  $schema = \Drupal::database()->schema();
  foreach (\Drupal\xedc_core\Engagement\EngagementSchema::tables() as $name => $table) {
    if (!$schema->tableExists($name)) {
      $schema->createTable($name, $table);
    }
  }
  if (!Role::load('vip')) {
    Role::create([
      'id' => 'vip',
      'label' => 'VIP 会员',
      'is_admin' => FALSE,
      'permissions' => [],
    ])->save();
  }
  \Drupal::entityTypeManager()->clearCachedDefinitions();
  if (!$schema->tableExists('xedc_download')) {
    $definition = \Drupal::entityTypeManager()->getDefinition('xedc_download');
    \Drupal::entityDefinitionUpdateManager()->installEntityType($definition);
  }
  $filesystem = \Drupal::service('file_system');
  foreach (['private://xedc-downloads', 'private://xedc-zips', 'private://xedc-download-tmp'] as $directory) {
    $filesystem->prepareDirectory($directory, FileSystemInterface::CREATE_DIRECTORY | FileSystemInterface::MODIFY_PERMISSIONS);
  }
  return '已安装会员互动、VIP 和下载资源数据结构。';
}

/**
 * Adds object-storage bookkeeping tables. Does not copy or delete files.
 */
function xedc_core_update_10007(): string {
  $schema = \Drupal::database()->schema();
  $spec = xedc_core_schema();
  $created = [];
  foreach (['xedc_storage_variant', 'xedc_storage_download_log', 'xedc_storage_migration_item'] as $table) {
    if (!$schema->tableExists($table)) {
      $schema->createTable($table, $spec[$table]);
      $created[] = $table;
    }
  }
  return $created === [] ? '对象存储记录表已存在，未改动。' : '已创建：' . implode('、', $created) . '。没有复制或删除文件。';
}

/**
 * Adds like status, download detail and ZIP job state. Does not delete rows.
 */
function xedc_core_update_10008(): string {
  $schema = \Drupal::database()->schema();
  $database = \Drupal::database();
  if ($schema->tableExists('xedc_like') && !$schema->fieldExists('xedc_like', 'status')) {
    $schema->addField('xedc_like', 'status', [
      'type' => 'int',
      'size' => 'tiny',
      'unsigned' => TRUE,
      'not null' => TRUE,
      'default' => 1,
    ]);
  }
  if ($schema->tableExists('xedc_like') && !$schema->fieldExists('xedc_like', 'changed')) {
    $schema->addField('xedc_like', 'changed', [
      'type' => 'int',
      'unsigned' => TRUE,
      'not null' => TRUE,
      'default' => 0,
    ]);
    $database->update('xedc_like')->expression('changed', 'created')->execute();
  }
  foreach ([
    'source' => 16,
    'tier' => 16,
    'delivery' => 16,
    'detail' => 255,
  ] as $field => $length) {
    if ($schema->tableExists('xedc_download_log') && !$schema->fieldExists('xedc_download_log', $field)) {
      $schema->addField('xedc_download_log', $field, [
        'type' => 'varchar',
        'length' => $length,
        'not null' => TRUE,
        'default' => '',
      ]);
    }
  }
  $tables = \Drupal\xedc_core\Engagement\EngagementSchema::tables();
  if (!$schema->tableExists('xedc_zip_job')) {
    $schema->createTable('xedc_zip_job', $tables['xedc_zip_job']);
  }
  $filesystem = \Drupal::service('file_system');
  foreach (['private://xedc-downloads', 'private://xedc-zips', 'private://xedc-download-tmp'] as $directory) {
    $filesystem->prepareDirectory($directory, \Drupal\Core\File\FileSystemInterface::CREATE_DIRECTORY | \Drupal\Core\File\FileSystemInterface::MODIFY_PERMISSIONS);
    $real = $filesystem->realpath($directory);
    if (is_string($real)) {
      @chmod($real, 0775);
      if (function_exists('posix_getpwnam')) {
        $user = posix_getpwnam('www-data');
        if (is_array($user) && function_exists('posix_geteuid') && posix_geteuid() === 0) {
          @chown($real, (string) $user['name']);
          @chgrp($real, (string) $user['name']);
        }
      }
    }
  }
  return '已补充点赞状态、下载明细和 ZIP 任务记录。原有记录已保留。';
}

/**
 * Adds physical NIC traffic snapshots and daily totals.
 */
function xedc_core_update_10009(): string {
  $schema = \Drupal::database()->schema();
  $created = [];
  foreach (\Drupal\xedc_core\Ops\Traffic\TrafficSchema::tables() as $name => $table) {
    if (!$schema->tableExists($name)) {
      $schema->createTable($name, $table);
      $created[] = $name;
    }
  }
  return $created === [] ? '网络流量统计表已存在，未改动。' : '已创建：' . implode('、', $created) . '。';
}

/**
 * Lets guests like without sharing one uid 0 row. Existing member rows stay.
 */
function xedc_core_update_10010(): string {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('xedc_like')) {
    return '点赞表不存在，未改动。';
  }
  if (!$schema->fieldExists('xedc_like', 'actor_hash')) {
    $schema->addField('xedc_like', 'actor_hash', [
      'type' => 'varchar',
      'length' => 64,
      'not null' => TRUE,
      'default' => '',
    ]);
  }
  if ($schema->indexExists('xedc_like', 'user_entity')) {
    $schema->dropUniqueKey('xedc_like', 'user_entity');
  }
  if (!$schema->indexExists('xedc_like', 'user_actor')) {
    $schema->addUniqueKey('xedc_like', 'user_actor', ['uid', 'actor_hash', 'entity_type', 'entity_id']);
  }
  return '已为点赞表增加游客身份哈希。原有会员点赞记录已保留。';
}

/**
 * Stores one playback-copy job per source file.
 */
function xedc_core_update_10011(): string {
  $schema = \Drupal::database()->schema();
  if ($schema->tableExists('xedc_video_transcode')) {
    return '播放副本任务表已存在，未改动。';
  }
  $schema->createTable('xedc_video_transcode', \Drupal\xedc_core\Video\TranscodeSchema::table());
  return '已创建播放副本任务表。原视频和已有播放副本均未改动。';
}

/**
 * Adds the image optimization audit table. Existing files are not scanned.
 */
function xedc_core_update_10012(): string {
  $schema = \Drupal::database()->schema();
  if ($schema->tableExists('xedc_image_optimize')) {
    return '图片优化记录表已存在，未改动历史文件。';
  }
  $schema->createTable('xedc_image_optimize', xedc_core_schema()['xedc_image_optimize']);
  return '已创建图片优化记录表。历史图片没有批量处理。';
}
