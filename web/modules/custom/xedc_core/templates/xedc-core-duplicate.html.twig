<div class="xedc-ops">
  <header class="xedc-ops-head">
    <div>
      <p class="xedc-ops-kicker">重复组 #{{ group.id }}</p>
      <h2 class="xedc-ops-title">{{ group.count }} 个文件</h2>
    </div>
    <a class="xedc-ops-button" href="{{ path('xedc_core.files_duplicates') }}">返回列表</a>
  </header>
  <ul class="xedc-ops-metrics">
    <li><span>总大小</span><strong>{{ group.bytes }}</strong></li>
    <li><span>理论可释放</span><strong>{{ group.reclaimable }}</strong></li>
    <li><span>风险</span><strong>{{ group.risk }}</strong></li>
    <li><span>引用</span><strong>{{ group.status }}</strong></li>
  </ul>
  <p class="xedc-ops-detail"><code>{{ group.hash }}</code></p>
  {% for member in members %}
    <article class="xedc-ops-panel">
      <h3>文件 {{ member.fid }} · {{ member.filename }}</h3>
      <ul class="xedc-ops-metrics">
        <li><span>URI</span><strong>{{ member.uri }}</strong></li>
        <li><span>路径</span><strong>{{ member.path }}</strong></li>
        <li><span>大小</span><strong>{{ member.bytes }}</strong></li>
        <li><span>MIME</span><strong>{{ member.mime }}</strong></li>
        <li><span>修改时间</span><strong>{{ member.mtime }}</strong></li>
        <li><span>文件实体</span><strong>{{ member.entity }}</strong></li>
        <li><span>媒体字段</span><strong>{{ member.media }}</strong></li>
        <li><span>引用数</span><strong>{{ member.refs }}</strong></li>
        <li><span>状态</span><strong>{{ member.status }}</strong></li>
        <li><span>风险</span><strong>{{ member.risk }}</strong></li>
      </ul>
      {% if member.references %}
        <div class="xedc-ops-table-wrap">
          <table class="xedc-ops-table">
            <thead><tr><th>来源</th><th>实体</th><th>修订</th><th>语言</th><th>字段</th><th>判断</th><th>迁移</th><th>说明</th></tr></thead>
            <tbody>
              {% for ref in member.references %}
                <tr>
                  <td>{{ ref.source }}</td><td>{{ ref.entity }}</td><td>{{ ref.revision }}</td><td>{{ ref.langcode }}</td>
                  <td>{{ ref.field }}</td><td>{{ ref.confidence }}</td><td>{{ ref.migratable }}</td><td>{{ ref.reason }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% else %}
        <p class="xedc-ops-note">没有记录到引用。若状态不是确认未引用，仍不能删除。</p>
      {% endif %}
    </article>
  {% endfor %}
  {% if form %}
    <section class="xedc-ops-panel">
      <h3>生成合并方案</h3>
      <p class="xedc-ops-detail">选择保留文件后只会生成待审核方案。存在未知或不能迁移的引用时，方案不能被确认执行。</p>
      {{ form }}
    </section>
  {% else %}
    <p class="xedc-ops-note">当前账号不能创建清理方案。</p>
  {% endif %}
</div>
