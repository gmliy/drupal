{#
/**
 * @file
 * One discovered Netdata section. Values are already display strings.
 */
#}
<section aria-label="{{ detail.title|default('监控明细') }}">
  <h3 class="xedc-ops-section">{{ detail.title }}</h3>
  {% if detail.error %}
    <div class="xedc-ops-alert" role="alert"><p>{{ detail.error }}</p></div>
  {% endif %}
  <p class="xedc-ops-note" data-xedc-detail-notice>
    {{ detail.updated ? '采样 ' ~ detail.updated : '' }}
    {{ detail.status_label|default('') }}
  </p>
  {% for note in detail.notes|default([]) %}
    <p class="xedc-ops-note">{{ note }}</p>
  {% endfor %}
  {% if detail.traffic %}
    {% include '@xedc_core/xedc-core-traffic.html.twig' with {traffic: detail.traffic} %}
  {% endif %}

  {% for group in detail.groups|default([]) %}
    <article class="xedc-ops-panel">
      <h3>{{ group.title }}</h3>
      {% if group.metrics %}
        <ul class="xedc-ops-metrics">
          {% for metric in group.metrics %}
            <li>
              <span>{{ metric.label }}</span>
              <strong data-k="{{ metric.key }}">{{ metric.value }}{% if metric.unit %} {{ metric.unit }}{% endif %}</strong>
              <em class="is-{{ metric.status }}">{{ metric.status_label }}{% if metric.trend_label %} · {{ metric.trend_label }}{% endif %}{% if metric.sampled %} · {{ metric.sampled }}{% endif %}</em>
              {% if metric.note %}<em>{{ metric.note }}</em>{% endif %}
            </li>
          {% endfor %}
        </ul>
      {% endif %}
      {% for table in group.tables|default([]) %}
        <h3>{{ table.title }}</h3>
        <div class="xedc-ops-table-wrap">
          <table class="xedc-ops-table">
            <thead>
              <tr>{% for header in table.headers %}<th>{{ header }}</th>{% endfor %}</tr>
            </thead>
            <tbody>
              {% for row in table.rows %}
                <tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>
              {% else %}
                <tr><td colspan="{{ table.headers|length }}">未采集</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endfor %}
    </article>
  {% endfor %}

  {% if detail.browser is defined and detail.browser %}
    <form class="xedc-ops-filters" method="get">
      <input type="hidden" name="section" value="browser">
      <input type="search" name="q" value="{{ detail.browser.query }}" placeholder="图表、维度或采集器">
      <select name="category">
        <option value="">全部分类</option>
        {% for name, count in detail.browser.categories %}
          <option value="{{ name }}" {{ detail.browser.category == name ? 'selected' : '' }}>{{ name }}（{{ count }}）</option>
        {% endfor %}
      </select>
      <button class="xedc-ops-button" type="submit">筛选</button>
    </form>
    <p class="xedc-ops-note">{{ detail.browser.total }} 个图表，第 {{ detail.browser.page + 1 }} / {{ detail.browser.pages }} 页。当前页数值来自最近一次采样。</p>
    <div class="xedc-ops-table-wrap">
      <table class="xedc-ops-table">
        <thead>
          <tr><th>图表</th><th>分类</th><th>单位</th><th>维度</th><th>当前值</th><th>状态</th><th></th></tr>
        </thead>
        <tbody>
          {% for row in detail.browser.rows %}
            <tr>
              <td>{{ row.title }}<br><code>{{ row.id }}</code></td>
              <td>{{ row.category }}</td>
              <td>{{ row.units }}</td>
              <td>{{ row.dimensions }}</td>
              <td>{{ row.value }}</td>
              <td>{{ row.status }}{% if row.updated %} · {{ row.updated }}{% endif %}</td>
              <td><button type="button" data-chart-id="{{ row.id }}">趋势</button></td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <p class="xedc-ops-pager">
      {% if detail.browser.page > 0 %}
        <a href="?section=browser&amp;page={{ detail.browser.page - 1 }}&amp;q={{ detail.browser.query|url_encode }}&amp;category={{ detail.browser.category|url_encode }}">上一页</a>
      {% endif %}
      {% if detail.browser.page + 1 < detail.browser.pages %}
        <a href="?section=browser&amp;page={{ detail.browser.page + 1 }}&amp;q={{ detail.browser.query|url_encode }}&amp;category={{ detail.browser.category|url_encode }}">下一页</a>
      {% endif %}
    </p>
  {% endif %}

  {% if detail.collectors %}
    <article class="xedc-ops-panel">
      <h3>已发现采集器</h3>
      <div class="xedc-ops-table-wrap">
        <table class="xedc-ops-table">
          <thead><tr><th>采集器</th><th>图表数</th><th>状态</th></tr></thead>
          <tbody>
            {% for row in detail.collectors %}
              <tr><td>{{ row.name }}</td><td>{{ row.charts }}</td><td>{{ row.state }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </article>
  {% endif %}

  {% if detail.section|default('') == 'alarms' %}
    <article class="xedc-ops-panel">
      <h3>Netdata 告警</h3>
      {% if detail.alarms %}
        <div class="xedc-ops-table-wrap">
          <table class="xedc-ops-table">
            <thead><tr><th>名称</th><th>级别</th><th>时间</th><th>状态</th><th>指标</th><th>说明</th></tr></thead>
            <tbody>
              {% for alarm in detail.alarms %}
                <tr>
                  <td>{{ alarm.name }}</td>
                  <td>{{ alarm.level }}</td>
                  <td>{{ alarm.when }}</td>
                  <td>{{ alarm.state }}</td>
                  <td>{{ alarm.chart }}</td>
                  <td>{{ alarm.info }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% else %}
        <p class="xedc-ops-note">当前没有 Netdata 原生告警。没有活动告警时不会显示为正常或警告。</p>
      {% endif %}
    </article>
  {% endif %}

  <div class="xedc-ops-chart-grid" data-xedc-detail-charts>
    {% for key, chart in detail.charts|default({}) %}
      <article class="xedc-ops-panel" data-chart="{{ key }}">
        <h3>{{ chart.title }}</h3>
        <div class="xedc-ops-plot" data-plot></div>
        <p class="xedc-ops-detail" data-chart-note></p>
      </article>
    {% endfor %}
  </div>
</section>
