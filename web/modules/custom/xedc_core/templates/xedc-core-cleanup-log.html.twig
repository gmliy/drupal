<div class="xedc-ops">
  <header class="xedc-ops-head">
    <div>
      <p class="xedc-ops-kicker">运维中心</p>
      <h2 class="xedc-ops-title">清理日志</h2>
    </div>
  </header>
  <p class="xedc-ops-note">日志只追加，页面不能修改。</p>
  <form class="xedc-ops-filters" method="get">
    <input type="number" name="task_id" value="{{ filters.task_id ?: '' }}" placeholder="任务 ID" min="1">
    <input type="text" name="op" value="{{ filters.op }}" placeholder="操作类型">
    <select name="success">
      <option value="">全部结果</option>
      <option value="1" {% if filters.success == '1' %}selected{% endif %}>成功</option>
      <option value="0" {% if filters.success == '0' %}selected{% endif %}>失败</option>
    </select>
    <button class="xedc-ops-button" type="submit">筛选</button>
  </form>
  {% if detail %}
    <article class="xedc-ops-panel">
      <h3>日志 #{{ detail.id }}</h3>
      <ul class="xedc-ops-metrics">
        <li><span>任务</span><strong>#{{ detail.task_id }}</strong></li>
        <li><span>操作人</span><strong>UID {{ detail.uid }}</strong></li>
        <li><span>时间</span><strong>{{ detail.created }}</strong></li>
        <li><span>操作</span><strong>{{ detail.op }}</strong></li>
        <li><span>结果</span><strong>{{ detail.success }}</strong></li>
      </ul>
      {% if detail.error %}<p class="xedc-ops-note">{{ detail.error }}</p>{% endif %}
      <pre class="xedc-ops-detail">{{ detail.detail }}</pre>
    </article>
  {% endif %}
  {% if empty %}
    <p class="xedc-ops-note">没有日志。</p>
  {% else %}
    <div class="xedc-ops-table-wrap">
      <table class="xedc-ops-table">
        <thead><tr><th>记录</th><th>任务</th><th>操作人</th><th>时间</th><th>操作</th><th>结果</th><th>错误</th></tr></thead>
        <tbody>
          {% for row in rows %}
            <tr>
              <td><a href="{{ row.url }}">#{{ row.id }}</a></td>
              <td>{{ row.task_id }}</td>
              <td>{{ row.uid }}</td>
              <td>{{ row.created }}</td>
              <td>{{ row.op }}</td>
              <td>{{ row.success }}</td>
              <td>{{ row.error }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <div class="xedc-ops-pager">
      {% if pager.prev %}<a class="xedc-ops-button" href="{{ pager.prev }}">上一页</a>{% endif %}
      <span>{{ pager.page }} / {{ pager.pages }}</span>
      {% if pager.next %}<a class="xedc-ops-button" href="{{ pager.next }}">下一页</a>{% endif %}
    </div>
  {% endif %}
</div>
