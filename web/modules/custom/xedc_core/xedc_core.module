/**
 * Stores the archive selection for the duration of one form submission.
 *
 * @param array<string, mixed>|null $value
 *   Payload to store when $op is set.
 */
function xedc_core_import_payload(string $op = 'get', ?array $value = NULL): ?array {
  $store = &drupal_static(__FUNCTION__);
  if ($op === 'set') {
    $store = $value;
    return $store;
  }
  if ($op === 'take') {
    $taken = $store;
    $store = NULL;
    return $taken;
  }
  return $store;
}

/**
 * Implements hook_form_node_form_alter().
 */
function xedc_core_form_node_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $form_object = $form_state->getFormObject();
  if (!method_exists($form_object, 'getEntity')) {
    return;
  }
  $node = $form_object->getEntity();
  if ($node instanceof NodeInterface) {
    xedc_core_download_form_attach($form, $node);
  }
  if (!$node instanceof NodeInterface || $node->bundle() !== 'photo') {
    return;
  }
  $account = \Drupal::currentUser();
  if (!$account->hasPermission('import photo archives') && !$account->hasPermission('administer xedc image imports')) {
    return;
  }
  $archive = \Drupal::service('xedc_core.archive');
  $limit = (int) \Drupal::config('xedc_core.settings')->get('max_archive_bytes') ?: 209715200;
  $form['#attached']['library'][] = 'xedc_core/asset_upload';
  $form['#attached']['drupalSettings']['xedcAsset'] = [
    'archiveUrl' => Url::fromRoute('xedc_core.asset_archive')->toString(),
    'imageUrl' => Url::fromRoute('xedc_core.asset_image')->toString(),
    'draftUrl' => Url::fromRoute('xedc_core.asset_draft')->toString(),
    'closeUrl' => Url::fromRoute('xedc_core.asset_close')->toString(),
    'progressBase' => Url::fromRoute('xedc_core.import_list')->toString() . '/',
    'maxArchive' => $limit,
    'nid' => (int) $node->id(),
    'titleSelector' => '#edit-title-0-value',
  ];
  $form['xedc_import'] = [
    '#type' => 'details',
    '#title' => t('图片上传 / ZIP / 7z'),
    '#open' => TRUE,
    '#tree' => TRUE,
    '#weight' => 8,
    '#attributes' => ['class' => ['xedc-import']],
    '#attached' => ['library' => ['xedc_core/admin', 'xedc_core/asset_upload']],
  ];
  $readiness = \Drupal::service('xedc_core.gallery_metrics')->readiness($node);
  $reason = $readiness['reasons'] ? implode('；', $readiness['reasons']) : (string) t('当前没有阻塞发布的图片问题。');
  $form['xedc_import']['status'] = [
    '#type' => 'inline_template',
    '#template' => '<p>{{ count }}；{{ original }}；{{ optimized }}；{{ saved }}；{{ ratio }}。{{ note }} {{ status }}。{{ reason }}</p>',
    '#context' => [
      'count' => t('图片 @count 张', ['@count' => $readiness['count']]),
      'original' => t('原图总大小 @size', ['@size' => $readiness['original_label']]),
      'optimized' => t('优化后 @size', ['@size' => $readiness['optimized_label']]),
      'saved' => t('节省 @size', ['@size' => $readiness['saved_label']]),
      'ratio' => t('压缩率 @ratio', ['@ratio' => $readiness['ratio_label']]),
      'note' => $readiness['partial_note'],
      'status' => t('处理状态 @status', ['@status' => $readiness['status']]),
      'reason' => $reason,
    ],
  ];
  $form['xedc_import']['uploader'] = [
    '#type' => 'inline_template',
    '#template' => '<div class="xedc-upload" data-xedc-asset-upload data-nid="{{ nid }}"><div class="xedc-upload__grid"><section><h3>ZIP / 7z</h3><label>{{ archive_label }}<input type="file" data-xedc-archive accept=".zip,.7z,application/zip,application/x-7z-compressed"></label></section><section><h3>{{ image_heading }}</h3><label>{{ image_label }}<input type="file" data-xedc-images accept="image/jpeg,image/png,image/gif,image/webp" multiple></label></section></div><p class="xedc-upload__note" data-xedc-note>{{ help }}</p><ul data-xedc-list></ul></div>',
    '#context' => [
      'nid' => (int) $node->id(),
      'archive_label' => t('选择压缩包，上传后自动开始导入'),
      'image_heading' => t('普通图片'),
      'image_label' => t('选择图片，上传后后台继续优化'),
      'help' => t('新建内容会先保存草稿。已上传成功的任务不会因为离开页面而丢失；浏览器里还没传完的文件无法由服务器恢复。'),
    ],
  ];
  $form['xedc_import']['help'] = [
    '#markup' => '<p>' . t('上方图片集仍可使用媒体库。大批量图片建议用这里的上传，避免一次提交超过服务器的文件数量限制。') . '</p>',
  ];
  if (!$archive->privateReady()) {
    $form['xedc_import']['missing'] = [
      '#markup' => '<p>' . t('未配置私有文件目录，暂时不能上传压缩包。请设置 file_private_path 后执行 drush cr。') . '</p>',
    ];
    return;
  }
  if (!$archive->sevenZipBinary()) {
    $form['xedc_import']['sevenzip'] = [
      '#markup' => '<p>' . t('服务器没有 7z，目前只能导入 ZIP。安装：sudo apt-get install 7zip') . '</p>',
    ];
  }
  if ($account->hasPermission('administer xedc image imports')) {
    $options = $archive->inboxOptions();
    if ($options) {
      $form['xedc_import']['server'] = [
        '#type' => 'select',
        '#title' => t('或选择服务器压缩包'),
        '#options' => $options,
        '#empty_option' => t('- 不选择 -'),
        '#description' => t('只能选择私有目录 inbox 里的 ZIP/7Z，不能浏览其他目录。'),
      ];
    }
  }
  if (!$node->isNew() && $node->hasField('field_images') && !$node->get('field_images')->isEmpty()) {
    $form['xedc_import']['mode'] = [
      '#type' => 'radios',
      '#title' => t('导入方式'),
      '#options' => [
        'append' => t('追加到现有图片后面'),
        'replace' => t('全部成功后替换现有图片'),
      ],
      '#default_value' => 'append',
    ];
  }
  if ($node->id()) {
    $existing = \Drupal::service('xedc_core.tasks')->forNode((int) $node->id());
    if ($existing) {
      $rows = [];
      foreach ($existing as $task) {
        $rows[] = [
          ['data' => Link::createFromRoute('#' . $task->id, 'xedc_core.import_detail', ['task' => $task->id])->toRenderable()],
          ImportStatus::label((string) $task->status),
          (int) $task->progress . '%',
          (string) $task->archive_name,
        ];
      }
      $form['xedc_import']['tasks'] = [
        '#type' => 'table',
        '#header' => [t('任务'), t('状态'), t('进度'), t('压缩包')],
        '#rows' => $rows,
        '#caption' => t('已有导入任务'),
      ];
      $active = NULL;
      foreach ($existing as $task) {
        if (!ImportStatus::isTerminal((string) $task->status)) {
          $active = $task;
          break;
        }
      }
      if ($active) {
        $url = Url::fromRoute('xedc_core.import_progress', ['task' => (int) $active->id])->toString();
        $form['xedc_import']['live'] = [
          '#type' => 'container',
          '#attributes' => ['data-xedc-progress-url' => $url],
          'label' => [
            '#type' => 'html_tag',
            '#tag' => 'p',
            '#attributes' => ['data-xedc-progress-label' => '1'],
            '#value' => ImportStatus::label((string) $active->status) . ' ' . (int) $active->progress . '%',
          ],
          'bar' => [
            '#markup' => '<div class="xedc-import__bar"><span data-xedc-progress-fill="1" style="width:' . (int) $active->progress . '%"></span></div>',
          ],
        ];
      }
    }
  }
  $form['#validate'][] = 'xedc_core_photo_import_validate';
}

/**
 * Validates the archive selection without blocking a plain photo save.
 */
function xedc_core_photo_import_validate(array &$form, FormStateInterface $form_state): void {
  $trigger = $form_state->getTriggeringElement();
  $name = (string) ($trigger['#name'] ?? '');
  if (str_ends_with($name, '_upload_button') || str_ends_with($name, '_remove_button')) {
    return;
  }
  $import = $form_state->getValue('xedc_import');
  if (!is_array($import)) {
    return;
  }
  $fids = array_values(array_filter(array_map('intval', (array) ($import['archive'] ?? []))));
  $server = trim((string) ($import['server'] ?? ''));
  if (!$fids && $server === '') {
    return;
  }
  if ($fids && $server !== '') {
    $form_state->setErrorByName('xedc_import][archive', t('请只选择一种压缩包来源。'));
    return;
  }
  $node = $form_state->getFormObject()->getEntity();
  if ($node instanceof NodeInterface && $node->id() && \Drupal::service('xedc_core.tasks')->hasActive((int) $node->id())) {
    $form_state->setErrorByName('xedc_import][archive', t('该内容已有正在处理的导入任务。'));
    return;
  }
  xedc_core_import_payload('set', [
    'is_new' => $node instanceof NodeInterface && $node->isNew(),
    'nid' => $node instanceof NodeInterface ? (int) $node->id() : 0,
    'mode' => (string) ($import['mode'] ?? 'append'),
    'fid' => $fids[0] ?? 0,
    'server' => $server,
  ]);
}

/**
 * Runs after other modules so a new archive import stays a draft.
 *
 * Staff saves otherwise publish new photo nodes immediately.
 */
function xedc_core_module_implements_alter(array &$implementations, string $hook): void {
  if (($hook === 'node_presave' || $hook === 'entity_delete') && isset($implementations['xedc_core'])) {
    $implementation = $implementations['xedc_core'];
    unset($implementations['xedc_core']);
    $implementations['xedc_core'] = $implementation;
  }
}

/**
 * Uses the CDN-aware image restriction without disabling the core filter.
 *
 * basic_html keeps filter_html_image_secure enabled. Only the plugin class
 * changes, so tag allowlists and filter order stay as configured.
 */
function xedc_core_filter_info_alter(array &$info): void {
  if (isset($info['filter_html_image_secure']['class'])) {
    $info['filter_html_image_secure']['class'] = \Drupal\xedc_core\Filter\TrustedHtmlImageSecure::class;
  }
}

/**
 * Implements hook_node_presave().
 */
function xedc_core_node_presave(NodeInterface $node): void {
  if (\Drupal::hasService('xedc_core.image_optimize') && \Drupal::service('xedc_core.image_optimize')->blocksPublish($node)) {
    $publishing = $node->isPublished() || ($node->hasField('moderation_state') && $node->get('moderation_state')->value === 'published');
    if ($publishing) {
      if ($node->hasField('moderation_state')) {
        $node->set('moderation_state', 'draft');
      }
      $node->setUnpublished();
      \Drupal::messenger()->addWarning(t('有图片还在优化或优化失败，内容已保持为草稿。'));
    }
  }
  if ($node->bundle() !== 'photo') {
    return;
  }
  if (!empty($node->xedc_import_internal)) {
    return;
  }
  if (xedc_core_import_payload()) {
    if ($node->hasField('moderation_state')) {
      $node->set('moderation_state', 'draft');
    }
    $node->setUnpublished();
  }
  elseif ($node->id() && \Drupal::service('xedc_core.tasks')->blocksPublish((int) $node->id())) {
    $was_published = $node->original instanceof NodeInterface && $node->original->isPublished();
    $publishing = $node->isPublished() || ($node->hasField('moderation_state') && $node->get('moderation_state')->value === 'published');
    if ($publishing && !$was_published) {
      if ($node->hasField('moderation_state')) {
        $node->set('moderation_state', 'draft');
      }
      $node->setUnpublished();
      \Drupal::messenger()->addWarning(t('导入尚未完成或未通过校验，内容已保持为草稿。'));
    }
  }
  if ($node->id() && $node->original instanceof NodeInterface && $node->hasField('field_cover_image')) {
    $old = (int) $node->original->get('field_cover_image')->target_id;
    $new = (int) $node->get('field_cover_image')->target_id;
    if ($new && $new !== $old) {
      \Drupal::service('xedc_core.tasks')->lockCover((int) $node->id());
    }
  }
}

/**
 * Optimizes a new public image before it is treated as the stored original.
 */
function xedc_core_file_insert(FileInterface $file): void {
  if (\Drupal::hasService('xedc_core.image_optimize')) {
    \Drupal::service('xedc_core.image_optimize')->accept($file);
  }
}

/**
 * Optimizes an image that became public after it was first stored elsewhere.
 */
function xedc_core_file_update(FileInterface $file): void {
  if (\Drupal::hasService('xedc_core.image_optimize')) {
    \Drupal::service('xedc_core.image_optimize')->accept($file);
  }
}

/**
 * Keeps image field dimensions aligned with the optimized file.
 */
function xedc_core_entity_presave(EntityInterface $entity): void {
  if ($entity instanceof ContentEntityInterface && \Drupal::hasService('xedc_core.image_optimize')) {
    \Drupal::service('xedc_core.image_optimize')->syncImageDimensions($entity);
  }
}

/**
 * Implements hook_node_insert().
 */
function xedc_core_node_insert(NodeInterface $node): void {
  if ($node->bundle() === 'photo' && empty($node->xedc_import_internal)) {
    \Drupal::service('xedc_core.alt')->refresh($node);
    xedc_core_cover_alt($node, 'field_cover_image');
  }
  xedc_core_import_after_save($node);
  xedc_core_video_after_save($node);
}

/**
 * Implements hook_node_update().
 */
function xedc_core_node_update(NodeInterface $node): void {
  if ($node->bundle() === 'photo' && empty($node->xedc_import_internal) && $node->original instanceof NodeInterface) {
    $before = array_column($node->original->hasField('field_images') ? $node->original->get('field_images')->getValue() : [], 'target_id');
    $after = array_column($node->hasField('field_images') ? $node->get('field_images')->getValue() : [], 'target_id');
    if ($node->original->label() !== $node->label() || $before !== $after) {
      \Drupal::service('xedc_core.alt')->refresh($node);
    }
    xedc_core_cover_alt($node, 'field_cover_image');
    if ($node->isPublished() && !$node->original->isPublished()) {
      \Drupal::service('xedc_core.tasks')->markNodePublished((int) $node->id(), (int) \Drupal::currentUser()->id());
    }
  }
  xedc_core_import_after_save($node);
  xedc_core_video_after_save($node);
}

/**
 * Starts the queued import after the photo node exists.
 */
function xedc_core_import_after_save(NodeInterface $node): void {
  if ($node->bundle() !== 'photo') {
    return;
  }
  $payload = xedc_core_import_payload('take');
  if (!$payload) {
    return;
  }
  if (!empty($payload['nid']) && (int) $payload['nid'] !== (int) $node->id()) {
    return;
  }
  try {
    $id = \Drupal::service('xedc_core.processor')->start($node, $payload);
    \Drupal::messenger()->addStatus(t('已创建导入任务 #@id。处理在后台继续，完成前不会公开新内容。', ['@id' => $id]));
  }
  catch (\Throwable $e) {
    \Drupal::messenger()->addError($e->getMessage());
  }
}

/**
 * Fills an empty cover ALT without using the gallery sequence.
 */
function xedc_core_cover_alt(NodeInterface $node, string $field): void {
  if (!$node->hasField($field) || $node->get($field)->isEmpty()) {
    return;
  }
  $media = $node->get($field)->entity;
  if (!$media instanceof MediaInterface || !$media->hasField('field_media_image') || $media->get('field_media_image')->isEmpty()) {
    return;
  }
  if ($node->hasField('field_images')) {
    foreach ($node->get('field_images')->getValue() as $item) {
      if ((int) ($item['target_id'] ?? 0) === (int) $media->id()) {
        return;
      }
    }
  }
  $alt = \Drupal::service('xedc_core.alt');
  $current = trim((string) $media->get('field_media_image')->alt);
  $row = \Drupal::database()->select('xedc_image_alt', 'a')
    ->fields('a', ['source'])
    ->condition('mid', (int) $media->id())
    ->execute()
    ->fetchField();
  if ($row === 'manual' || ($current !== '' && $row !== 'auto')) {
    return;
  }
  $text = $alt->cover($node->label());
  if ($current === $text) {
    return;
  }
  $media->xedc_import_internal = TRUE;
  $media->get('field_media_image')->first()->set('alt', $text);
  $media->save();
  $alt->remember((int) $media->id(), $text, 'auto');
}

/**
 * Sets an avatar ALT only when the picture has none.
 */
function xedc_core_user_presave(UserInterface $user): void {
  if (!$user->hasField('user_picture') || $user->get('user_picture')->isEmpty()) {
    return;
  }
  $item = $user->get('user_picture')->first();
  if (!$item || trim((string) $item->alt) !== '') {
    return;
  }
  $item->set('alt', \Drupal::service('xedc_core.alt')->cleanTitle($user->getDisplayName()) . '_头像');
}

/**
 * Implements hook_media_presave().
 */
function xedc_core_media_presave(MediaInterface $media): void {
  if ($media->bundle() !== 'image' || !empty($media->xedc_import_internal) || !$media->id()) {
    return;
  }
  if (!$media->hasField('field_media_image') || $media->get('field_media_image')->isEmpty()) {
    return;
  }
  \Drupal::service('xedc_core.alt')->markManualIfEdited((int) $media->id(), (string) $media->get('field_media_image')->alt);
}

/**
 * Implements hook_cron().
 */
function xedc_core_cron(): void {
  \Drupal::service('xedc_core.processor')->recover();
  $runner = (int) \Drupal::keyValue('state')->get('xedc_import.runner', 0);
  if ($runner < \Drupal::time()->getRequestTime() - 45) {
    \Drupal::service('xedc_core.processor')->fallback(20);
  }
  \Drupal::service('xedc_core.cleaner')->expire();
  \Drupal::service('xedc_core.file_analysis')->cron();
  try {
    \Drupal::service('xedc_core.traffic')->samplePhysical();
  }
  catch (\Throwable $e) {
    \Drupal::logger('xedc_core')->error('网络流量采样失败：@message', ['@message' => $e->getMessage()]);
  }
  if (\Drupal::hasService('xedc_core.storage_multipart')) {
    \Drupal::service('xedc_core.storage_multipart')->cron();
  }
  if (\Drupal::hasService('xedc_core.membership')) {
    \Drupal::service('xedc_core.membership')->expireDue();
    \Drupal::service('xedc_core.zip_builder')->purgeExpired();
  }
  if (\Drupal::hasService('xedc_core.upload_session')) {
    try {
      \Drupal::service('xedc_core.upload_session')->purgeExpired();
    }
    catch (\Throwable $e) {
      \Drupal::logger('xedc_core')->error('清理上传会话失败：@message', ['@message' => $e->getMessage()]);
    }
  }
}

