        'items' => [],
        'sort' => 'new',
        'sort_urls' => [],
        'video_home' => '',
        'home_url' => '',
      ],
      'template' => 'xedc-video-tag',
    ],
  ];
}

/**
 * Adds a download-resource summary to photo, video and article edit forms.
 */
function xedc_core_download_form_attach(array &$form, NodeInterface $node): void {
  if (!\Drupal::currentUser()->hasPermission('administer xedc downloads') || !\Drupal::entityTypeManager()->hasDefinition('xedc_download')) {
    return;
  }
  $rows = [];
  if ($node->id()) {
    $storage = \Drupal::entityTypeManager()->getStorage('xedc_download');
    $ids = $storage->getQuery()->accessCheck(FALSE)->condition('parent', $node->id())->sort('weight')->execute();
    foreach ($storage->loadMultiple($ids) as $resource) {
      if (!$resource instanceof DownloadResource) {
        continue;
      }
      $rows[] = [
        $resource->label(),
        (string) $resource->get('source_type')->value,
        (string) $resource->get('access_level')->value,
        $resource->isPublished() ? t('启用') : t('停用'),
        Link::fromTextAndUrl(t('编辑'), $resource->toUrl('edit-form'))->toString(),
      ];
    }
  }
  $add = Url::fromRoute('entity.xedc_download.add_form');
  if ($node->id()) {
    $add->setOption('query', ['parent' => $node->id()]);
  }
  $form['xedc_downloads'] = [
    '#type' => 'details',
    '#title' => t('下载资源'),
    '#open' => FALSE,
    '#weight' => 40,
    'add' => [
      '#type' => 'link',
      '#title' => t('添加下载资源'),
      '#url' => $add,
    ],
    'list' => [
      '#type' => 'table',
      '#header' => [t('名称'), t('来源'), t('权限'), t('状态'), t('操作')],
      '#rows' => $rows,
      '#empty' => t('还没有下载资源。'),
    ],
  ];
}

/**
 * Implements hook_preprocess_node().
 */
function xedc_core_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  if (!$node instanceof NodeInterface || ($variables['view_mode'] ?? '') !== 'full') {
    return;
  }
  if (!in_array($node->bundle(), ['photo', 'video', 'article'], TRUE) || !$node->isPublished()) {
    return;
  }
  $variables['xedc_engagement'] = [
    '#lazy_builder' => ['xedc_core.engagement_builder:bar', [(string) $node->id()]],
    '#create_placeholder' => TRUE,
  ];
}

/**
 * Implements hook_preprocess_comment().
 */
function xedc_core_preprocess_comment(array &$variables): void {
  $comment = $variables['comment'] ?? NULL;
  if (!is_object($comment) || !method_exists($comment, 'getOwnerId')) {
    return;
  }
  $variables['xedc_vip_badge'] = [
    '#lazy_builder' => ['xedc_core.engagement_builder:badge', [(string) $comment->getOwnerId()]],
    '#create_placeholder' => TRUE,
  ];
}

/**
 * Implements hook_file_download().
 *
 * Private download files are only served by the checked download route.
 */
function xedc_core_file_download(string $uri): array|int|null {
  if (str_starts_with($uri, 'private://xedc-downloads/') || str_starts_with($uri, 'private://xedc-zips/') || str_starts_with($uri, 'private://xedc-download-tmp/')) {
    return -1;
  }
  return NULL;
}

/**
 * Implements hook_entity_delete().
 */
function xedc_core_entity_delete(EntityInterface $entity): void {
  if ($entity instanceof NodeInterface) {
    if (\Drupal::entityTypeManager()->hasDefinition('xedc_download')) {
      $storage = \Drupal::entityTypeManager()->getStorage('xedc_download');
      $ids = $storage->getQuery()->accessCheck(FALSE)->condition('parent', $entity->id())->execute();
      if ($ids) {
        $storage->delete($storage->loadMultiple($ids));
      }
    }
    \Drupal::service('xedc_core.like_manager')->deleteForEntity('node', (int) $entity->id());
    \Drupal::service('xedc_core.download_recorder')->deleteForContent((int) $entity->id());
    xedc_core_video_after_delete($entity);
    Cache::invalidateTags(['xedc_download_list']);
    return;
  }
  if ($entity instanceof UserInterface) {
    $uid = (int) $entity->id();
    \Drupal::database()->delete('xedc_vip')->condition('uid', $uid)->execute();
    \Drupal::database()->delete('xedc_vip_log')->condition('uid', $uid)->execute();
    \Drupal::service('xedc_core.like_manager')->deleteForUser($uid);
    \Drupal::service('xedc_core.share_recorder')->anonymizeUser($uid);
    \Drupal::service('xedc_core.download_recorder')->deleteForUser($uid);
    \Drupal::service('xedc_core.membership')->invalidate($uid);
    return;
  }
  if ($entity instanceof FileInterface) {
    xedc_core_video_after_delete($entity);
    return;
  }
  if (!$entity instanceof DownloadResource) {
    return;
  }
  $fid = (int) $entity->get('file')->target_id;
  if ($fid < 1) {
    return;
  }
  $file = \Drupal::entityTypeManager()->getStorage('file')->load($fid);
  if (!$file instanceof FileInterface || !str_starts_with((string) $file->getFileUri(), 'private://xedc-downloads/')) {
    return;
  }
  $count = 0;
  foreach (\Drupal::service('file.usage')->listUsage($file) as $module) {
    foreach ($module as $type) {
      foreach ($type as $number) {
        $count += (int) $number;
      }
    }
  }
  if ($count === 0) {
    $file->delete();
  }
}

/**
 * Adds photo processing status to the existing moderation view.
 */
function xedc_core_views_data_alter(array &$data): void {
  foreach (['node_field_data', 'node_field_revision'] as $table) {
    if (!isset($data[$table])) {
      continue;
    }
    $data[$table]['xedc_gallery_status'] = [
      'title' => t('图片处理'),
      'help' => t('图片内容的处理状态。文章和视频不显示图集状态。'),
      'field' => [
        'id' => 'xedc_gallery_status',
      ],
    ];
    $data[$table]['xedc_gallery_state'] = [
      'title' => t('图片处理筛选'),
      'filter' => [
        'id' => 'xedc_gallery_state',
      ],
      'real field' => 'nid',
    ];
  }
}

/**
 * Attaches the status field and filter without a new menu or config export.
 */
function xedc_core_views_pre_view(ViewExecutable $view, string $display_id, array &$args): void {
  if ($view->id() !== 'moderated_content') {
    return;
  }
  if (!$view->getHandler($display_id, 'field', 'xedc_gallery_status')) {
    $view->setHandler($display_id, 'field', 'xedc_gallery_status', [
      'id' => 'xedc_gallery_status',
      'table' => 'node_field_revision',
      'field' => 'xedc_gallery_status',
      'plugin_id' => 'xedc_gallery_status',
      'label' => '图片处理',
      'element_label_colon' => FALSE,
    ]);
  }
  if (!$view->getHandler($display_id, 'filter', 'xedc_gallery_state')) {
    $view->setHandler($display_id, 'filter', 'xedc_gallery_state', [
      'id' => 'xedc_gallery_state',
      'table' => 'node_field_revision',
      'field' => 'xedc_gallery_state',
      'plugin_id' => 'xedc_gallery_state',
      'exposed' => TRUE,
      'expose' => [
        'operator_id' => '',
        'label' => '图片处理',
        'identifier' => 'gallery_state',
        'required' => FALSE,
        'remember' => FALSE,
        'multiple' => FALSE,
      ],
      'group' => 1,
    ]);
  }
}

/**
 * Implements hook_views_plugins_field_alter().
 *
 * The content list renders fifty operation menus on every request. Cache the
 * rendered menus for that view only; other entity operation fields stay on
 * the core handler.
 */
function xedc_core_views_plugins_field_alter(array &$plugins): void {
  if (isset($plugins['entity_operations']['class'])) {
    $plugins['entity_operations']['class'] = 'Drupal\\xedc_core\\Plugin\\views\\field\\ContentEntityOperations';
  }
}

/**
 * Implements hook_file_url_alter().
 *
 * Does nothing while public:// is still the local stream wrapper. After a
 * compiled takeover, original files use the CDN and image styles stay local.
 */
/**
 * Queues duration detection after a video node is saved.
 */
function xedc_core_video_after_save(NodeInterface $node): void {
  if ($node->bundle() !== 'video') {
    return;
  }
  xedc_core_cover_alt($node, 'field_video_cover');
  try {
    \Drupal::service('xedc_core.video_duration')->onNodeSave($node);
  }
  catch (\Throwable $e) {
    \Drupal::logger('xedc_video')->error('视频保存后未能加入时长队列：@message', ['@message' => $e->getMessage()]);
  }
}

/**
 * Implements hook_media_update().
 */
function xedc_core_media_update(MediaInterface $media): void {
  if ($media->bundle() !== 'video') {
    return;
  }
  try {
    \Drupal::service('xedc_core.video_duration')->onMediaUpdate($media);
  }
  catch (\Throwable $e) {
    \Drupal::logger('xedc_video')->error('视频文件替换后未能加入时长队列：@message', ['@message' => $e->getMessage()]);
  }
}

/**
 * Drops queued duration work when the file or video is deleted.
 */
function xedc_core_video_after_delete(EntityInterface $entity): void {
  try {
    if ($entity instanceof NodeInterface) {
      \Drupal::service('xedc_core.video_duration')->onNodeDelete($entity);
    }
    elseif ($entity instanceof FileInterface) {
      \Drupal::service('xedc_core.video_duration')->onFileDelete($entity);
    }
  }
  catch (\Throwable $e) {
    \Drupal::logger('xedc_video')->error('清理视频时长任务失败：@message', ['@message' => $e->getMessage()]);
  }
}

/**
 * Implements hook_views_query_alter().
 */
function xedc_core_views_query_alter(\Drupal\views\ViewExecutable $view, \Drupal\views\Plugin\views\query\QueryPluginBase $query): void {
  \Drupal::service('xedc_core.video_listing')->alter($view, $query);
}

/**
 * Implements hook_preprocess_taxonomy_term().
 */
function xedc_core_preprocess_taxonomy_term(array &$variables): void {
  $term = $variables['term'] ?? NULL;
  if (!$term instanceof \Drupal\taxonomy\TermInterface || $term->bundle() !== 'video_category') {
    return;
  }
  $variables['video_count'] = (int) \Drupal::entityQuery('node')
    ->accessCheck(TRUE)
    ->condition('type', 'video')
    ->condition('status', 1)
    ->condition('field_categories', $term->id())
    ->count()
    ->execute();
  $variables['#cache']['tags'][] = 'node_list:video';
}

/**
 * Implements hook_file_url_alter().
 *
 * Does nothing while public:// is still the local stream wrapper. After a
 * compiled takeover, original files use the CDN and image styles stay local.
 */
function xedc_core_file_url_alter(string &$uri): void {
  $rewritten = \Drupal\xedc_core\Ops\Storage\PublicUrl::alter($uri);
  if (is_string($rewritten) && $rewritten !== '') {
    $uri = $rewritten;
  }
}
