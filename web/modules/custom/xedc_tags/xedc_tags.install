}

/**
 * Implements hook_install().
 */
function xedc_tags_install(): void {
  xedc_tags_ensure_tables();
  xedc_tags_grant_editor();
}

/**
 * Creates the tag-center tables and grants the editor role.
 */
function xedc_tags_update_8001(): string {
  xedc_tags_ensure_tables();
  xedc_tags_grant_editor();
  return '智能标签管理中心的记录表已就绪。';
}

/**
 * Adds alias, AI suggestion and task tables.
 */
function xedc_tags_update_8002(): string {
  xedc_tags_ensure_tables();
  xedc_tags_grant_editor();
  return '标签别名、AI 建议与分析任务表已就绪。';
}

/**
 * Creates any missing tag-center tables.
 */
function xedc_tags_ensure_tables(): void {
  $schema = xedc_tags_schema();
  $database = \Drupal::database();
  foreach ($schema as $name => $table) {
    if (!$database->schema()->tableExists($name)) {
      $database->schema()->createTable($name, $table);
    }
  }
}

/**
 * Gives the content editor the non-destructive tag permissions.
 */
function xedc_tags_grant_editor(): void {
  $role = Role::load('content_editor');
  if (!$role) {
    return;
  }
  foreach ([
    'view xedc tag center',
    'manage xedc tags',
    'view xedc tag analysis',
    'apply xedc tag recommendations',
    'manage xedc tag aliases',
  ] as $permission) {
    $role->grantPermission($permission);
  }
  $role->save();
}
