    ],
    'xedc_tag_alias' => [
      'description' => 'Synonym and history aliases that map to an existing tags term.',
      'fields' => [
        'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
        'tid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
        'alias' => ['type' => 'varchar', 'length' => 191, 'not null' => TRUE, 'default' => ''],
        'normalized' => ['type' => 'varchar', 'length' => 191, 'not null' => TRUE, 'default' => ''],
        'type' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => 'synonym'],
        'status' => ['type' => 'varchar', 'length' => 16, 'not null' => TRUE, 'default' => 'active'],
        'source' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => 'manual'],
        'uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
        'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
