{# Legacy metrics list kept for any leftover callers. Prefer dashboard template. #}
<div class="xt-stat-grid">
  {% for item in items %}
    <a class="xt-stat" href="{{ item.url }}">
      <span class="xt-stat__label">{{ item.label }}</span>
      <span class="xt-stat__value">{{ item.value }}</span>
    </a>
  {% endfor %}
</div>
