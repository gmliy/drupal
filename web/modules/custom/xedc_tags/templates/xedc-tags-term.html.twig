<div class="xt xt-term">
  <nav class="xt-crumb" aria-label="{{ '面包屑'|t }}">
    <ol>
      <li><a href="{{ home_url }}">{{ '首页'|t }}</a></li>
      <li><a href="{{ index_url }}">{{ '标签'|t }}</a></li>
      <li aria-current="page">{{ term_name }}</li>
    </ol>
  </nav>

  <header class="xt-head">
    <div>
      <h1 class="xt-title"><span class="xt-hash">#</span>{{ term_name }}</h1>
      {% if description %}
        <div class="xt-desc">{{ description }}</div>
      {% endif %}
      <p class="xt-counts">
        <span>{{ '已发布 @count'|t({'@count': total}) }}</span>
        {% if counts.photo %}<span>{{ '图片 @count'|t({'@count': counts.photo}) }}</span>{% endif %}
        {% if counts.video %}<span>{{ '视频 @count'|t({'@count': counts.video}) }}</span>{% endif %}
        {% if counts.article %}<span>{{ '文章 @count'|t({'@count': counts.article}) }}</span>{% endif %}
      </p>
    </div>
    {% if sorts %}
      <div class="xt-seg" role="group" aria-label="{{ '排序'|t }}">
        {% for item in sorts %}
          <a href="{{ item.url }}" class="{{ item.active ? 'is-active' }}">{{ item.label }}</a>
        {% endfor %}
      </div>
    {% endif %}
  </header>

  {% if notice and notice_url %}
    <p class="xt-notice">{{ '这个标签上的内容已合并到'|t }} <a href="{{ notice_url }}">{{ notice }}</a>{{ '。原地址仍保留。'|t }}</p>
  {% endif %}

  {% if filters %}
    <div class="xt-seg xt-filters" role="group" aria-label="{{ '内容类型'|t }}">
      {% for item in filters %}
        <a href="{{ item.url }}" class="{{ item.active ? 'is-active' }}">{{ item.label }} {{ item.count }}</a>
      {% endfor %}
    </div>
  {% endif %}

  {% if groups %}
    {% for group in groups %}
      <div class="xt-group">
        {% if group.kind == 'photo' %}
          <div class="meitu-grid">
            {% for card in group.items %}
              {% include '@xedc/templates/includes/meitu-card.html.twig' with card only %}
            {% endfor %}
          </div>
        {% elseif group.kind == 'video' %}
          <div class="xv-grid">
            {% for card in group.items %}
              <article class="vcard">
                {% include '@xedc/templates/video/video-card.html.twig' with { card: card } only %}
              </article>
            {% endfor %}
          </div>
        {% else %}
          <div class="xa"><div class="xa-list">
            {% for card in group.items %}
              {{ card.build }}
            {% endfor %}
          </div></div>
        {% endif %}
      </div>
    {% endfor %}
  {% else %}
    <div class="xt-empty">{{ '这个标签下还没有已发布内容'|t }}</div>
  {% endif %}

  {% if related %}
    <section class="xt-related-wrap" aria-label="{{ '相关标签'|t }}">
      <h2>{{ '相关标签'|t }}</h2>
      <ul class="xt-related">
        {% for t in related %}
          <li><a href="{{ t.url }}">{{ t.name }} <span>{{ t.count }}</span></a></li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}
</div>
