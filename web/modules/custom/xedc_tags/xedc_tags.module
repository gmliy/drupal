<?php

use Drupal\taxonomy\TermInterface;

/**
 * Implements hook_theme().
 */
function xedc_tags_theme() {
  return [
    'xedc_tags_term' => [
      'variables' => [
        'term_name' => '',
        'description' => '',
        'total' => 0,
        'counts' => [],
        'filters' => [],
        'groups' => [],
        'sort' => 'new',
        'sorts' => [],
        'related' => [],
        'notice' => '',
        'notice_url' => '',
        'index_url' => '',
        'home_url' => '',
      ],
      'template' => 'xedc-tags-term',
    ],
    'xedc_tags_index' => [
      'variables' => [
        'tags' => [],
        'popular' => [],
        'newest' => [],
        'total_tags' => 0,
        'total_items' => 0,
        'q' => '',
        'sort' => 'count',
        'type' => '',
        'types' => [],
        'sorts' => [],
        'clear_url' => '',
        'index_url' => '',
        'home_url' => '',
      ],
      'template' => 'xedc-tags-index',
    ],
    'xedc_tags_metrics' => [
      'variables' => [
        'items' => [],
      ],
      'template' => 'xedc-tags-metrics',
    ],
  ];
}

/**
 * Implements hook_preprocess_html().
 */
function xedc_tags_preprocess_html(array &$variables) {
  $route = \Drupal::routeMatch();
  $name = $route->getRouteName();
  $is = ($name === 'xedc_tags.index');
  if ($name === 'entity.taxonomy_term.canonical') {
    $t = $route->getParameter('taxonomy_term');
    $is = ($t instanceof TermInterface) && $t->bundle() === 'tags';
  }
  if ($is) {
    $variables['attributes']['class'][] = 'xt-page';
  }
  $variables['#cache']['contexts'][] = 'route';
}
