<a class="xn-icon xn-notify-icon" href="{{ messages_url }}" aria-label="{{ '私信'|t }}">
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 6.5h14a1.5 1.5 0 0 1 1.5 1.5v8a1.5 1.5 0 0 1-1.5 1.5H9l-4 3v-3H5A1.5 1.5 0 0 1 3.5 16V8A1.5 1.5 0 0 1 5 6.5z" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
  {% if messages_count > 0 %}<span class="xn-notify-count">{{ messages_label }}</span>{% endif %}
</a>
<a class="xn-icon xn-notify-icon" href="{{ notifications_url }}" aria-label="{{ '通知'|t }}">
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4.5a5 5 0 0 1 5 5v2.2l1.4 2.8H5.6L7 11.7V9.5a5 5 0 0 1 5-5z" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M10 18.5a2 2 0 0 0 4 0" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
  {% if notifications_count > 0 %}<span class="xn-notify-count">{{ notifications_label }}</span>{% endif %}
</a>
