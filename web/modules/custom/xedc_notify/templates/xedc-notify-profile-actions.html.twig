{#
/**
 * @file
 * Follow + message actions on public creator profiles.
 */
#}
<div class="xp-actions xn-profile-actions">
  {% if follow_url %}
    <a class="xp-action{{ following ? ' is-on' }}" href="{{ follow_url }}">
      <svg class="xp-action__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        {% if following %}
          <path d="M9.5 16.5 5.8 12.8l1.4-1.4 2.3 2.3 6.3-6.3 1.4 1.4Z" fill="currentColor"></path>
        {% else %}
          <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none"></path>
        {% endif %}
      </svg>
      <span>{{ following ? '已关注'|t : '关注'|t }}</span>
    </a>
  {% endif %}
  {% if message_url %}
    <a class="xp-action xp-action--primary{{ message_guest ? ' xp-action--guest' }}" href="{{ message_url }}">
      <svg class="xp-action__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M4.5 6.5h15v9.2a1.8 1.8 0 0 1-1.8 1.8H8.2L4.5 20.5V6.5Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
      </svg>
      <span>{{ message_guest ? '登录后私信'|t : '私信'|t }}</span>
    </a>
  {% endif %}
</div>
