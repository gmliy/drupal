<?php

/**
 * @file
 * Schema and updates for XEDC private messages and notifications.
 */

/**
 * Implements hook_schema().
 */
function xedc_notify_schema(): array {
  return [
    'xedc_pm_thread' => xedc_notify_schema_pm_thread(),
    'xedc_pm_thread_state' => xedc_notify_schema_pm_thread_state(),
    'xedc_pm_message' => xedc_notify_schema_pm_message(),
    'xedc_follow' => xedc_notify_schema_follow(),
    'xedc_notification' => xedc_notify_schema_notification(),
    'xedc_notification_pref' => xedc_notify_schema_notification_pref(),
    'xedc_official_campaign' => xedc_notify_schema_official_campaign(),
    'xedc_vip_notify_sent' => xedc_notify_schema_vip_notify_sent(),
  ];
}

/**
 * Private message thread (one row per participant pair).
 */
function xedc_notify_schema_pm_thread(): array {
  return [
    'description' => 'Private message threads between two members.',
    'fields' => [
      'tid' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'uid_low' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'uid_high' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'last_mid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'last_created' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
      'created' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
      'changed' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['tid'],
    'unique keys' => [
      'pair' => ['uid_low', 'uid_high'],
    ],
    'indexes' => [
      'last_created' => ['last_created'],
    ],
  ];
}

/**
 * Per-user thread visibility and unread state.
 */
function xedc_notify_schema_pm_thread_state(): array {
  return [
    'description' => 'Per-participant private message thread state.',
    'fields' => [
      'tid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'hidden' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 0],
      'hidden_at' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
      'hide_after_mid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'unread_count' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'last_read_mid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'changed' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['tid', 'uid'],
    'indexes' => [
      'uid_hidden_last' => ['uid', 'hidden'],
      'uid_unread' => ['uid', 'unread_count'],
    ],
  ];
}

/**
 * Adds per-user message cut-off mid for one-sided thread delete.
 */
function xedc_notify_update_10001(): string {
  $schema = \Drupal::database()->schema();
  if ($schema->tableExists('xedc_pm_thread_state') && !$schema->fieldExists('xedc_pm_thread_state', 'hide_after_mid')) {
    $schema->addField('xedc_pm_thread_state', 'hide_after_mid', [
      'type' => 'int',
      'unsigned' => TRUE,
      'not null' => TRUE,
      'default' => 0,
      'description' => 'Messages with mid <= this value stay hidden after a one-sided delete.',
    ]);
  }
  return 'Added xedc_pm_thread_state.hide_after_mid.';
}

/**
 * Private message rows.
 */
function xedc_notify_schema_pm_message(): array {
  return [
    'description' => 'Private message bodies.',
    'fields' => [
      'mid' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'tid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'sender_uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'recipient_uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'body' => ['type' => 'text', 'size' => 'big', 'not null' => TRUE],
      'created' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
      'is_read' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 0],
      'read_at' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['mid'],
    'indexes' => [
      'tid_created' => ['tid', 'created'],
      'recipient_unread' => ['recipient_uid', 'is_read'],
      'sender_created' => ['sender_uid', 'created'],
    ],
  ];
}

