      'entity_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'dedupe_key' => ['type' => 'varchar', 'length' => 191, 'not null' => TRUE, 'default' => ''],
      'important' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 0],
      'pinned' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 0],
      'is_read' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 0],
      'deleted' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 0],
      'campaign_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'created' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
      'read_at' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'],
