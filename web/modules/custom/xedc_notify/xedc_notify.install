/**
 * Idempotency log for VIP lifecycle notifications.
 */
function xedc_notify_schema_vip_notify_sent(): array {
  return [
    'description' => 'Dedupes VIP reminder and lifecycle notifications.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'period_expires' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
      'notify_type' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => ''],
      'offset_days' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
      'notification_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'status' => ['type' => 'varchar', 'length' => 16, 'not null' => TRUE, 'default' => 'sent'],
      'message' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE, 'default' => ''],
      'created' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'dedupe' => ['uid', 'period_expires', 'notify_type', 'offset_days'],
    ],
    'indexes' => [
      'type_created' => ['notify_type', 'created'],
      'uid_created' => ['uid', 'created'],
    ],
  ];
}

/**
 * Implements hook_install().
 */
function xedc_notify_install(): void {
  // Authenticated members can use messages and notifications.
  user_role_grant_permissions('authenticated', [
    'access own xedc messages',
    'access send xedc messages',
    'access own xedc notifications',
  ]);
}
