<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light dark">
  <meta name="supported-color-schemes" content="light dark">
  <title>{{ heading }}</title>
  <style>
    @media (max-width: 620px) {
      .xedc-mail-card { width: 100% !important; max-width: 100% !important; padding: 20px !important; }
      .xedc-mail-button-table { width: 100% !important; }
      .xedc-mail-button { display: block !important; width: 100% !important; }
      .xedc-mail-button a { display: block !important; width: 100% !important; box-sizing: border-box; text-align: center; }
    }
    @media (prefers-color-scheme: dark) {
      .xedc-mail-page { background: #18181B !important; }
      .xedc-mail-card { background: #202024 !important; border-color: #3F3F46 !important; }
      .xedc-mail-title, .xedc-mail-heading { color: #E4E4E7 !important; }
      .xedc-mail-text, .xedc-mail-text p, .xedc-mail-text a { color: #E4E4E7 !important; }
      .xedc-mail-button { background: #E4E4E7 !important; color: #27272A !important; }
      .xedc-mail-muted { color: #A1A1AA !important; }
    }
  </style>
</head>
<body class="xedc-mail-page" style="margin:0;padding:0;background:#F4F4F5;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;">{{ preheader }}</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#F4F4F5;margin:0;padding:0;">
    <tr>
      <td align="center" style="padding:24px 12px;">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" class="xedc-mail-card" style="width:600px;max-width:100%;background:#FFFFFF;border:1px solid #E4E4E7;border-radius:12px;">
          <tr>
            <td style="padding:32px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei',Arial,sans-serif;">
              <p class="xedc-mail-title" style="margin:0 0 20px;font-size:20px;font-weight:600;line-height:1.4;color:#27272A;">{{ site_name }}</p>
              <h1 class="xedc-mail-heading" style="margin:0 0 16px;font-size:22px;font-weight:600;line-height:1.4;color:#27272A;">{{ heading }}</h1>
              <div class="xedc-mail-text">{{ body }}</div>
              {% if button_label and button_url %}
                <table role="presentation" class="xedc-mail-button-table" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 16px;width:auto;">
                  <tr>
                    <td class="xedc-mail-button" bgcolor="#3F3F46" style="border-radius:8px;background:#3F3F46;">
                      <a href="{{ button_url }}" style="display:inline-block;padding:12px 24px;color:#FFFFFF;font-size:15px;font-weight:600;line-height:1.4;text-decoration:none;">{{ button_label }}</a>
                    </td>
                  </tr>
                </table>
                <p class="xedc-mail-muted" style="margin:0 0 8px;font-size:13px;line-height:1.6;color:#71717A;">如果按钮无法点击，请复制下面的链接到浏览器打开：</p>
                <p class="xedc-mail-muted" style="margin:0 0 16px;font-size:13px;line-height:1.6;color:#71717A;word-break:break-all;"><a href="{{ button_url }}" style="color:#27272A;text-decoration:underline;word-break:break-all;">{{ button_url }}</a></p>
              {% endif %}
              <p class="xedc-mail-muted" style="margin:24px 0 0;font-size:13px;line-height:1.6;color:#71717A;">{{ footer }}</p>
              <p class="xedc-mail-muted" style="margin:8px 0 0;font-size:13px;line-height:1.6;color:#71717A;"><a href="{{ site_url }}" style="color:#27272A;text-decoration:underline;">{{ site_url }}</a></p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
